{"speakers": 2, "cues": [{"s": 0.0, "e": 0.56, "t": "Ya bir de Yekta", "p": 0}, {"s": 0.56, "e": 1.92, "t": "'ya sataşıyor yani.", "p": 0}, {"s": 1.92, "e": 3.24, "t": "Yekta 'ya sataşılır mı", "p": 0}, {"s": 3.24, "e": 4.02, "t": "oğlum?", "p": 0}, {"s": 4.94, "e": 6.16, "t": "Yekta 'ya oynamayayım ben", "p": 0}, {"s": 6.16, "e": 6.78, "t": "sonuçta ikisi şimdi.", "p": 1}, {"s": 6.78, "e": 8.06, "t": "Ya abi duymuşum işte", "p": 1}, {"s": 8.06, "e": 9.52, "t": "short geliyor short short", "p": 1}, {"s": 9.52, "e": 10.22, "t": "short short short", "p": 1}, {"s": 10.22, "e": 11.3, "t": "geliyor.", "p": 1}, {"s": 11.88, "e": 12.64, "t": "Tamam canım.", "p": 0}, {"s": 12.64, "e": 13.78, "t": "Yekta bunlardan ikisini", "p": 0}, {"s": 13.78, "e": 14.5, "t": "de almasam var yani", "p": 0}, {"s": 14.5, "e": 17.56, "t": "bunların tarizma çizildi", "p": 0}, {"s": 17.56, "e": 18.46, "t": "şu anda.", "p": 0}, {"s": 20.08, "e": 21.76, "t": "Arkandan geliyor Yekta.", "p": 0}, {"s": 21.76, "e": 23.64, "t": "Tamam Faizhoş 'um.", "p": 0}, {"s": 27.14, "e": 28.36, "t": "Kotkar 'ın bir klibi", "p": 0}, {"s": 28.36, "e": 29.94, "t": "var ya rahatsızlık vermek", "p": 0}, {"s": 29.94, "e": 30.64, "t": "için geldik.", "p": 0}, {"s": 30.64, "e": 31.86, "t": "Rahatsızlık vermeye de", "p": 0}, {"s": 31.86, "e": 33.3, "t": "devam edeceğiz.", "p": 0}, {"s": 34.08, "e": 36.42, "t": "Yenka öldü, öldü öldü", "p": 0}, {"s": 36.42, "e": 37.8, "t": "yaşatmaz arkadaşlar", "p": 0}, {"s": 40.2, "e": 41.6, "t": "Verdiğimiz rahatsızlık", "p": 0}, {"s": 41.6, "e": 42.85, "t": "için özür dilemeyiz", "p": 0}]}