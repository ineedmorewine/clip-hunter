{"speakers": 2, "cues": [{"s": 0.0, "e": 0.9, "t": "benim için günün ilk", "p": 1}, {"s": 0.9, "e": 1.22, "t": "oyunu.", "p": 1}, {"s": 1.22, "e": 2.58, "t": "Bok gibi olabilir.", "p": 1}, {"s": 3.43, "e": 3.98, "t": "Bir de", "p": 0}, {"s": 3.98, "e": 6.1, "t": "şey, Faysal 'ın", "p": 0}, {"s": 6.1, "e": 7.56, "t": "çekirdek çitleme deneyimi", "p": 0}, {"s": 7.56, "e": 8.34, "t": "sunuyoruz", "p": 0}, {"s": 8.34, "e": 9.38, "t": "ayriyetine.", "p": 1}, {"s": 9.38, "e": 11.88, "t": "Şey, ambiyansızı.", "p": 1}, {"s": 13.02, "e": 14.66, "t": "Molaya gittik.", "p": 0}, {"s": 14.92, "e": 16.28, "t": "Ah siktir.", "p": 0}, {"s": 16.88, "e": 17.98, "t": "Evet, buyurun.", "p": 0}, {"s": 17.98, "e": 19.56, "t": "Her çıt sesi geldiğinde", "p": 0}, {"s": 19.56, "e": 21.62, "t": "hepimiz çıt diye", "p": 0}, {"s": 21.62, "e": 23.84, "t": "şey yapalım, Faysal 'ı.", "p": 0}, {"s": 32.2, "e": 33.06, "t": "O ne?", "p": 1}, {"s": 33.06, "e": 34.12, "t": "Oha!", "p": 1}, {"s": 34.12, "e": 35.6, "t": "Kimi suyu gargara yaptı?", "p": 0}, {"s": 35.6, "e": 36.58, "t": "Gargara yapmasını ben de", "p": 0}, {"s": 36.58, "e": 37.28, "t": "beklemiyordum.", "p": 0}, {"s": 37.28, "e": 38.44, "t": "bu ilk oldu.", "p": 0}, {"s": 38.44, "e": 39.38, "t": "O benden", "p": 0}, {"s": 39.38, "e": 40.38, "t": "gelmedi.", "p": 0}, {"s": 41.74, "e": 43.32, "t": "Hazar mı gargara yaptı", "p": 0}, {"s": 43.32, "e": 44.1, "t": "o zaman?", "p": 0}, {"s": 44.44, "e": 45.66, "t": "Gargara yapmadım.", "p": 0}, {"s": 45.66, "e": 47.48, "t": "Su içtim, çalkalayarak", "p": 0}, {"s": 47.48, "e": 47.88, "t": "içtim.", "p": 0}, {"s": 47.88, "e": 49.06, "t": "Su için arkadaşlar,", "p": 0}, {"s": 49.06, "e": 49.54, "t": "çalkalayarak", "p": 0}, {"s": 49.54, "e": 50.78, "t": "için sik sok sesler", "p": 0}, {"s": 50.78, "e": 51.36, "t": "çıkıyor diye", "p": 0}, {"s": 51.36, "e": 52.68, "t": "millet eleştirilmiş.", "p": 0}]}