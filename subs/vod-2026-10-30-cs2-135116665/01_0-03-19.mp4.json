{"speakers": 1, "cues": [{"s": 0.0, "e": 0.9, "t": "benim için günün ilk", "p": 0}, {"s": 0.9, "e": 1.22, "t": "oyunu.", "p": 0}, {"s": 1.22, "e": 2.58, "t": "Bok gibi olabilir.", "p": 0}, {"s": 3.42, "e": 4.0, "t": "Bir de", "p": 0}, {"s": 4.0, "e": 6.1, "t": "şey, Faysal 'ın", "p": 0}, {"s": 6.1, "e": 7.58, "t": "çekirdek çitleme deneyimi", "p": 0}, {"s": 7.58, "e": 8.34, "t": "sunuyoruz", "p": 0}, {"s": 8.34, "e": 9.34, "t": "ID 'ye.", "p": 0}, {"s": 9.34, "e": 11.76, "t": "İşte ambiyat sizi.", "p": 0}, {"s": 12.96, "e": 14.68, "t": "Molaya gittik.", "p": 0}, {"s": 16.68, "e": 17.98, "t": "Evet, buyurun.", "p": 0}, {"s": 17.98, "e": 19.56, "t": "Her çıt sesi geldiğinde", "p": 0}, {"s": 19.56, "e": 21.62, "t": "hepimiz çıt diye", "p": 0}, {"s": 21.62, "e": 23.82, "t": "şey yapalım, Faysal 'ı.", "p": 0}, {"s": 32.08, "e": 33.04, "t": "O ne?", "p": 0}, {"s": 33.04, "e": 34.08, "t": "Oha!", "p": 0}, {"s": 34.08, "e": 35.1, "t": "Kimi sıyı", "p": 0}, {"s": 35.1, "e": 36.58, "t": "Gargara yapmasını ben de", "p": 0}, {"s": 36.58, "e": 37.4, "t": "beklemiyordum.", "p": 0}, {"s": 37.4, "e": 38.62, "t": "Bu ilk oldu.", "p": 0}, {"s": 38.62, "e": 40.38, "t": "O benden gelmedi.", "p": 0}, {"s": 41.64, "e": 43.92, "t": "Hazar mı gargara yaptı?", "p": 0}, {"s": 44.34, "e": 45.64, "t": "Gargara yapmadım.", "p": 0}, {"s": 45.64, "e": 46.8, "t": "Su içtim.", "p": 0}, {"s": 46.8, "e": 47.88, "t": "Çalkalayarak içtim.", "p": 0}, {"s": 47.88, "e": 48.76, "t": "Su için arkadaşlar", "p": 0}, {"s": 48.76, "e": 49.9, "t": "çalkalayarak için.", "p": 0}, {"s": 49.9, "e": 51.16, "t": "Siksok sesler çıkıyor", "p": 0}, {"s": 51.16, "e": 52.68, "t": "diye millet eleştiriyor.", "p": 0}]}