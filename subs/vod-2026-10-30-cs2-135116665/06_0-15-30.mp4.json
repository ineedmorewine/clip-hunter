{"speakers": 2, "cues": [{"s": 0.0, "e": 1.2, "t": "sen vuramadın", "p": 0}, {"s": 1.62, "e": 3.7, "t": "ben çok konuşuyon he", "p": 0}, {"s": 3.8, "e": 5.0, "t": "adam duruyo ya adam", "p": 0}, {"s": 5.0, "e": 6.64, "t": "sakin sakin duruyo", "p": 0}, {"s": 8.2, "e": 9.56, "t": "al bunu yap bakalım", "p": 0}, {"s": 9.56, "e": 11.22, "t": "al", "p": 0}, {"s": 13.3, "e": 14.36, "t": "benim otom değil", "p": 0}, {"s": 14.36, "e": 16.7, "t": "gene ak yok muydu?", "p": 0}, {"s": 17.26, "e": 18.54, "t": "yok", "p": 1}, {"s": 19.02, "e": 19.9, "t": "o benim otom değil", "p": 0}, {"s": 19.9, "e": 20.22, "t": "yalnız", "p": 0}, {"s": 20.22, "e": 21.86, "t": "benim otom yeşil", "p": 0}, {"s": 22.04, "e": 24.26, "t": "bir daha oto çeksene", "p": 0}, {"s": 24.36, "e": 26.36, "t": "yok ya yapmayacağım ya", "p": 0}, {"s": 26.36, "e": 27.54, "t": "bak yektanın dönüştüğü", "p": 0}, {"s": 27.54, "e": 28.26, "t": "şeye dönüşüyorum", "p": 0}, {"s": 28.26, "e": 28.98, "t": "Yavak isterim", "p": 0}, {"s": 28.98, "e": 30.02, "t": "istemiyorum.", "p": 0}, {"s": 30.04, "e": 30.82, "t": "Yapmayın yavak.", "p": 0}, {"s": 30.82, "e": 32.3, "t": "Tamam faysalcım sen nasıl", "p": 0}, {"s": 32.3, "e": 33.36, "t": "istersen.", "p": 0}, {"s": 33.36, "e": 34.8, "t": "Allah razı olsun.", "p": 0}]}