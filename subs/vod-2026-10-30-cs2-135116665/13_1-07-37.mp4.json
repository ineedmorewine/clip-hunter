{"speakers": 2, "cues": [{"s": 0.0, "e": 1.4, "t": "B ile vurdu öldüm.", "p": 0}, {"s": 2.18, "e": 3.4, "t": "Bomba şoktan geliyor", "p": 0}, {"s": 3.4, "e": 4.48, "t": "arkadaşlar.", "p": 0}, {"s": 4.92, "e": 7.24, "t": "Çok da sinirli.", "p": 0}, {"s": 15.26, "e": 16.78, "t": "Bak ağzımı dayı açmadım", "p": 0}, {"s": 16.78, "e": 17.94, "t": "öldüm bak gördün mü?", "p": 0}, {"s": 17.94, "e": 18.96, "t": "Ben benden kanak değil.", "p": 0}, {"s": 18.96, "e": 20.62, "t": "İkisini aldım abi zaten.", "p": 1}, {"s": 20.62, "e": 21.76, "t": "Üçüncüye ölebilirim ben", "p": 1}, {"s": 21.76, "e": 21.9, "t": "dedim.", "p": 1}, {"s": 21.9, "e": 22.58, "t": "Lan siktir oradan", "p": 1}, {"s": 22.58, "e": 23.68, "t": "ölebilirim işte.", "p": 0}]}