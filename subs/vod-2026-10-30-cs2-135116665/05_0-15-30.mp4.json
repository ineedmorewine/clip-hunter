{"speakers": 2, "cues": [{"s": 0.0, "e": 1.58, "t": "neden vuramadın?", "p": 0}, {"s": 1.58, "e": 3.7, "t": "ben çok konuşuyon he", "p": 0}, {"s": 3.78, "e": 5.0, "t": "adam duruyo ya adam", "p": 0}, {"s": 5.0, "e": 6.66, "t": "sakin sakin duruyo", "p": 0}, {"s": 7.9, "e": 9.54, "t": "al bunu yap bakalım", "p": 0}, {"s": 9.54, "e": 11.22, "t": "al", "p": 0}, {"s": 13.2, "e": 14.36, "t": "benim otom değil", "p": 0}, {"s": 14.36, "e": 16.26, "t": "gene ak yok muydu?", "p": 0}, {"s": 16.26, "e": 17.92, "t": "kimse almamış mı gene?", "p": 0}, {"s": 18.6, "e": 19.9, "t": "o benim otom değil", "p": 0}, {"s": 19.9, "e": 20.22, "t": "yalnız", "p": 0}, {"s": 20.22, "e": 21.86, "t": "benim otom yeşil", "p": 0}, {"s": 22.0, "e": 23.66, "t": "bir daha oto çeksene", "p": 0}, {"s": 23.66, "e": 26.38, "t": "yok ya yapmayacağım ya", "p": 0}, {"s": 26.38, "e": 27.54, "t": "bak yektanın dönüştüğü", "p": 0}, {"s": 27.54, "e": 28.28, "t": "şeye dönüşüyorum", "p": 0}, {"s": 28.28, "e": 29.5, "t": "Yavaş yiyeti istemiyorum.", "p": 0}, {"s": 29.5, "e": 30.82, "t": "Yavaş yavaş.", "p": 0}, {"s": 30.82, "e": 32.08, "t": "Tamam Faysalcığım sen", "p": 0}, {"s": 32.08, "e": 33.36, "t": "nasıl istersen.", "p": 0}, {"s": 33.36, "e": 34.82, "t": "Allah razı olsun.", "p": 0}]}