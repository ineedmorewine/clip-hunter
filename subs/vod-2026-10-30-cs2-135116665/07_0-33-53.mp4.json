{"speakers": 2, "cues": [{"s": 0.0, "e": 1.76, "t": "Kasayı mı kiralıyorsunuz?", "p": 0}, {"s": 1.76, "e": 2.68, "t": "Kasayı.", "p": 0}, {"s": 2.68, "e": 3.78, "t": "Devrim kasası", "p": 0}, {"s": 3.78, "e": 4.78, "t": "kiralanabilir yazıyor.", "p": 0}, {"s": 4.78, "e": 6.14, "t": "Kiralayınca ne oluyor?", "p": 0}, {"s": 6.36, "e": 8.24, "t": "İçindeki bütün itemler", "p": 0}, {"s": 8.24, "e": 9.04, "t": "şey.", "p": 0}, {"s": 10.78, "e": 12.44, "t": "Kaça kiralıyorsunuz?", "p": 0}, {"s": 12.96, "e": 14.74, "t": "İçindeki bütün itemleri", "p": 0}, {"s": 14.74, "e": 15.5, "t": "bir haftalığına", "p": 0}, {"s": 15.5, "e": 17.04, "t": "kullanabiliyorsunuz.", "p": 0}, {"s": 17.56, "e": 19.4, "t": "Nasıl kiralıyorsunuz?", "p": 0}, {"s": 22.12, "e": 23.5, "t": "Tıklıyorsun kirala", "p": 0}, {"s": 23.5, "e": 24.32, "t": "diyorsun.", "p": 0}, {"s": 25.92, "e": 27.98, "t": "Kiralama şey yok işte.", "p": 0}, {"s": 28.04, "e": 29.46, "t": "Onu nasıl açıyoruz?", "p": 0}, {"s": 29.46, "e": 31.1, "t": "Sağa tıklıyoruz olmuyor.", "p": 0}, {"s": 31.1, "e": 32.8, "t": "Sola tıklıyoruz olmuyor.", "p": 0}, {"s": 33.04, "e": 34.6, "t": "Kasayı aç dedim.", "p": 0}, {"s": 37.42, "e": 38.74, "t": "Sanırsam kasayı aç", "p": 0}, {"s": 38.74, "e": 39.94, "t": "deyince kiralamış da", "p": 0}, {"s": 39.94, "e": 40.62, "t": "alıyoruz.", "p": 0}, {"s": 40.62, "e": 42.14, "t": "Çünkü hayat dediğin nedir", "p": 0}, {"s": 42.14, "e": 42.9, "t": "ki?", "p": 0}, {"s": 42.96, "e": 44.38, "t": "Kiralıyorsun belirli bir", "p": 0}, {"s": 44.38, "e": 45.52, "t": "süreliğini.", "p": 0}, {"s": 46.68, "e": 48.0, "t": "Satın alsam bile.", "p": 0}]}