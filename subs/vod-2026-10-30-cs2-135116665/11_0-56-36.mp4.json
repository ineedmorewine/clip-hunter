{"speakers": 2, "cues": [{"s": 1.88, "e": 3.34, "t": "Oooo Faysal Hoca bu", "p": 0}, {"s": 3.34, "e": 4.52, "t": "yavaşlıkla biraz sıçarız", "p": 0}, {"s": 4.52, "e": 5.26, "t": "ama", "p": 0}, {"s": 5.96, "e": 7.48, "t": "Faysal AWP ile hiç", "p": 0}, {"s": 7.48, "e": 8.02, "t": "bir boku yapamam", "p": 0}, {"s": 8.02, "e": 8.92, "t": "Pistol check ağzına", "p": 0}, {"s": 8.92, "e": 9.8, "t": "sıçarsın getirsin", "p": 0}, {"s": 9.8, "e": 11.8, "t": "Etinden korkarın ki", "p": 0}, {"s": 11.8, "e": 13.2, "t": "Adam nerde?", "p": 0}, {"s": 13.2, "e": 13.92, "t": "Sağdadır", "p": 0}, {"s": 13.92, "e": 14.82, "t": "Sağda muhtemelen", "p": 0}, {"s": 14.82, "e": 16.08, "t": "Sola geçti", "p": 0}, {"s": 16.08, "e": 17.72, "t": "Yanlışım yok vermeyin", "p": 0}, {"s": 17.72, "e": 18.54, "t": "Sen ona güvenmeyin bana", "p": 0}, {"s": 18.54, "e": 18.9, "t": "güven", "p": 0}, {"s": 18.9, "e": 19.56, "t": "Sen bana güven", "p": 0}, {"s": 19.56, "e": 21.4, "t": "Hocca AK var yani", "p": 0}, {"s": 21.4, "e": 21.76, "t": "aynı", "p": 0}, {"s": 21.76, "e": 23.0, "t": "Oğlum", "p": 0}, {"s": 23.0, "e": 24.08, "t": "Zonkta?", "p": 0}, {"s": 24.08, "e": 25.1, "t": "Hoca", "p": 0}, {"s": 25.24, "e": 25.96, "t": "Hoca", "p": 0}, {"s": 25.96, "e": 27.02, "t": "Herbiden nans", "p": 0}, {"s": 27.02, "e": 27.92, "t": "Hoca AK 'yi aldın", "p": 0}, {"s": 27.92, "e": 29.1, "t": "bence", "p": 0}, {"s": 29.66, "e": 30.24, "t": "Bekleyince de", "p": 0}, {"s": 30.24, "e": 30.78, "t": "kaybediyorsun.", "p": 0}, {"s": 30.78, "e": 31.54, "t": "Bak ben bunun ne", "p": 0}, {"s": 31.54, "e": 32.5, "t": "yapacağını biliyorum.", "p": 0}, {"s": 32.5, "e": 33.3, "t": "Burada böyle...", "p": 0}, {"s": 33.3, "e": 34.32, "t": "Heh, herhalde.", "p": 0}, {"s": 34.32, "e": 35.48, "t": "Oğlum Faysal hocanın", "p": 0}, {"s": 35.48, "e": 36.9, "t": "zırhını...", "p": 0}, {"s": 36.9, "e": 38.36, "t": "N 'abıyon?", "p": 0}, {"s": 39.42, "e": 40.62, "t": "Sola bak, sola bak,", "p": 0}, {"s": 40.62, "e": 41.06, "t": "sol