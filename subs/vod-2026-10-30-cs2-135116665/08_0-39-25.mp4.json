{"speakers": 2, "cues": [{"s": 1.71, "e": 2.91, "t": "Şurka senin civcivin ne", "p": 0}, {"s": 2.91, "e": 4.11, "t": "zaman büyüyecek şimdi?", "p": 0}, {"s": 4.43, "e": 5.77, "t": "Yazıyor mu şu zaman", "p": 0}, {"s": 5.77, "e": 6.55, "t": "sonra büyüyecek değil?", "p": 0}, {"s": 6.55, "e": 7.55, "t": "Dur bakayım ne yazıyor?", "p": 0}, {"s": 7.55, "e": 8.85, "t": "Civcivin yakında bir", "p": 0}, {"s": 8.85, "e": 10.05, "t": "piliç olacak.", "p": 0}, {"s": 10.05, "e": 11.21, "t": "Küçük dostluğunla", "p": 0}, {"s": 11.21, "e": 12.47, "t": "geçireceğin zamanın", "p": 0}, {"s": 12.47, "e": 13.87, "t": "tadını çıkar ve birkaç", "p": 0}, {"s": 13.87, "e": 15.27, "t": "fotoğraf çeksin.", "p": 0}, {"s": 15.27, "e": 16.07, "t": "Ben çektim.", "p": 0}, {"s": 16.07, "e": 17.93, "t": "Beş tane fotoğraf aldım.", "p": 0}, {"s": 19.66, "e": 20.68, "t": "Vay be.", "p": 0}, {"s": 22.7, "e": 23.5, "t": "Anıs kalsın.", "p": 0}, {"s": 23.5, "e": 24.04, "t": "Anıs kalsın.", "p": 0}, {"s": 24.04, "e": 24.92, "t": "Bir düzenmiş yerde", "p": 0}, {"s": 24.92, "e": 26.5, "t": "yatıyordu geçen gün.", "p": 0}, {"s": 27.58, "e": 28.34, "t": "Ne yapıyordu?", "p": 0}, {"s": 28.34, "e": 29.7, "t": "Abi dedim ki hadi", "p": 0}, {"s": 29.7, "e": 30.68, "t": "bu hafta da dedim", "p": 0}, {"s": 30.68, "e": 32.08, "t": "karnı doysun dedim.", "p": 0}, {"s": 32.08, "e": 34.04, "t": "Bir şey yapayım dedim.", "p": 0}, {"s": 34.06, "e": 35.5, "t": "Yemlemiş hayvanı.", "p": 0}, {"s": 36.66, "e": 37.88, "t": "Gariban bakıp hapıp", "p": 0}, {"s": 37.88, "e": 38.62, "t": "duruyoruz zıpladı üzerine", "p": 0}, {"s": 38.62, "e": 38.94, "t": "doğru.", "p": 0}, {"s": 38.94, "e": 40.46, "t": "Ya o 20 centlik", "p": 0}, {"s": 40.46, "e": 41.72, "t": "kutuyu alacaktım ya da", "p": 0}, {"s": 41.72, "e": 43.56, "t": "civcivimi doyuracaktım.", "p": 0}, {"s": 43.56, "e": 44.54, "t": "Ben de doğru olanı", "p": 0}, {"s": 44.54, "e": 45.86, "t": "yapıp 20 centlik kutuyu", "p": 0}, {"s": 45.86, "e": 46.92, "t": "seçtim.", "p