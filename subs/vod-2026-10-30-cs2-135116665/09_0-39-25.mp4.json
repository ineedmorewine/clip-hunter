{"speakers": 1, "cues": [{"s": 1.71, "e": 2.91, "t": "Sen senin civcivin ne", "p": 0}, {"s": 2.91, "e": 4.11, "t": "zaman büyüyecek şimdi?", "p": 0}, {"s": 4.45, "e": 5.79, "t": "Yazıyor mu şu zaman", "p": 0}, {"s": 5.79, "e": 6.57, "t": "sonra büyüyecek değil mi?", "p": 0}, {"s": 6.57, "e": 7.61, "t": "Dur bakayım ne yazıyor?", "p": 0}, {"s": 7.61, "e": 8.85, "t": "Civcivin yakında bir", "p": 0}, {"s": 8.85, "e": 10.05, "t": "piliç olacak.", "p": 0}, {"s": 10.05, "e": 11.21, "t": "Küçük dostluğunla", "p": 0}, {"s": 11.21, "e": 12.47, "t": "geçireceğin zamanın", "p": 0}, {"s": 12.47, "e": 13.87, "t": "tadını çıkar ve birkaç", "p": 0}, {"s": 13.87, "e": 15.29, "t": "fotoğraf çeksin.", "p": 0}, {"s": 15.29, "e": 16.11, "t": "Ben çektim.", "p": 0}, {"s": 16.11, "e": 17.91, "t": "Beş tane fotoğraf aldım.", "p": 0}, {"s": 19.68, "e": 20.68, "t": "Vay be.", "p": 0}, {"s": 21.42, "e": 22.72, "t": "Bunu bir saradım.", "p": 0}, {"s": 23.02, "e": 23.9, "t": "Anısı kalsın.", "p": 0}, {"s": 23.9, "e": 24.92, "t": "Bir düzenmiş yerde", "p": 0}, {"s": 24.92, "e": 26.52, "t": "yatıyordu geçen gün.", "p": 0}, {"s": 27.84, "e": 28.46, "t": "Ne yapıyordu?", "p": 0}, {"s": 28.46, "e": 29.68, "t": "Abi dedim ki hadi", "p": 0}, {"s": 29.68, "e": 31.2, "t": "bu haftada dedim karnı", "p": 0}, {"s": 31.2, "e": 31.8, "t": "doysun dedim.", "p": 0}, {"s": 31.8, "e": 33.96, "t": "Bir şey yapayım dedim.", "p": 0}, {"s": 33.96, "e": 35.54, "t": "Yemlemiş hayvanı.", "p": 0}, {"s": 36.68, "e": 37.98, "t": "Gariban bakıma kutuyu", "p": 0}, {"s": 37.98, "e": 38.96, "t": "zıpladı üzerine doğru.", "p": 0}, {"s": 38.96, "e": 40.48, "t": "Ya o 20 centlik", "p": 0}, {"s": 40.48, "e": 41.72, "t": "kutuyu alacaktım ya da", "p": 0}, {"s": 41.72, "e": 43.58, "t": "civcivimi doyuracaktım.", "p": 0}, {"s": 43.58, "e": 44.56, "t": "Ben de doğru olanı", "p": 0}, {"s": 44.56, "e": 45.86, "t": "yapıp 20 centlik kutuyu", "p": 0}, {"s": 45.86, "e": 46.92, "t": "seçtim.", "p": 0}, {"s": 49.1, "e": 49.98, "t": "Sonra içinden açtım ve", "p": 0}, {"s": 49.98, "e": 51.72, "t": "400 dolarlık şey çıktı.", "p": 0}]}