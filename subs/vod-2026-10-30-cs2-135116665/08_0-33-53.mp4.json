{"speakers": 2, "cues": [{"s": 0.0, "e": 1.6, "t": "Kasayı mı kiralıyor?", "p": 0}, {"s": 1.6, "e": 2.68, "t": "Kasayı.", "p": 0}, {"s": 2.68, "e": 3.78, "t": "Devrim kasası", "p": 0}, {"s": 3.78, "e": 4.8, "t": "kiralanabilir yazıyor.", "p": 0}, {"s": 4.8, "e": 6.16, "t": "Kiralayıcı ne oluyor?", "p": 0}, {"s": 6.52, "e": 8.24, "t": "İçindeki bütün itemler", "p": 0}, {"s": 8.24, "e": 9.62, "t": "şey...", "p": 0}, {"s": 10.78, "e": 12.46, "t": "Kaça kiralıyor musun?", "p": 0}, {"s": 12.88, "e": 14.18, "t": "Ha, içindeki bütün", "p": 0}, {"s": 14.18, "e": 15.5, "t": "itemleri bir haftalığına", "p": 0}, {"s": 15.5, "e": 17.0, "t": "kullanabiliyorsun.", "p": 0}, {"s": 17.46, "e": 19.32, "t": "Nasıl kiralıyoruz?", "p": 0}, {"s": 22.16, "e": 23.5, "t": "Tıklıyorsun, kirala", "p": 0}, {"s": 23.5, "e": 24.32, "t": "diyorsun.", "p": 0}, {"s": 26.5, "e": 27.98, "t": "Kiralama şey yok işte.", "p": 0}, {"s": 28.02, "e": 29.28, "t": "Onu nasıl açıyoruz?", "p": 0}, {"s": 29.28, "e": 30.62, "t": "Sağa tıklıyoruz,", "p": 0}, {"s": 30.62, "e": 31.08, "t": "solmuyor.", "p": 0}, {"s": 31.08, "e": 32.2, "t": "Sola tıklıyoruz, olmuyor.", "p": 0}, {"s": 32.2, "e": 34.62, "t": "kasayı aç dedim.", "p": 0}, {"s": 37.24, "e": 38.74, "t": "Sanırsam kasayı aç", "p": 0}, {"s": 38.74, "e": 39.16, "t": "deyince", "p": 0}, {"s": 39.16, "e": 40.88, "t": "kiralamış da alıyoruz.", "p": 0}, {"s": 40.9, "e": 42.14, "t": "Çünkü hayat dediğin nedir", "p": 0}, {"s": 42.14, "e": 42.9, "t": "ki?", "p": 0}, {"s": 43.0, "e": 44.38, "t": "Kiralıyorsun belirli bir", "p": 0}, {"s": 44.38, "e": 45.52, "t": "süreliğine.", "p": 0}, {"s": 46.7, "e": 48.0, "t": "Satın alsam bile.", "p": 0}]}