{"speakers": 1, "cues": [{"s": 0.0, "e": 0.68, "t": "Kasayı mı", "p": 0}, {"s": 0.68, "e": 1.84, "t": "kiralayabiliyoruz?", "p": 0}, {"s": 1.84, "e": 2.68, "t": "Kasayı.", "p": 0}, {"s": 2.68, "e": 3.78, "t": "Devrim kasası", "p": 0}, {"s": 3.78, "e": 4.78, "t": "kiralanabilir yazıyor.", "p": 0}, {"s": 4.78, "e": 6.16, "t": "Kiralayınca ne oluyor?", "p": 0}, {"s": 6.44, "e": 8.22, "t": "İçindeki bütün itemler", "p": 0}, {"s": 8.22, "e": 9.04, "t": "şey.", "p": 0}, {"s": 10.76, "e": 12.36, "t": "Kaça kiralıyoruz?", "p": 0}, {"s": 13.04, "e": 14.74, "t": "İçindeki bütün itemleri", "p": 0}, {"s": 14.74, "e": 15.5, "t": "bir haftalığına", "p": 0}, {"s": 15.5, "e": 17.06, "t": "kullanabiliyoruz.", "p": 0}, {"s": 17.54, "e": 19.28, "t": "Nasıl kiralıyoruz?", "p": 0}, {"s": 22.18, "e": 23.5, "t": "Tıklıyorsun kirala", "p": 0}, {"s": 23.5, "e": 24.32, "t": "diyorsun.", "p": 0}, {"s": 26.0, "e": 28.0, "t": "Kiralama şey yok işte.", "p": 0}, {"s": 28.06, "e": 29.28, "t": "Onu nasıl açıyoruz?", "p": 0}, {"s": 29.28, "e": 30.62, "t": "Sağa tıklıyoruz,", "p": 0}, {"s": 30.62, "e": 31.08, "t": "solmuyor.", "p": 0}, {"s": 31.08, "e": 32.18, "t": "Sola tıklıyoruz, olmuyor.", "p": 0}, {"s": 32.18, "e": 34.62, "t": "kasayı aç dedim.", "p": 0}, {"s": 37.18, "e": 38.72, "t": "Sanırsam kasayı aç", "p": 0}, {"s": 38.72, "e": 39.16, "t": "deyince", "p": 0}, {"s": 39.16, "e": 40.88, "t": "kiralamış da alıyoruz.", "p": 0}, {"s": 40.9, "e": 42.14, "t": "Çünkü hayat dediğin nedir", "p": 0}, {"s": 42.14, "e": 42.9, "t": "ki?", "p": 0}, {"s": 43.0, "e": 44.38, "t": "Kiralıyorsun belirli bir", "p": 0}, {"s": 44.38, "e": 45.52, "t": "süreliğine.", "p": 0}, {"s": 46.7, "e": 48.0, "t": "Satın alsam bile.", "p": 0}]}