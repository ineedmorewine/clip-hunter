{"speakers": 2, "cues": [{"s": 0.0, "e": 1.42, "t": "Sence nerede durmalı", "p": 0}, {"s": 1.42, "e": 1.96, "t": "Faysal?", "p": 0}, {"s": 1.96, "e": 3.22, "t": "Mesela ağzını bireceğim", "p": 0}, {"s": 3.22, "e": 4.44, "t": "şöyle ya.", "p": 1}, {"s": 5.16, "e": 6.1, "t": "Niyetini seyreder mi?", "p": 1}, {"s": 6.1, "e": 7.54, "t": "Adam sondakiler...", "p": 0}, {"s": 8.72, "e": 10.62, "t": "Duyuyorum çünkü Faysal", "p": 1}, {"s": 10.62, "e": 12.02, "t": "durmadan konuşuyor.", "p": 0}, {"s": 12.02, "e": 13.96, "t": "Ses duymuyorum abi.", "p": 1}, {"s": 14.16, "e": 16.2, "t": "Adam ses vermedi.", "p": 0}, {"s": 16.2, "e": 19.9, "t": "Adam ses vermedi.", "p": 0}, {"s": 19.9, "e": 20.66, "t": "Adam ses vermedi.", "p": 0}, {"s": 20.66, "e": 21.7, "t": "Sonunda birisi...", "p": 0}, {"s": 21.7, "e": 23.62, "t": "Birisi Faysal dışında...", "p": 0}, {"s": 23.62, "e": 25.18, "t": "Biri ben dışında Faysal", "p": 0}, {"s": 25.18, "e": 26.2, "t": "'a kızıyor ya.", "p": 0}, {"s": 26.2, "e": 27.5, "t": "Abi ben dedikten...", "p": 0}, {"s": 27.5, "e": 28.42, "t": "Bak ben de köklerde", "p": 0}, {"s": 28.42, "e": 29.94, "t": "durayım adam köşede", "p": 0}, {"s": 29.94, "e": 30.72, "t": "gelecek benim geldi.", "p": 0}, {"s": 30.72, "e": 31.46, "t": "Ben bugün hiç ilenmedim", "p": 0}, {"s": 31.46, "e": 32.86, "t": "gördünüz mü hiç muhatap", "p": 0}, {"s": 32.86, "e": 34.08, "t": "bile olmadı.", "p": 0}, {"s": 35.48, "e": 36.58, "t": "Abi ben dedim adam", "p": 0}, {"s": 36.58, "e": 37.32, "t": "oradan gelecek.", "p": 0}, {"s": 37.32, "e": 38.24, "t": "Hayır bir de sorayım", "p": 0}, {"s": 38.24, "e": 38.74, "t": "harcayız.", "p": 0}, {"s": 38.74, "e": 40.06, "t": "Ya senin...", "p": 0}, {"s": 40.87, "e": 42.59, "t": "Gelicek.", "p": 0}, {"s": 42.63, "e": 44.57, "t": "Mısır mı oluyum?", "p": 1}, {"s": 45.49, "e": 47.13, "t": "Hoca hala longa kimse", "p": 0}, {"s": 47.13, "e": 47.43, "t": "gitmiyor.", "p": 0}, {"s": 47.43, "e": 48.37, "t": "B, B, B, B,", "p": 0}, {"s": 48.37, "e": 49.75, "t": "B, B, B, B,", "p": 0}, {"s": 49.75, "e": 51.13, "t": "B, B'de öldüm, B", "p": 0}, {"s": 51.13, "e": 53.75, "t": "ile vurdu öldüm, bomba", "p": 0}, {"s": 53.75, "e": 54.37, "t": "şorttan geliyor", "p": 0}, {"s": 54.37, "e": 55.45, "t": "arkadaşlar,", "p": 0}, {"s": 56.35, "e": 58.19, "t": "çok da sinirli", "p": 0}, {"s": 66.1, "e": 67.78, "t": "Bak ağzımda dayı açmadım", "p": 0}, {"s": 67.78, "e": 68.86, "t": "öldüm bak gördün mü,", "p": 0}, {"s": 68.86, "e": 69.94, "t": "benden kanak değil", "p": 0}, {"s": 69.94, "e": 71.56, "t": "İkisini aldım abi zaten,", "p": 1}, {"s": 71.56, "e": 72.66, "t": "üçüncüye ölebilirim ben", "p": 1}, {"s": 72.66, "e": 72.66, "t": "dedim", "p": 1}, {"s": 72.66, "e": 73.74, "t": "Lan siktir oradan öyle", "p": 0}, {"s": 73.74, "e": 74.88, "t": "bir şey yok ya", "p": 0}, {"s": 74.88, "e": 76.74, "t": "Üçüncüye öldüm", "p": 0}, {"s": 79.02, "e": 81.1, "t": "Koca dönüyorlardı geri", "p": 0}, {"s": 81.24, "e": 82.74, "t": "Kusura bakma kardeşim,", "p": 1}, {"s": 82.74, "e": 84.1, "t": "siz de sez borcu", "p": 0}, {"s": 84.1, "e": 85.7, "t": "olduğumu söylemedim", "p": 1}, {"s": 85.94, "e": 87.62, "t": "M4A1 var yine de", "p": 0}, {"s": 87.96, "e": 90.56, "t": "Evet, benim değilim.", "p": 1}, {"s": 90.66, "e": 91.94, "t": "Ya ipne de AWP", "p": 0}, {"s": 91.94, "e": 92.78, "t": "var.", "p": 0}, {"s": 93.74, "e": 95.5, "t": "Ana ne siçik korktum", "p": 0}, {"s": 95.5, "e": 96.3, "t": "biliyor musun?", "p": 0}, {"s": 96.3, "e": 97.48, "t": "Yemin ediyorum.", "p": 0}, {"s": 100.71, "e": 101.99, "t": "Tam", "p": 1}, {"s": 104.24, "e": 105.9, "t": "as mı alayım, MP7", "p": 0}, {"s": 105.9, "e": 106.68, "t": "mi?", "p": 0}, {"s": 106.8, "e": 108.76, "t": "MP5, sen 7 alayım.", "p": 1}, {"s": 108.76, "e": 110.44, "t": "MP9 kanka.", "p": 0}, {"s": 112.2, "e": 113.46, "t": "9 çok sekiyor, ben", "p": 0}, {"s": 113.46, "e": 114.84, "t": "9 'u kullanamıyorum.", "p": 0}]}