{"speakers": 1, "cues": [{"s": 0.0, "e": 1.38, "t": "Sence nerede durmalı", "p": 0}, {"s": 1.38, "e": 1.94, "t": "Faysal?", "p": 0}, {"s": 1.94, "e": 3.32, "t": "Mesela ağzını bireceğim", "p": 0}, {"s": 3.32, "e": 4.42, "t": "şimdi ya.", "p": 0}, {"s": 5.2, "e": 6.1, "t": "Niyetini seyrederdim.", "p": 0}, {"s": 6.1, "e": 7.58, "t": "Adam sondakiler...", "p": 0}, {"s": 8.86, "e": 10.62, "t": "Duymuyorum çünkü Faysal", "p": 0}, {"s": 10.62, "e": 12.02, "t": "durmadan konuşuyor.", "p": 0}, {"s": 12.02, "e": 13.96, "t": "Ses duymuyorum abi.", "p": 0}, {"s": 14.16, "e": 15.86, "t": "Benden dolayı şükürler", "p": 0}, {"s": 15.86, "e": 16.7, "t": "olsun.", "p": 0}, {"s": 16.7, "e": 17.82, "t": "Sonunda biri meramımı", "p": 0}, {"s": 17.82, "e": 18.44, "t": "anladı.", "p": 0}, {"s": 18.44, "e": 19.92, "t": "Adam ses vermedi.", "p": 0}, {"s": 19.92, "e": 22.66, "t": "Sonunda birisi Faysal", "p": 0}, {"s": 22.66, "e": 23.76, "t": "dışında...", "p": 0}, {"s": 23.76, "e": 25.18, "t": "Biri ben dışında Faysal", "p": 0}, {"s": 25.18, "e": 26.18, "t": "'a kızıyor ya.", "p": 0}, {"s": 26.18, "e": 27.54, "t": "Abi ben dedikler olsun.", "p": 0}, {"s": 27.54, "e": 28.44, "t": "Bak ben de köklerde", "p": 0}, {"s": 28.44, "e": 29.94, "t": "durayım adam köşede", "p": 0}, {"s": 29.94, "e": 30.7, "t": "gelecektim geldi.", "p": 0}, {"s": 30.7, "e": 31.46, "t": "Ben bugün hiç ilenmedim", "p": 0}, {"s": 31.46, "e": 32.34, "t": "gördünüz mü?", "p": 0}, {"s": 32.34, "e": 34.08, "t": "Hiç muhatap bile olmadı.", "p": 0}, {"s": 35.56, "e": 36.58, "t": "Abi ben dedim adam", "p": 0}, {"s": 36.58, "e": 37.4, "t": "oradan gelecek.", "p": 0}, {"s": 37.4, "e": 38.7, "t": "Hayır bir sorayım harcam.", "p": 0}, {"s": 38.7, "e": 40.32, "t": "Ya senin...", "p": 0}, {"s": 41.13, "e": 42.47, "t": "Gelecek.", "p": 0}, {"s": 45.57, "e": 47.13, "t": "Hoca hala longa kimse", "p": 0}, {"s": 47.13, "e": 47.31, "t": "gelmedi.", "p": 0}, {"s": 47.31, "e": 48.39, "t": "B, B, B, B,", "p": 0}, {"s": 48.39, "e": 49.85, "t": "B, B, B, B'de", "p": 0}, {"s": 49.85, "e": 50.59, "t": "öldüm.", "p": 0}, {"s": 50.59, "e": 52.31, "t": "B ile vurdu öldüm.", "p": 0}, {"s": 53.19, "e": 54.39, "t": "Bomba şorttan geliyor", "p": 0}, {"s": 54.39, "e": 55.47, "t": "arkadaşlar.", "p": 0}, {"s": 55.95, "e": 57.25, "t": "Çok da sinirli.", "p": 0}, {"s": 57.25, "e": 58.77, "t": "bak", "p": 0}, {"s": 66.68, "e": 67.78, "t": "ağzımda dayı açmadım", "p": 0}, {"s": 67.78, "e": 68.68, "t": "öldüm bak gördün mü", "p": 0}, {"s": 68.68, "e": 69.76, "t": "ben ben benden kanak", "p": 0}, {"s": 69.76, "e": 69.94, "t": "değil", "p": 0}, {"s": 69.94, "e": 71.02, "t": "ha ikisini aldım abi", "p": 0}, {"s": 71.02, "e": 72.54, "t": "zaten üçüncüye ölebilirim", "p": 0}, {"s": 72.54, "e": 72.76, "t": "ben", "p": 0}, {"s": 72.76, "e": 73.74, "t": "lan siktir orda öyle", "p": 0}, {"s": 73.74, "e": 74.9, "t": "bir şey yok ya", "p": 0}, {"s": 74.9, "e": 76.72, "t": "üçüncüye öldü", "p": 0}, {"s": 78.78, "e": 80.5, "t": "koca dönüyorlardı geri", "p": 0}, {"s": 80.5, "e": 82.68, "t": "kusura bakma kardeşim", "p": 0}, {"s": 82.68, "e": 84.44, "t": "sütse esborcu olduğumu", "p": 0}, {"s": 84.44, "e": 85.7, "t": "söylemedim", "p": 0}, {"s": 85.84, "e": 87.68, "t": "m4a1 var yine de", "p": 0}, {"s": 87.78, "e": 89.6, "t": "evet benim de", "p": 0}, {"s": 90.36, "e": 92.8, "t": "ya ipnede avp var", "p": 0}, {"s": 93.82, "e": 95.5, "t": "ananı s**k korktum", "p": 0}, {"s": 95.5, "e": 96.54, "t": "biliyor musun yemin", "p": 0}, {"s": 96.54, "e": 97.88, "t": "ediyorum ya", "p": 0}, {"s": 98.91, "e": 101.83, "t": "Pek attım diyeyim", "p": 0}, {"s": 104.08, "e": 105.92, "t": "Tam asma alayım, MP7", "p": 0}, {"s": 105.92, "e": 106.7, "t": "mi?", "p": 0}, {"s": 106.7, "e": 107.5, "t": "MP5", "p": 0}, {"s": 107.5, "e": 108.8, "t": "Sen 7 kullanıyorsun ama", "p": 0}, {"s": 108.8, "e": 110.46, "t": "MP9 kanka", "p": 0}, {"s": 111.72, "e": 113.46, "t": "9 çok sekiyor, ben", "p": 0}, {"s": 113.46, "e": 114.46, "t": "9 'u kullanamıyorum", "p":