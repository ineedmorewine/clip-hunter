{"speakers": 1, "cues": [{"s": 0.0, "e": 2.28, "t": "Kargara yapmasını ben de", "p": 0}, {"s": 2.28, "e": 3.42, "t": "beklemiyordum, bu ilk", "p": 0}, {"s": 3.42, "e": 4.14, "t": "oldu.", "p": 0}, {"s": 4.14, "e": 6.1, "t": "O benden gelmedi.", "p": 0}, {"s": 7.32, "e": 9.04, "t": "Hazar mı gargara yaptı", "p": 0}, {"s": 9.04, "e": 9.78, "t": "oğlum?", "p": 0}, {"s": 10.02, "e": 11.48, "t": "Gargara yapmadım, su", "p": 0}, {"s": 11.48, "e": 12.51, "t": "içtim.", "p": 0}, {"s": 12.97, "e": 14.49, "t": "Olum patlayacak, nereye", "p": 0}, {"s": 14.49, "e": 15.21, "t": "çözüyorum?", "p": 0}, {"s": 15.21, "e": 16.57, "t": "Ölümün öldü", "p": 0}, {"s": 16.79, "e": 18.03, "t": "Öldü", "p": 0}, {"s": 18.59, "e": 19.23, "t": "Öldü", "p": 0}, {"s": 19.23, "e": 19.43, "t": "Aaa", "p": 0}, {"s": 19.43, "e": 20.63, "t": "Ya Faisal sana ne", "p": 0}, {"s": 20.63, "e": 21.33, "t": "bulur zekisin", "p": 0}, {"s": 21.33, "e": 22.33, "t": "Bir şey söyleyeceğim", "p": 0}, {"s": 22.33, "e": 23.65, "t": "arkadaşlar B 'ye kurmuş", "p": 0}, {"s": 23.65, "e": 24.75, "t": "B 'ye kurmuş, nereye", "p": 0}, {"s": 24.75, "e": 25.22, "t": "çözerim?", "p": 0}, {"s": 25.22, "e": 26.4, "t": "Eeeh", "p": 0}, {"s": 29.13, "e": 31.51, "t": "Ben böyle bir dangalaklık", "p": 0}, {"s": 31.51, "e": 32.01, "t": "görmedim", "p": 0}, {"s": 32.01, "e": 33.91, "t": "Ay zebine olurum", "p": 0}, {"s": 33.91, "e": 35.71, "t": "Bugün yine başımı belaya", "p": 0}, {"s": 35.71, "e": 36.72, "t": "soktum", "p": 0}, {"s": 36.72, "e": 38.48, "t": "Yemlemiş hayvanı.", "p": 0}, {"s": 39.48, "e": 40.96, "t": "Gariban bakıma kutuları", "p": 0}, {"s": 40.96, "e": 41.86, "t": "zıpladı üzerine doğru.", "p": 0}, {"s": 41.86, "e": 43.38, "t": "Ya o 20 centlik", "p": 0}, {"s": 43.38, "e": 44.64, "t": "kutuyu alacaktım ya da", "p": 0}, {"s": 44.64, "e": 46.52, "t": "civcivimi doyuracaktım.", "p": 0}, {"s": 46.52, "e": 47.48, "t": "Ben de doğru olanı", "p": 0}, {"s": 47.48, "e": 48.78, "t": "yapıp 20 centlik kutuyu", "p": 0}, {"s": 48.78, "e": 49.43, "t": "seçtim.", "p": 0}, {"s": 49.43, "e": 51.35, "t": "Arkadaşlar", "p": 0}, {"s": 51.43, "e": 53.18, "t": "İyi haberi vereyim", "p": 0}, {"s": 53.18, "e": 55.07, "t": "Artık kuşum ötüyor", "p": 0}, {"s": 55.81, "e": 57.51, "t": "Evet ben tıkladım da", "p": 0}, {"s": 57.51, "e": 58.83, "t": "Ademin mi cık cık", "p": 0}, {"s": 58.83, "e": 59.27, "t": "cık yapıyor", "p": 0}, {"s": 59.27, "e": 59.79, "t": "Tıkladım", "p": 0}, {"s": 59.79, "e": 62.13, "t": "Tabi tabi artık ötüyor", "p": 0}, {"s": 62.13, "e": 64.51, "t": "Sen niye ateşin içinde", "p": 0}, {"s": 64.51, "e": 66.05, "t": "bir yük bekledin?", "p": 0}, {"s": 66.45, "e": 67.81, "t": "Belki Paysal 'ın", "p": 0}, {"s": 67.81, "e": 69.15, "t": "molotofuysa ölür diye", "p": 0}, {"s": 69.15, "e": 70.39, "t": "bekledim de Paysal 'ın", "p": 0}, {"s": 70.39, "e": 71.65, "t": "molotofu değilmiş.", "p": 0}, {"s": 71.65, "e": 73.29, "t": "Oğlum manyak mısın?", "p": 0}, {"s": 81.27, "e": 83.33, "t": "O şeyin arkasına bak", "p": 0}, {"s": 83.33, "e": 84.81, "t": "köşe köşe köşe aynen", "p": 0}, {"s": 84.81, "e": 86.25, "t": "aynen sağda sağda", "p": 0}]}