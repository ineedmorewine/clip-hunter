{"speakers": 2, "cues": [{"s": 0.0, "e": 2.28, "t": "Kargara yapmasını ben de", "p": 0}, {"s": 2.28, "e": 3.1, "t": "beklemiyordum.", "p": 0}, {"s": 3.1, "e": 4.32, "t": "Bu ilk oldu.", "p": 0}, {"s": 4.64, "e": 6.08, "t": "O benden gelmedi.", "p": 0}, {"s": 7.4, "e": 9.62, "t": "Hazar mı gargara yaptı?", "p": 0}, {"s": 10.1, "e": 11.36, "t": "Gargara yapmadım.", "p": 0}, {"s": 11.36, "e": 12.51, "t": "Su içtim.", "p": 0}, {"s": 12.97, "e": 14.49, "t": "Olum patlayacak nereye", "p": 1}, {"s": 14.49, "e": 15.05, "t": "çözüyorum", "p": 1}, {"s": 15.05, "e": 16.75, "t": "Ölümün öldü", "p": 0}, {"s": 16.75, "e": 18.85, "t": "Öldü", "p": 0}, {"s": 18.85, "e": 19.43, "t": "Aaa", "p": 1}, {"s": 19.43, "e": 22.31, "t": "Bir şey söyleyeceğim", "p": 0}, {"s": 22.31, "e": 22.65, "t": "arkadaşlar", "p": 1}, {"s": 22.65, "e": 23.69, "t": "B 'ye kurmuş", "p": 1}, {"s": 23.69, "e": 25.21, "t": "Nereye çözerim", "p": 1}, {"s": 25.21, "e": 25.79, "t": "ehh", "p": 0}, {"s": 25.79, "e": 26.97, "t": "ben", "p": 0}, {"s": 28.42, "e": 31.5, "t": "böyle bir dangalaklık", "p": 0}, {"s": 31.5, "e": 32.0, "t": "görmedim", "p": 0}, {"s": 32.0, "e": 33.9, "t": "ay zebbine olurum", "p": 0}, {"s": 33.9, "e": 36.71, "t": "yine başımı belaya soktum", "p": 0}, {"s": 36.71, "e": 38.43, "t": "Yemlemiş hayvanı.", "p": 0}, {"s": 39.53, "e": 40.81, "t": "Gariban bakıp akıp", "p": 0}, {"s": 40.81, "e": 41.29, "t": "duruyordu zıpladığı", "p": 0}, {"s": 41.29, "e": 41.85, "t": "üzerine doğru.", "p": 0}, {"s": 41.85, "e": 43.39, "t": "Ya o 20 centlik", "p": 0}, {"s": 43.39, "e": 44.63, "t": "kutuyu alacaktım ya da", "p": 0}, {"s": 44.63, "e": 46.27, "t": "civcivimi doyuracaktım.", "p": 0}, {"s": 46.27, "e": 47.45, "t": "Ben de doğru olanı", "p": 0}, {"s": 47.45, "e": 48.77, "t": "yapıp 20 centlik kutuyu", "p": 0}, {"s": 48.77, "e": 49.42, "t": "seçtim.", "p": 0}, {"s": 49.42, "e": 51.34, "t": "Arkadaşlar", "p": 0}, {"s": 51.42, "e": 53.18, "t": "İyi haberi vereyim", "p": 0}, {"s": 53.18, "e": 55.06, "t": "A