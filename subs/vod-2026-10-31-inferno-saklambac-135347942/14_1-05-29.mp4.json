{"speakers": 2, "cues": [{"s": 1.58, "e": 3.34, "t": "Ay çok sırıtıyorum şu", "p": 1}, {"s": 3.34, "e": 4.48, "t": "an burada bulunduğum", "p": 1}, {"s": 4.48, "e": 5.3, "t": "yerde gerçi", "p": 1}, {"s": 5.3, "e": 6.08, "t": "Faysal tak niye hareket", "p": 0}, {"s": 6.08, "e": 8.04, "t": "ediyosun?", "p": 0}, {"s": 23.52, "e": 26.2, "t": "Gidemedi R'de bitti", "p": 1}, {"s": 27.43, "e": 28.69, "t": "Hareket etmedim", "p": 1}, {"s": 28.69, "e": 30.03, "t": "vurmayacak gibi bakıyordu", "p": 0}, {"s": 30.03, "e": 30.51, "t": "biliyor musun?", "p": 1}, {"s": 30.51, "e": 32.23, "t": "Hareket etmedim vurdu", "p": 1}, {"s": 32.23, "e": 34.05, "t": "Yok hareket etmedi", "p": 0}, {"s": 34.05, "e": 35.17, "t": "hareket etmedi ya", "p": 0}, {"s": 35.17, "e": 36.29, "t": "Görmedim hareket etmedi", "p": 0}, {"s": 36.29, "e": 37.49, "t": "Nasıl etmedi bende etti", "p": 0}, {"s": 37.49, "e": 38.39, "t": "hareket", "p": 0}, {"s": 38.43, "e": 39.41, "t": "Kameram görmedim", "p": 0}, {"s": 39.41, "e": 41.65, "t": "Kameram mı değişti hocam?", "p": 1}, {"s": 41.65, "e": 43.13, "t": "Allah seni Faysal", "p": 1}, {"s": 43.13, "e": 45.87, "t": "Hay sağ ol.", "p": 1}]}