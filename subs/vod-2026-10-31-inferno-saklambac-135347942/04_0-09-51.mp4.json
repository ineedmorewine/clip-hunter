{"speakers": 2, "cues": [{"s": 0.0, "e": 2.44, "t": "Bıçaklamaya geldik.", "p": 0}, {"s": 5.87, "e": 7.45, "t": "Bir kontrol ettim kim", "p": 0}, {"s": 7.45, "e": 8.17, "t": "öldü diye.", "p": 0}, {"s": 8.17, "e": 9.63, "t": "Baktım Faysal ölmüş,", "p": 0}, {"s": 9.63, "e": 10.51, "t": "benim için bir zevki", "p": 0}, {"s": 10.51, "e": 12.11, "t": "kalmadı hiçbir şey.", "p": 0}, {"s": 12.97, "e": 14.45, "t": "Ay vuramadım.", "p": 0}, {"s": 14.45, "e": 15.99, "t": "Arkada, arkada, arkada,", "p": 0}, {"s": 15.99, "e": 17.07, "t": "arkada.", "p": 0}, {"s": 17.91, "e": 19.45, "t": "Ay arkada.", "p": 0}, {"s": 20.55, "e": 21.91, "t": "Şerefsiz mi demek?", "p": 0}, {"s": 21.91, "e": 23.05, "t": "Hani bak, ekleyip", "p": 0}, {"s": 23.05, "e": 24.15, "t": "sıkarken bana nasıl...", "p": 0}, {"s": 24.15, "e": 24.95, "t": "Aldın mı?", "p": 1}, {"s": 24.95, "e": 25.97, "t": "Ne ara aldın?", "p": 1}, {"s": 26.29, "e": 27.83, "t": "İşte saldırtmaya kendine.", "p": 0}, {"s": 27.83, "e": 28.97, "t": "Durduk yere...", "p": 0}, {"s": 28.97, "e": 30.53, "t": "Yok yalandan özürler", "p": 0}, {"s": 30.53, "e": 31.07, "t": "bana.", "p": 0}]}