{"speakers": 2, "cues": [{"s": 1.68, "e": 3.58, "t": "Musa 'yı şaklamışsın.", "p": 0}, {"s": 3.58, "e": 5.42, "t": "Bunun kuşun her şeyi.", "p": 0}, {"s": 5.42, "e": 6.16, "t": "Sen görüyor musun lan", "p": 0}, {"s": 6.16, "e": 7.04, "t": "beni?", "p": 0}, {"s": 7.24, "e": 7.92, "t": "Yok.", "p": 0}, {"s": 7.92, "e": 9.42, "t": "Ben ne olabileceğinizi", "p": 0}, {"s": 9.42, "e": 10.28, "t": "bilsem keşke.", "p": 0}, {"s": 10.28, "e": 11.16, "t": "Bari ne olduğunuzu", "p": 0}, {"s": 11.16, "e": 12.06, "t": "söyleyin ya.", "p": 0}, {"s": 12.06, "e": 14.16, "t": "Öyle olmaz ki.", "p": 1}, {"s": 14.82, "e": 16.96, "t": "Hoş geldiniz bu arada", "p": 1}, {"s": 16.96, "e": 18.04, "t": "yayına.", "p": 1}, {"s": 18.2, "e": 19.88, "t": "Niye olmaz ki ya?", "p": 0}, {"s": 21.45, "e": 22.51, "t": "Ay yazılı bir kuralları", "p": 0}, {"s": 22.51, "e": 23.85, "t": "biz mi okumadık?", "p": 0}, {"s": 24.95, "e": 26.39, "t": "Arkadaş siz sıkacaksınız,", "p": 0}, {"s": 26.39, "e": 27.59, "t": "bulacaksınız bizi.", "p": 1}, {"s": 28.01, "e": 29.45, "t": "Lan erkek ol biraz", "p": 0}, {"s": 29.45, "e": 30.47, "t": "neye dönüştüğünü söyle", "p": 0}, {"s": 30.47, "e": 31.19, "t": "bari eşek.", "p": 0}, {"s": 31.19, "e": 33.69, "t": "4", "p": 0}, {"s": 38.82, "e": 39.92, "t": "yaşındaydın", "p": 0}]}