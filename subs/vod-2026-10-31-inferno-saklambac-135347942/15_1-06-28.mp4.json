{"speakers": 2, "cues": [{"s": 0.0, "e": 1.1, "t": "Zorlu yanım.", "p": 0}, {"s": 1.1, "e": 2.66, "t": "Ya falan koşmadım.", "p": 0}, {"s": 2.98, "e": 4.14, "t": "Ben bahçeli bir şey", "p": 0}, {"s": 4.14, "e": 4.6, "t": "dedim.", "p": 0}, {"s": 4.6, "e": 5.92, "t": "Ben senin motor günlerini", "p": 0}, {"s": 5.92, "e": 6.92, "t": "de bilirim.", "p": 0}, {"s": 6.92, "e": 8.22, "t": "Sen konuş bakayım.", "p": 0}, {"s": 8.22, "e": 9.04, "t": "Ben senin motorluk", "p": 0}, {"s": 9.04, "e": 10.6, "t": "zamanını da bilirim.", "p": 0}, {"s": 11.9, "e": 13.24, "t": "Konuştun mu?", "p": 0}, {"s": 15.24, "e": 16.78, "t": "Helal olsun.", "p": 1}, {"s": 17.36, "e": 18.52, "t": "Oğlum benimle bunu", "p": 0}, {"s": 18.52, "e": 19.66, "t": "söylemişsin, yazmışsınız", "p": 0}, {"s": 19.66, "e": 20.44, "t": "bunu benimle.", "p": 0}, {"s": 20.44, "e": 22.28, "t": "Yok be, yazar mısın?", "p": 0}]}