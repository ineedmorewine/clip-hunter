{"speakers": 2, "cues": [{"s": 0.0, "e": 1.3, "t": "Allah kahretmesin Faysal.", "p": 1}, {"s": 1.3, "e": 2.16, "t": "Sen mi indirdin kendi", "p": 1}, {"s": 2.16, "e": 3.98, "t": "takım arkadaşının canını?", "p": 1}, {"s": 3.98, "e": 4.82, "t": "Bir de bunu söylüyor", "p": 1}, {"s": 4.82, "e": 5.66, "t": "musun?", "p": 1}, {"s": 6.54, "e": 7.5, "t": "Fuuu yazıklar.", "p": 1}, {"s": 7.71, "e": 8.95, "t": "Ben erkek ol biraz", "p": 0}, {"s": 8.95, "e": 10.17, "t": "neye dönüştüğünü söyle bu", "p": 0}, {"s": 10.17, "e": 11.13, "t": "arada eşek.", "p": 0}, {"s": 14.01, "e": 15.61, "t": "Merdiven abla.", "p": 0}, {"s": 17.37, "e": 18.67, "t": "Merdiven abla.", "p": 0}, {"s": 18.67, "e": 19.85, "t": "Merdiven abla.", "p": 0}, {"s": 19.93, "e": 21.37, "t": "Allah 'ım ya, Allah", "p": 0}, {"s": 21.37, "e": 22.49, "t": "'ım da nikah etsin", "p": 0}, {"s": 22.49, "e": 23.27, "t": "ya.", "p": 0}, {"s": 23.89, "e": 25.31, "t": "Ya şundan bir de", "p": 0}, {"s": 25.31, "e": 25.51, "t": "kaçmaya...", "p": 0}, {"s": 25.69, "e": 27.95, "t": "Oğlum ben orada fıçıydım.", "p": 1}, {"s": 27.95, "e": 29.47, "t": "Bir anda lamba oldum.", "p": 1}, {"s": 29.47, "e": 31.07, "t": "Ama hiç görmedim.", "p": 1}, {"s": 31.07, "e": 32.37, "t": "Ben panik yaptım.", "p": 1}, {"s": 33.1, "e": 34.4, "t": "Abi arabalık kocaman,", "p": 0}, {"s": 34.4, "e": 34.92, "t": "nereli parki için", "p": 0}, {"s": 34.92, "e": 35.68, "t": "arabayı?", "p": 0}, {"s": 44.76, "e": 46.44, "t": "Bir yana garaj kapısı", "p": 0}, {"s": 46.44, "e": 47.6, "t": "oldum arkadaşlar.", "p": 0}, {"s": 49.53, "e": 51.09, "t": "dedim ki bak", "p": 1}, {"s": 51.09, "e": 53.05, "t": "kovalamayacaktım lan", "p": 1}, {"s": 53.05, "e": 53.33, "t": "dedim", "p": 1}, {"s": 53.33, "e": 54.33, "t": "fıtır fıtır koşuyor", "p": 1}, {"s": 54.33, "e": 55.05, "t": "hiçbir tavuk böyle", "p": 1}, {"s": 55.05, "e": 56.01, "t": "koşmuyordu dedim", "p": 1}, {"s": 56.01, "e": 57.89, "t": "çok hızlı koşmanın", "p": 1}, {"s": 57.89, "e": 59.54, "t": "anladım", "p": 1}, {"s": 59.54, "e": 62.34, "t": "Aha gördüm.", "p": 1}, {"s": 70.04, "e": 71.68, "t": "Çöp poşete olarak", "p": 1}, {"s": 71.68, "e": 73.52, "t": "koşmayacağız şut.", "p": 1}, {"s": 78.56, "e": 79.98, "t": "Çok mu ya orada", "p": 1}, {"s": 79.98, "e": 80.78, "t": "duruyordum.", "p": 1}, {"s": 80.78, "e": 81.9, "t": "Ne yani insanlar gayet", "p": 1}, {"s": 81.9, "e": 83.56, "t": "şarap yaparken", "p": 1}, {"s": 84.08, "e": 86.08, "t": "radyo dinleyebilirler.", "p": 1}]}