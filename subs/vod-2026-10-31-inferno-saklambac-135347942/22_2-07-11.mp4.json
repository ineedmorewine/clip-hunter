{"speakers": 2, "cues": [{"s": 1.12, "e": 3.0, "t": "Ya Allah 'ın belası,", "p": 0}, {"s": 3.0, "e": 4.56, "t": "takip etme beni.", "p": 0}, {"s": 5.92, "e": 7.46, "t": "Sen Faysal'dan mı", "p": 0}, {"s": 7.46, "e": 8.48, "t": "kaçıyorsun?", "p": 0}, {"s": 8.62, "e": 9.44, "t": "Evet.", "p": 0}, {"s": 17.39, "e": 18.75, "t": "Faysal 'a bakalım.", "p": 0}, {"s": 19.93, "e": 21.37, "t": "İnşallah yakalayabilirsin", "p": 0}, {"s": 21.37, "e": 22.15, "t": "Faysal 'ı.", "p": 0}, {"s": 22.15, "e": 23.51, "t": "Yolun ortasında vozo", "p": 0}, {"s": 23.51, "e": 24.65, "t": "geziyor.", "p": 0}, {"s": 26.35, "e": 27.67, "t": "Erkan Duba oldu, yolun", "p": 0}, {"s": 27.67, "e": 29.09, "t": "ortasında hala.", "p": 0}, {"s": 30.37, "e": 32.21, "t": "Armatür oldu, ışık.", "p": 0}]}