{"speakers": 2, "cues": [{"s": 1.58, "e": 3.64, "t": "Ağzıma sıçayım.", "p": 1}, {"s": 3.86, "e": 5.32, "t": "Çok mu ya orada", "p": 1}, {"s": 5.32, "e": 6.14, "t": "duruyordum.", "p": 1}, {"s": 6.14, "e": 7.64, "t": "Yani insanlar gayet şarap", "p": 1}, {"s": 7.64, "e": 8.9, "t": "yaparken", "p": 1}, {"s": 9.42, "e": 11.7, "t": "radyo dinleyebilirler.", "p": 1}, {"s": 13.59, "e": 15.15, "t": "O kadar alışmışım ki", "p": 0}, {"s": 15.15, "e": 16.21, "t": "sana yemin ediyorum", "p": 0}, {"s": 16.21, "e": 17.69, "t": "O oynaya oynaya", "p": 1}, {"s": 17.69, "e": 19.03, "t": "hatırlıyorsun.", "p": 1}, {"s": 19.55, "e": 19.73, "t": "Yo", "p": 0}, {"s": 19.73, "e": 22.15, "t": "Sper aldım.", "p": 0}, {"s": 22.21, "e": 23.63, "t": "Hazar bana saldıracakmış", "p": 0}, {"s": 23.63, "e": 24.47, "t": "gibi.", "p": 1}, {"s": 29.93, "e": 31.63, "t": "Eve kaçtı Faysal Hazar.", "p": 0}, {"s": 31.63, "e": 32.75, "t": "Şeydi.", "p": 0}, {"s": 32.75, "e": 34.19, "t": "Tabelaydı.", "p": 0}, {"s": 34.41, "e": 35.83, "t": "Ben tabelaydı.", "p": 0}, {"s": 35.83, "e": 37.27, "t": "İki defa faya kapıştım.", "p": 0}, {"s": 37.27, "e": 39.17, "t": "Şu an ne?", "p": 1}, {"s": 41.06, "e": 42.56, "t": "Ben ne muana?", "p": 0}, {"s": 43.18, "e": 44.68, "t": "Ah sen mi?", "p": 0}]}