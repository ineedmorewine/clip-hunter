{"speakers": 2, "cues": [{"s": 0.0, "e": 1.76, "t": "Ben almamıştım.", "p": 1}, {"s": 1.76, "e": 3.1, "t": "Lan?", "p": 1}, {"s": 3.34, "e": 4.96, "t": "Nereye kurdun?", "p": 1}, {"s": 4.96, "e": 5.88, "t": "B 'ye gitti değil", "p": 0}, {"s": 5.88, "e": 6.6, "t": "mi?", "p": 0}, {"s": 6.68, "e": 8.3, "t": "Oğlum A 'ya gitti.", "p": 0}, {"s": 8.3, "e": 10.4, "t": "Bir şey diyeceğim.", "p": 1}, {"s": 10.84, "e": 12.64, "t": "Bir şey diyeceğim.", "p": 1}, {"s": 12.64, "e": 13.7, "t": "Ben az önce A", "p": 1}, {"s": 13.7, "e": 14.5, "t": "'ya girdim.", "p": 1}, {"s": 14.5, "e": 15.96, "t": "A'da hiç canım gidecek", "p": 1}, {"s": 15.96, "e": 17.18, "t": "gözükmedi.", "p": 1}, {"s": 17.18, "e": 18.84, "t": "Ben gittim şorta kadar", "p": 1}, {"s": 18.84, "e": 20.04, "t": "gittim bilerek.", "p": 1}, {"s": 20.04, "e": 21.68, "t": "Baktım canım azalmıyor.", "p": 1}, {"s": 21.68, "e": 23.52, "t": "Geri B 'ye döndü.", "p": 1}, {"s": 26.48, "e": 28.44, "t": "Tüt tüt diyordu.", "p": 1}, {"s": 29.3, "e": 31.18, "t": "Bak bu kafana sıkıyorum", "p": 0}, {"s": 31.18, "e": 32.04, "t": "Allah 'ım sana ya", "p": 0}, {"s": 32.04, "e": 33.72, "t": "da ben söyleyeyim bak.", "p": 0}]}