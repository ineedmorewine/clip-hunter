{"speakers": 2, "cues": [{"s": 0.0, "e": 1.18, "t": "Aynen.", "p": 0}, {"s": 1.66, "e": 3.38, "t": "Ben E 'ye basıncım", "p": 0}, {"s": 3.38, "e": 4.62, "t": "uçtun oluma.", "p": 1}, {"s": 9.91, "e": 11.23, "t": "Siktirsin.", "p": 1}, {"s": 18.96, "e": 20.82, "t": "Birisi mi çabalıyor ya?", "p": 1}, {"s": 20.82, "e": 21.62, "t": "Ne?", "p": 1}, {"s": 24.21, "e": 26.47, "t": "Yolda, yolda kaçan bir", "p": 0}, {"s": 26.47, "e": 28.05, "t": "tablo gördüm.", "p": 1}, {"s": 28.35, "e": 29.95, "t": "Oğlum ben orada fıçıydım", "p": 1}, {"s": 29.95, "e": 31.81, "t": "bir anda lamba oldum.", "p": 1}, {"s": 31.81, "e": 33.35, "t": "Ama hiç görmedim ben", "p": 1}, {"s": 33.35, "e": 34.59, "t": "panik yaptım.", "p": 1}, {"s": 34.69, "e": 35.85, "t": "Hazar da tam benim", "p": 0}, {"s": 35.85, "e": 37.73, "t": "yanımdan geçerken değil.", "p": 0}, {"s": 39.41, "e": 40.97, "t": "Masaya çıkmasın.", "p": 1}, {"s": 41.13, "e": 42.29, "t": "O doğru.", "p": 1}]}