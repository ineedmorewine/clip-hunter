{"speakers": 2, "cues": [{"s": 1.26, "e": 3.54, "t": "Otodeğişimi olacak.", "p": 1}, {"s": 4.38, "e": 6.04, "t": "Neye dönüşeceğim?", "p": 1}, {"s": 6.04, "e": 6.66, "t": "As!", "p": 1}, {"s": 7.76, "e": 8.92, "t": "Okey.", "p": 1}, {"s": 13.12, "e": 14.42, "t": "Çok okey bence şu", "p": 1}, {"s": 14.42, "e": 15.16, "t": "an.", "p": 1}, {"s": 20.0, "e": 21.22, "t": "Bir yana garaj kapısı", "p": 0}, {"s": 21.22, "e": 22.54, "t": "oldum arkadaşlar.", "p": 0}, {"s": 24.87, "e": 25.69, "t": "Sen de mi buraya", "p": 1}, {"s": 25.69, "e": 26.23, "t": "geldin?", "p": 1}, {"s": 26.23, "e": 27.49, "t": "Hoş geldin.", "p": 1}, {"s": 32.27, "e": 33.33, "t": "Of ya!", "p": 0}, {"s": 33.33, "e": 35.47, "t": "Sıkıştım kaldım geldim.", "p": 0}]}