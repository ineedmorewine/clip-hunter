{"speakers": 2, "cues": [{"s": 0.84, "e": 1.96, "t": "Kaan 'ı izlemek", "p": 0}, {"s": 1.96, "e": 2.94, "t": "istiyordum ya.", "p": 0}, {"s": 2.94, "e": 5.32, "t": "Adam ev oldu ya.", "p": 0}, {"s": 8.01, "e": 9.33, "t": "Musa 'nın araba olduğu", "p": 0}, {"s": 9.33, "e": 10.39, "t": "için çok izlemek", "p": 0}, {"s": 10.39, "e": 11.61, "t": "istiyordum.", "p": 0}, {"s": 13.76, "e": 15.22, "t": "Arabayla çok saklanmaya", "p": 0}, {"s": 15.22, "e": 17.18, "t": "çalıştım ama başaramadım.", "p": 0}, {"s": 19.58, "e": 21.2, "t": "Arabayla saklansan zaten", "p": 0}, {"s": 21.2, "e": 22.18, "t": "ya Hüda ne diyeyim", "p": 0}, {"s": 22.18, "e": 23.06, "t": "ki sen?", "p": 0}, {"s": 26.2, "e": 27.34, "t": "Biz burada tencereyle", "p": 0}, {"s": 27.34, "e": 28.68, "t": "saklanamıyoruz.", "p": 0}, {"s": 30.88, "e": 32.34, "t": "Tencere mi?", "p": 1}, {"s": 34.69, "e": 35.63, "t": "Benim mermim bitti.", "p": 0}, {"s": 35.63, "e": 37.17, "t": "Bir tane mermim kaldı.", "p": 0}, {"s": 44.1, "e": 45.4, "t": "Mümkün değil bu arada.", "p": 0}, {"s": 45.4, "e": 46.16, "t": "Yalansın.", "p": 0}]}