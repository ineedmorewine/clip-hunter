{"speakers": 2, "cues": [{"s": 0.34, "e": 1.1, "t": "Ne oluyor?", "p": 0}, {"s": 1.1, "e": 2.7, "t": "Değiştirmesin boşuna.", "p": 0}, {"s": 3.4, "e": 4.16, "t": "Ah tovuk aldım lan", "p": 0}, {"s": 4.16, "e": 4.92, "t": "diyor.", "p": 0}, {"s": 5.66, "e": 7.14, "t": "Lan değişmiyor tovuk", "p": 0}, {"s": 7.14, "e": 8.14, "t": "aldım.", "p": 1}, {"s": 8.68, "e": 10.34, "t": "Salak ya.", "p": 0}, {"s": 12.12, "e": 13.62, "t": "Musa nasın?", "p": 0}, {"s": 14.06, "e": 15.18, "t": "Çok iyisin.", "p": 0}, {"s": 17.22, "e": 18.52, "t": "Allah aşkına defol git", "p": 0}, {"s": 18.52, "e": 19.46, "t": "buradan.", "p": 0}, {"s": 23.61, "e": 24.85, "t": "Ya başkan gülümün.", "p": 0}, {"s": 24.85, "e": 30.39, "t": "Hadi be.", "p": 0}, {"s": 37.28, "e": 38.74, "t": "Aldım değil mi?", "p": 1}, {"s": 38.96, "e": 39.3, "t": "Kalk.", "p": 1}, {"s": 39.3, "e": 40.26, "t": "Dedim ki bak", "p": 1}, {"s": 40.26, "e": 42.14, "t": "kovalamayacaktım.", "p": 1}, {"s": 42.14, "e": 43.1, "t": "Lan dedim fıtır fıtır", "p": 1}, {"s": 43.1, "e": 43.58, "t": "koşuyor.", "p": 1}, {"s": 43.58, "e": 44.2, "t": "Hiçbir tavuk böyle", "p": 1}, {"s": 44.2, "e": 45.74, "t": "koşmuyordu dedim.", "p": 1}, {"s": 45.92, "e": 47.58, "t": "Çok hızlı koştum lan.", "p": 1}, {"s": 47.98, "e": 49.18, "t": "Anladım.", "p": 1}, {"s": 51.32, "e": 52.46, "t": "Nasıl koşuyordun?", "p": 0}, {"s": 52.46, "e": 54.1, "t": "Fıtır fıtır.", "p": 1}, {"s": 57.35, "e": 58.55, "t": "Nasıl", "p": 0}, {"s": 59.26, "e": 60.78, "t": "kaldım orada ya?", "p": 0}]}