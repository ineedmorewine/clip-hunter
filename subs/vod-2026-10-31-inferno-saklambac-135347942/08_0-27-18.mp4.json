{"speakers": 2, "cues": [{"s": 1.2, "e": 2.38, "t": "Faysal yine niye", "p": 0}, {"s": 2.38, "e": 3.88, "t": "saklanıyor mesela, Faysal", "p": 0}, {"s": 3.88, "e": 5.7, "t": "'ı söyleyelim abi, Faysal", "p": 0}, {"s": 5.7, "e": 7.0, "t": "radyo abi,", "p": 0}, {"s": 7.38, "e": 8.7, "t": "nerede biliyorsunuz,", "p": 0}, {"s": 8.7, "e": 10.78, "t": "koşuyor ağda,", "p": 0}, {"s": 11.1, "e": 13.72, "t": "yolda radyo var ağda,", "p": 0}, {"s": 13.86, "e": 15.12, "t": "bir de doğru gidiyor", "p": 0}, {"s": 15.12, "e": 15.86, "t": "şimdi,", "p": 0}, {"s": 15.86, "e": 17.2, "t": "sefet oldu,", "p": 0}, {"s": 19.05, "e": 21.03, "t": "hanço geri gel hanço,", "p": 0}, {"s": 21.03, "e": 21.89, "t": "ha gel gel 3", "p": 0}, {"s": 21.89, "e": 22.89, "t": "önünde abi şu an,", "p": 0}, {"s": 22.89, "e": 24.23, "t": "o sefet oldu.", "p": 0}, {"s": 32.13, "e": 33.67, "t": "Allah 'ım ya Allah", "p": 0}, {"s": 33.67, "e": 34.43, "t": "seni kârı", "p": 0}, {"s": 34.43, "e": 37.57, "t": "Ya şununla bir de", "p": 0}, {"s": 37.57, "e": 38.89, "t": "kaçmaya olur", "p": 0}, {"s": 39.75, "e": 41.85, "t": "Oh ammuzun tak", "p": 1}, {"s": 44.79, "e": 46.09, "t": "Oh bu da iyiymiş", "p": 0}, {"s": 46.09, "e": 46.31, "t": "bak", "p": 0}, {"s": 46.31, "e": 47.87, "t": "Hadi bulun lan beni", "p": 1}, {"s": 47.87, "e": 48.53, "t": "bulun", "p": 1}]}