{"speakers": 2, "cues": [{"s": 0.0, "e": 1.38, "t": "Daha çok uyandı boy", "p": 0}, {"s": 1.38, "e": 2.14, "t": "modunda.", "p": 0}, {"s": 2.14, "e": 3.78, "t": "Abi ben bununla", "p": 0}, {"s": 3.78, "e": 5.26, "t": "saklanacağım ya.", "p": 0}, {"s": 5.38, "e": 6.3, "t": "Abi dur arkana bileyim.", "p": 0}, {"s": 6.3, "e": 7.28, "t": "Dur bekle abi dur.", "p": 0}, {"s": 7.28, "e": 7.94, "t": "Gel gel.", "p": 0}, {"s": 7.94, "e": 8.78, "t": "Oğlum.", "p": 0}, {"s": 8.82, "e": 10.4, "t": "Arkana bileyim.", "p": 1}, {"s": 10.68, "e": 11.78, "t": "Geçemiyorum.", "p": 0}, {"s": 11.78, "e": 12.88, "t": "Abi", "p": 0}, {"s": 18.01, "e": 19.79, "t": "sana bileyim ne abi.", "p": 0}, {"s": 20.23, "e": 21.63, "t": "Abi bileyim.", "p": 0}, {"s": 21.63, "e": 23.29, "t": "Burası olmaz.", "p": 1}, {"s": 24.27, "e": 25.65, "t": "Ha bak.", "p": 1}, {"s": 26.47, "e": 28.61, "t": "Ha bak burası olur.", "p": 1}, {"s": 29.69, "e": 31.21, "t": "Olur mu?", "p": 1}, {"s": 31.69, "e": 33.03, "t": "Arkadaşlar.", "p": 1}, {"s": 37.36, "e": 39.6, "t": "bunda şey yok", "p": 1}, {"s": 39.6, "e": 41.48, "t": "onda var bunda yok", "p": 1}]}