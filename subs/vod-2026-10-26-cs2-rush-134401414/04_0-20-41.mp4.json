{"speakers": 1, "cues": [{"s": 1.04, "e": 2.28, "t": "Kim ne yiyor ne", "p": 0}, {"s": 2.28, "e": 3.66, "t": "ne ne yapıyor?", "p": 0}, {"s": 4.72, "e": 5.78, "t": "Biri bir şey yapıyor", "p": 0}, {"s": 5.78, "e": 6.38, "t": "anladım.", "p": 0}, {"s": 6.38, "e": 7.54, "t": "Biri evet.", "p": 0}, {"s": 7.82, "e": 9.5, "t": "Ben değilim de o.", "p": 0}, {"s": 9.5, "e": 10.94, "t": "Bence faysal.", "p": 0}, {"s": 10.94, "e": 13.3, "t": "Aaa çekirdeek.", "p": 0}, {"s": 14.7, "e": 16.28, "t": "Çekirdeek dur.", "p": 0}, {"s": 16.4, "e": 17.18, "t": "Yok sal.", "p": 0}, {"s": 17.18, "e": 18.46, "t": "Hayır benim aklıma", "p": 0}, {"s": 18.46, "e": 19.8, "t": "çekirdek hala almadığım", "p": 0}, {"s": 19.8, "e": 20.3, "t": "geldi.", "p": 0}, {"s": 20.3, "e": 21.0, "t": "Ve benim canım çok", "p": 0}, {"s": 21.0, "e": 22.56, "t": "çekirdek çekiyor.", "p": 0}, {"s": 25.12, "e": 25.9, "t": "Tamam.", "p": 0}, {"s": 26.1, "e": 27.52, "t": "Ya aklıma gidiyor.", "p": 0}, {"s": 28.9, "e": 30.62, "t": "Be olabilir mi ya?", "p": 0}, {"s": 30.62, "e": 32.0, "t": "Ne yapıyor ya?", "p": 0}]}