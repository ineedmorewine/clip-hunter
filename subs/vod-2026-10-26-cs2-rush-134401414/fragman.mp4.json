{"speakers": 1, "cues": [{"s": 1.87, "e": 3.59, "t": "Bak Faysal elimde enayi", "p": 0}, {"s": 3.59, "e": 4.13, "t": "malı var bir tane", "p": 0}, {"s": 4.13, "e": 5.69, "t": "bak enayi enayi tilağı", "p": 0}, {"s": 5.81, "e": 7.65, "t": "Evet evet senin başını", "p": 0}, {"s": 7.65, "e": 7.97, "t": "söylüyorum", "p": 0}, {"s": 7.97, "e": 8.51, "t": "Yani enayi alma", "p": 0}, {"s": 8.51, "e": 10.51, "t": "Ah canav canav", "p": 0}, {"s": 10.51, "e": 12.09, "t": "B boş diyorum.", "p": 0}, {"s": 12.97, "e": 14.29, "t": "Mal gibi girmezsen", "p": 0}, {"s": 14.29, "e": 15.18, "t": "ölmezsin.", "p": 0}, {"s": 15.51, "e": 16.77, "t": "Eee ne olmuş yani?", "p": 0}, {"s": 16.77, "e": 18.05, "t": "B boşsa ne olmuş?", "p": 0}, {"s": 18.75, "e": 20.03, "t": "Öyle sonra mal gibi", "p": 0}, {"s": 20.03, "e": 20.35, "t": "öldün", "p": 0}, {"s": 20.35, "e": 21.77, "t": "AVP 'ni kaybettin yani.", "p": 0}, {"s": 21.77, "e": 23.03, "t": "Eee yani öldüğümde olur.", "p": 0}, {"s": 23.37, "e": 25.59, "t": "Sen kimin kızısın Faysal?", "p": 0}, {"s": 25.59, "e": 26.69, "t": "Açıkla.", "p": 0}, {"s": 30.49, "e": 32.17, "t": "Açıkla.", "p": 0}, {"s": 32.31, "e": 34.35, "t": "Ben vejeteryanım.", "p": 0}, {"s": 34.75, "e": 35.53, "t": "Vejeteryan", "p": 0}, {"s": 35.8, "e": 38.84, "t": "Radyo terapiye karşı", "p": 0}, {"s": 38.84, "e": 40.52, "t": "savaşmak isterdim çünkü", "p": 0}, {"s": 40.52, "e": 42.58, "t": "ben kanserim, tedavim de", "p": 0}, {"s": 42.58, "e": 44.26, "t": "beni kanser ediyor.", "p": 0}, {"s": 44.38, "e": 46.66, "t": "Hani Faysal gibi.", "p": 0}, {"s": 48.14, "e": 49.58, "t": "Ben vejeteryan", "p": 0}, {"s": 49.58, "e": 51.08, "t": "geniteriyim.", "p": 0}, {"s": 51.93, "e": 53.78, "t": "Abi öyle olmaz mı?", "p": 0}, {"s": 53.88, "e": 55.12, "t": "Puanlanmamış konuyu.", "p": 0}, {"s": 55.12, "e": 56.3, "t": "Komünist bu ya.", "p": 0}, {"s": 60.33, "e": 61.47, "t": "Öncelikle kanalınızı hoş", "p": 0}, {"s": 61.47, "e": 62.51, "t": "geldiniz", "p": 0}, {"s": 62.81, "e": 64.29, "t": "Yekta 'yı rehin aldım", "p": 0}, {"s": 64.29, "e": 64.99, "t": "demiş", "p": 0}, {"s": 66.04, "e": 66.84, "t": "veririz", "p": 0}, {"s": 70.78, "e": 72.81, "t": "dangalak Faysal öyle", "p": 0}, {"s": 72.81, "e": 74.1, "t": "dümdüz koşma içeri", "p": 0}, {"s": 74.1, "e": 76.6, "t": "Faysal'da bu kadar", "p": 0}, {"s": 76.6, "e": 77.55, "t": "saldırma", "p": 0}, {"s": 77.55, "e": 80.49, "t": "Ya Faysal oyunu kazanman", "p": 0}, {"s": 80.49, "e": 81.89, "t": "önemli burada beni vurman", "p": 0}, {"s": 81.89, "e": 83.91, "t": "değil benim seni vurmam", "p": 0}, {"s": 83.91, "e": 84.85, "t": "yeterli", "p": 0}, {"s": 86.19, "e": 87.59, "t": "Sağol ben", "p": 0}]}