{"speakers": 1, "cues": [{"s": 0.0, "e": 1.5, "t": "Ben arkayı açtırdım şu", "p": 0}, {"s": 1.5, "e": 3.16, "t": "an ama, hayır yayınımıza", "p": 0}, {"s": 3.16, "e": 3.86, "t": "demiyor mu?", "p": 0}, {"s": 3.86, "e": 5.48, "t": "Kamyonumuza mı dedi?", "p": 0}, {"s": 6.08, "e": 7.86, "t": "Valla, vaysal o,", "p": 0}, {"s": 7.86, "e": 9.04, "t": "kamyonumuza hoş geldiniz", "p": 0}, {"s": 9.04, "e": 10.12, "t": "de diyebilirim yani.", "p": 0}, {"s": 10.12, "e": 11.36, "t": "Benim daha güzel bir", "p": 0}, {"s": 11.36, "e": 12.82, "t": "mikrofon almam da sağ", "p": 0}, {"s": 12.82, "e": 13.58, "t": "ol.", "p": 0}, {"s": 14.8, "e": 15.96, "t": "Öncelikle kanalımıza hoş", "p": 0}, {"s": 15.96, "e": 16.96, "t": "geldiniz.", "p": 0}, {"s": 17.42, "e": 18.74, "t": "Yekta 'yı rehin aldım", "p": 0}, {"s": 18.74, "e": 19.64, "t": "demiş.", "p": 0}, {"s": 20.28, "e": 21.64, "t": "Yekta 'nın kız arkadaşı", "p": 0}, {"s": 21.64, "e": 22.52, "t": "geldi.", "p": 0}, {"s": 23.12, "e": 24.3, "t": "Ben yanlış şunu", "p": 0}, {"s": 24.3, "e": 25.5, "t": "hatırlıyorum.", "p": 0}, {"s": 27.35, "e": 28.73, "t": "Hoş geldiniz.", "p": 0}, {"s": 36.2, "e": 37.74, "t": "Dungalak Faysal öyle", "p": 0}, {"s": 37.74, "e": 39.66, "t": "dümdüz koşma içeri", "p": 0}, {"s": 40.32, "e": 41.56, "t": "Faysal'da bu kadar", "p": 0}, {"s": 41.56, "e": 43.2, "t": "saldırma sende", "p": 0}, {"s": 43.26, "e": 44.46, "t": "Faysal benim takım", "p": 0}, {"s": 44.46, "e": 45.44, "t": "arkadaşım şu anda ona", "p": 0}, {"s": 45.44, "e": 46.26, "t": "göre", "p": 0}, {"s": 54.59, "e": 56.19, "t": "Yağımız hoş geldiniz", "p": 0}, {"s": 56.19, "e": 57.89, "t": "Eşek", "p": 0}, {"s": 57.89, "e": 59.87, "t": "Moderatör gibi", "p": 0}, {"s": 59.87, "e": 62.99, "t": "İyi güzel güzel", "p": 0}, {"s": 62.99, "e": 64.61, "t": "Bu işe yaraması da", "p": 0}, {"s": 64.61, "e": 67.31, "t": "güzel", "p": 0}, {"s": 67.31, "e": 67.47, "t": "Ne?", "p": 0}, {"s": 67.47, "e": 68.35, "t": "Ne?", "p": 0}, {"s": 69.11, "e": 69.73, "t":