{"speakers": 1, "cues": [{"s": 0.0, "e": 1.08, "t": "Bitti mi ya?", "p": 0}, {"s": 4.04, "e": 5.36, "t": "Ne?", "p": 0}, {"s": 13.64, "e": 17.22, "t": "Salak yaa, mallısın yaa.", "p": 0}, {"s": 17.66, "e": 18.66, "t": "Oğlum ben değil salak", "p": 0}, {"s": 18.66, "e": 19.74, "t": "paparası kaybettim.", "p": 0}, {"s": 20.72, "e": 21.72, "t": "Ne?", "p": 0}, {"s": 35.09, "e": 35.95, "t": "Ben yirmi saat sonra", "p": 0}, {"s": 35.95, "e": 36.89, "t": "gelirim.", "p": 0}, {"s": 37.05, "e": 38.45, "t": "İyi, tamam.", "p": 0}, {"s": 38.73, "e": 39.47, "t": "Bir daha canlıyorum, bir", "p": 0}, {"s": 39.47, "e": 40.41, "t": "daha kafasını sıkacağım.", "p": 0}, {"s": 40.41, "e": 40.69, "t": "Hayır, bir daha kafasını", "p": 0}, {"s": 40.69, "e": 41.85, "t": "sıkacağım ya.", "p": 0}, {"s": 42.33, "e": 43.63, "t": "Musa 'yı bir arasak", "p": 0}, {"s": 43.63, "e": 44.41, "t": "mı?", "p": 0}, {"s": 44.95, "e": 46.11, "t": "Musa 'yı.", "p": 0}, {"s": 46.11, "e": 47.19, "t": "Göt göt.", "p": 0}]}