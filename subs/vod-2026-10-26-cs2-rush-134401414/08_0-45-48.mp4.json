{"speakers": 1, "cues": [{"s": 0.88, "e": 3.88, "t": "Genital mi sizde Faysal?", "p": 0}, {"s": 5.01, "e": 7.15, "t": "Ben kaçtan gidebilirim", "p": 0}, {"s": 10.57, "e": 11.39, "t": "He?", "p": 0}, {"s": 11.73, "e": 13.25, "t": "He?", "p": 0}, {"s": 17.3, "e": 19.46, "t": "Diyorum genital mi sizde?", "p": 0}, {"s": 19.46, "e": 21.0, "t": "Genital", "p": 0}, {"s": 21.28, "e": 22.38, "t": "E", "p": 0}, {"s": 23.25, "e": 25.01, "t": "hani vejeteryanlı?", "p": 0}, {"s": 25.15, "e": 26.91, "t": "E harbiden sen", "p": 0}, {"s": 26.91, "e": 28.85, "t": "vejeteryanlı mı Faysal?", "p": 0}, {"s": 28.95, "e": 30.85, "t": "Ben vejeteryan", "p": 0}, {"s": 30.85, "e": 31.95, "t": "genitalıyım", "p": 0}, {"s": 32.61, "e": 34.93, "t": "Abi öyle olmaz mı?", "p": 0}, {"s": 34.93, "e": 36.39, "t": "Bu anlamamış konuyu.", "p": 0}, {"s": 36.39, "e": 37.79, "t": "Komünist bu ya.", "p": 0}, {"s": 43.39, "e": 45.05, "t": "Aysal sende zerdüşlük de", "p": 0}, {"s": 45.05, "e": 46.07, "t": "var ama biraz.", "p": 0}]}