{"speakers": 1, "cues": [{"s": 0.53, "e": 2.17, "t": "Girmeye çalışıyorum.", "p": 0}, {"s": 2.17, "e": 3.77, "t": "Faysal diyorum ki", "p": 0}, {"s": 6.71, "e": 7.87, "t": "Öldü de sen karı", "p": 0}, {"s": 7.87, "e": 8.29, "t": "değil.", "p": 0}, {"s": 8.29, "e": 9.43, "t": "Önümden...", "p": 0}, {"s": 11.62, "e": 13.04, "t": "Mal Faysal ben sana", "p": 0}, {"s": 13.04, "e": 13.38, "t": "diyorum ki", "p": 0}, {"s": 13.38, "e": 14.7, "t": "B boş diyorum.", "p": 0}, {"s": 15.6, "e": 16.88, "t": "Mal gibi girmezsen", "p": 0}, {"s": 16.88, "e": 18.16, "t": "ölmezsin.", "p": 0}, {"s": 18.16, "e": 19.34, "t": "Eee ne olmuş yani?", "p": 0}, {"s": 19.34, "e": 20.62, "t": "B boşsa ne olmuş?", "p": 0}, {"s": 21.42, "e": 22.62, "t": "Öyle sonra mal gibi", "p": 0}, {"s": 22.62, "e": 23.96, "t": "öldün avp 'ni kaydettin", "p": 0}, {"s": 23.96, "e": 24.4, "t": "yani.", "p": 0}, {"s": 24.4, "e": 25.36, "t": "Eee ne yani öldü", "p": 0}, {"s": 25.36, "e": 26.32, "t": "mü oldun?", "p": 0}, {"s": 27.1, "e": 28.04, "t": "Nereli?", "p": 0}, {"s": 29.02, "e": 30.64, "t": "Lan Faysal.", "p": 0}, {"s": 31.32, "e": 32.9, "t": "Karda adam sıkıyor,", "p": 0}, {"s": 32.9, "e": 33.74, "t": "ölüyorum diyor ki karda", "p": 0}, {"s": 33.74, "e": 34.9, "t": "adam var diyor.", "p": 0}, {"s": 36.18, "e": 37.32, "t": "Ölmeden ölü söylemen", "p": 0}, {"s": 37.32, "e": 38.54, "t": "lazım adamı.", "p": 0}, {"s": 39.16, "e": 40.24, "t": "Boy.", "p": 0}]}