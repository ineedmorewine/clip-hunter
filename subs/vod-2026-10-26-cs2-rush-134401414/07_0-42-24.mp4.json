{"speakers": 1, "cues": [{"s": 1.71, "e": 4.15, "t": "Faysal, Musa, bir", "p": 0}, {"s": 4.15, "e": 5.53, "t": "hastalık türü olacak", "p": 0}, {"s": 5.53, "e": 8.41, "t": "olsanız hangi tedaviye", "p": 0}, {"s": 8.41, "e": 9.29, "t": "karşı savaşmak", "p": 0}, {"s": 9.29, "e": 10.47, "t": "isterdiniz?", "p": 0}, {"s": 13.13, "e": 14.71, "t": "Hastalık olacağım,", "p": 0}, {"s": 14.71, "e": 15.61, "t": "tedaviye karşı", "p": 0}, {"s": 15.61, "e": 17.23, "t": "savaşacağım öyle mi?", "p": 0}, {"s": 18.37, "e": 19.45, "t": "Evet.", "p": 0}, {"s": 24.46, "e": 25.96, "t": "Koronavirüs oldu.", "p": 0}, {"s": 26.14, "e": 27.4, "t": "Radyoterapiye karşı", "p": 0}, {"s": 27.4, "e": 28.98, "t": "savaşmak isterdim.", "p": 0}, {"s": 28.98, "e": 30.22, "t": "Çünkü ben kanserim,", "p": 0}, {"s": 30.22, "e": 31.94, "t": "tedavim de beni kanser", "p": 0}, {"s": 31.94, "e": 32.84, "t": "ediyor.", "p": 0}, {"s": 33.2, "e": 35.44, "t": "Vay be Faysal gibi.", "p": 0}, {"s": 36.93, "e": 38.39, "t": "Ben koronavirüs olurum,", "p": 0}, {"s": 38.39, "e": 39.19, "t": "bütün dünyanın başından", "p": 0}, {"s": 39.19, "e": 39.99, "t": "bela olmanı derdine", "p": 0}, {"s": 39.99, "e": 40.47, "t": "çabalarım.", "p": 0}, {"s": 40.47, "e": 42.53, "t": "Savaşır, bu savaşı", "p": 0}, {"s": 42.53, "e": 43.07, "t": "kazanır.", "p": 0}, {"s": 43.07, "e": 44.63, "t": "Bak zeka seviyesinin", "p": 0}, {"s": 44.63, "e": 45.33, "t": "farkında mı?", "p": 0}, {"s": 45.33, "e": 47.19, "t": "Soruyu anlayamadı daha.", "p": 0}, {"s": 48.29, "e": 49.57, "t": "Ben bu sorunun daha", "p": 0}, {"s": 49.57, "e": 50.83, "t": "güzelini sor ona.", "p": 0}]}