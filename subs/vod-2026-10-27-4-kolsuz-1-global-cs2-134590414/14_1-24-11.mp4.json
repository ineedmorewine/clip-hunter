{"speakers": 2, "cues": [{"s": 1.68, "e": 3.26, "t": "Keskin nişancı oldum bak.", "p": 0}, {"s": 3.26, "e": 4.42, "t": "Otoyla birlikte.", "p": 0}, {"s": 4.64, "e": 5.94, "t": "Bak adam sana ne", "p": 0}, {"s": 5.94, "e": 6.88, "t": "yazdı?", "p": 0}, {"s": 7.0, "e": 7.92, "t": "Ne yazdı?", "p": 0}, {"s": 7.92, "e": 8.42, "t": "Evet Faysal.", "p": 0}, {"s": 8.42, "e": 9.18, "t": "Gelen geçen sonuna", "p": 0}, {"s": 9.18, "e": 10.36, "t": "geçiriyor ya.", "p": 0}, {"s": 11.38, "e": 13.18, "t": "Hiç de çok arsız", "p": 0}, {"s": 13.18, "e": 14.52, "t": "bir adamsın sen Faysal.", "p": 0}, {"s": 14.52, "e": 16.08, "t": "Abi aldım mı aldım?", "p": 0}, {"s": 16.08, "e": 16.78, "t": "Hiç utanmıyor.", "p": 0}, {"s": 16.78, "e": 17.94, "t": "Bu adama yak mı?", "p": 0}, {"s": 17.94, "e": 20.12, "t": "Ama ne pahasını aldın?", "p": 0}, {"s": 20.28, "e": 21.76, "t": "Onur 'un gururun kaldı", "p": 0}, {"s": 21.76, "e": 22.46, "t": "mı?", "p": 0}, {"s": 23.06, "e": 24.7, "t": "Abi aldık aldık.", "p": 0}, {"s": 24.7, "e": 25.72, "t": "5 para etti Onur", "p": 0}, {"s": 25.72, "e": 26.44, "t": "'un.", "p": 0}, {"s": 26.8, "e": 28.2, "t": "Sonuç olarak kazandık mı", "p": 0}, {"s": 28.2, "e": 28.62, "t": "kazandık?", "p": 0}, {"s": 28.62, "e": 29.64, "t": "Yani birisi bana bu", "p": 0}, {"s": 29.64, "e": 30.8, "t": "kadar laf etse yüzüm", "p": 0}, {"s": 30.8, "e": 32.12, "t": "kızarır.", "p": 0}, {"s": 32.12, "e": 33.02, "t": "Savaşlar şey bir", "p": 0}, {"s": 33.02, "e": 34.12, "t": "muhteşem.", "p": 0}, {"s": 37.1, "e": 38.42, "t": "Faysal bana 16 kere", "p": 0}, {"s": 38.42, "e": 40.44, "t": "davet atmış Mursa.", "p": 0}, {"s": 40.44, "e": 42.5, "t": "Ya verenlik ya.", "p": 0}, {"s": 43.22, "e": 44.92, "t": "Oyunda 3 kere mi,", "p": 1}, {"s": 44.92, "e": 45.58, "t": "2 kere mi ne", "p": 1}, {"s": 45.58, "e": 46.42, "t": "aradı beni bir de", "p": 0}, {"s": 46.42, "e": 47.64, "t": "Steam Deck fanlıyor bu", "p": 0}, {"s": 47.64, "e": 48.5, "t": "oyuna.", "p": 0}, {"s": 48.56, "e": 49.86, "t": "Engelledim ama Faysal 'ı.", "p": 0}, {"s": 49.86, "e": 51.66, "t": "Bir süre engelle tuttum.", "p": 0}, {"s": 52.8, "e": 54.0, "t": "Nasıl en zivizim yaşıyor", "p": 0}, {"s": 54.0, "e": 54.7, "t": "herhalde.", "p": 0}]}