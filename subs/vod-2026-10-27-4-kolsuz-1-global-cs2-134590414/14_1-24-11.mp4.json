{"speakers": 1, "cues": [{"s": 1.64, "e": 3.08, "t": "Keskin nişancı oldum bak", "p": 0}, {"s": 3.08, "e": 4.44, "t": "otoyla birlikte.", "p": 0}, {"s": 4.56, "e": 5.96, "t": "Bak adam sana ne", "p": 0}, {"s": 5.96, "e": 6.9, "t": "yazdı?", "p": 0}, {"s": 7.0, "e": 7.9, "t": "Ne yazdı?", "p": 0}, {"s": 7.9, "e": 8.74, "t": "Evet Faysal, gelenge", "p": 0}, {"s": 8.74, "e": 10.38, "t": "şansına geçiriyor ya.", "p": 0}, {"s": 11.64, "e": 12.74, "t": "Hiç de arsız, çok", "p": 0}, {"s": 12.74, "e": 13.98, "t": "arsız bir adamsın sen", "p": 0}, {"s": 13.98, "e": 14.54, "t": "Faysal.", "p": 0}, {"s": 14.54, "e": 16.1, "t": "Abi aldım mı aldım?", "p": 0}, {"s": 16.1, "e": 18.08, "t": "Bu adama yak mı?", "p": 0}, {"s": 18.18, "e": 20.12, "t": "Ama ne pahasını aldın?", "p": 0}, {"s": 20.24, "e": 21.76, "t": "Onur 'un gururun kaldı", "p": 0}, {"s": 21.76, "e": 22.44, "t": "mı?", "p": 0}, {"s": 23.28, "e": 24.3, "t": "Abi aldık aldık.", "p": 0}, {"s": 24.3, "e": 25.72, "t": "5 para etti Onur", "p": 0}, {"s": 25.72, "e": 26.44, "t": "'un.", "p": 0}, {"s": 26.76, "e": 28.2, "t": "Sonuç olarak kazandık mı", "p": 0}, {"s": 28.2, "e": 28.62, "t": "kazandık?", "p": 0}, {"s": 28.62, "e": 29.64, "t": "Yani birisi bana bu", "p": 0}, {"s": 29.64, "e": 30.8, "t": "kadar laf etse yüzüm", "p": 0}, {"s": 30.8, "e": 32.0, "t": "kızarır.", "p": 0}, {"s": 32.1, "e": 33.08, "t": "Savaşlar şehrin bir", "p": 0}, {"s": 33.08, "e": 34.12, "t": "muhteşem.", "p": 0}, {"s": 37.08, "e": 38.42, "t": "Faysal bana 16 kere", "p": 0}, {"s": 38.42, "e": 40.04, "t": "davet atmış Mursa.", "p": 0}, {"s": 40.44, "e": 42.5, "t": "Ya verenlik ya.", "p": 0}, {"s": 43.4, "e": 44.84, "t": "Oyundayız 3 kere mi", "p": 0}, {"s": 44.84, "e": 45.58, "t": "2 kere mi ne", "p": 0}, {"s": 45.58, "e": 46.46, "t": "aradı beni bir de", "p": 0}, {"s": 46.46, "e": 47.66, "t": "Steam Jam spamlıyor bu", "p": 0}, {"s": 47.66, "e": 48.48, "t": "oyunu.", "p": 0}, {"s": 48.52, "e": 49.78, "t": "Engelledim ama Faysal 'ı", "p": 0}, {"s": 49.78, "e": 50.62, "t": "bir süre engelle", "p": 0}, {"s": 50.62, "e": 51.64, "t": "tutacağım.", "p": 0}, {"s": 52.86, "e": 53.7, "t": "O senin zirci bir", "p": 0}, {"s": 53.7, "e": 54.86, "t": "yaşıyor herhalde.", "p": 0}]}