{"speakers": 1, "cues": [{"s": 0.59, "e": 1.63, "t": "Hadi go go.", "p": 0}, {"s": 1.63, "e": 3.31, "t": "Yektar gelmiş lan.", "p": 0}, {"s": 3.61, "e": 6.09, "t": "He ben geldim.", "p": 0}, {"s": 6.21, "e": 7.35, "t": "Yektar geldi.", "p": 0}, {"s": 7.35, "e": 8.73, "t": "Yektar gelmiş.", "p": 0}, {"s": 9.23, "e": 10.59, "t": "Yektar gelmiş.", "p": 0}, {"s": 10.59, "e": 12.09, "t": "Faysal beni bir sinir", "p": 0}, {"s": 12.09, "e": 13.25, "t": "etti, bir sinir etti.", "p": 0}, {"s": 13.25, "e": 14.51, "t": "Yanımda olsa ensesine bir", "p": 0}, {"s": 14.51, "e": 16.19, "t": "tane tokat çakacaktım.", "p": 0}, {"s": 16.19, "e": 17.21, "t": "Sadece bir tane tokat", "p": 0}, {"s": 17.21, "e": 18.15, "t": "çakacaktım.", "p": 0}, {"s": 18.15, "e": 19.67, "t": "Bir tane tokat atacağım.", "p": 0}, {"s": 19.81, "e": 21.31, "t": "Biraz az değil mi?", "p": 0}, {"s": 21.31, "e": 23.05, "t": "Dövemem be yani, kıyamam", "p": 0}, {"s": 23.05, "e": 23.75, "t": "ki.", "p": 0}, {"s": 23.75, "e": 25.71, "t": "Haydi haydi haydi haydi.", "p": 0}, {"s": 26.39, "e": 27.37, "t": "Öyle bir döve.", "p": 0}, {"s": 27.37, "e": 28.53, "t": "Yektay...", "p": 0}, {"s": 28.59, "e": 30.33, "t": "Yektay dayısını yaptım.", "p": 0}, {"s": 30.67, "e": 32.71, "t": "50 tane davet attım,", "p": 0}, {"s": 32.71, "e": 33.63, "t": "50 tane davet attım", "p": 0}, {"s": 33.63, "e": 34.13, "t": "sana da.", "p": 0}, {"s": 34.13, "e": 35.81, "t": "He ben hiç umursadım", "p": 0}, {"s": 35.81, "e": 36.17, "t": "mı?", "p": 0}, {"s": 36.17, "e": 37.49, "t": "Böyle şey gibi.", "p": 0}, {"s": 37.49, "e": 38.77, "t": "Hiç umursadım mı peki?", "p": 0}, {"s": 38.77, "e": 39.39, "t": "Belki çantanız altına", "p": 0}, {"s": 39.39, "e": 40.83, "t": "çıkacaksınız diyor.", "p": 0}, {"s": 41.05, "e": 42.47, "t": "Evet evet.", "p": 0}, {"s": 42.67, "e": 43.67, "t": "Polis eşkeniz ediyor", "p": 0}, {"s": 43.67, "e": 44.29, "t": "adamım.", "p": 0}, {"s": 44.29, "e": 45.05, "t": "Hıı.", "p": 0}, {"s": 45.63, "e": 46.39, "t": "Evet arkadaşlar", "p": 0}, {"s": 46.39, "e": 47.31, "t": "kanalımıza hoş geldiniz.", "p": 0}, {"s": 47.31, "e": 48.45, "t": "Bir dahaki kanal", "p": 0}, {"s": 48.45, "e": 49.43, "t": "gelmemizde beni", "p": 0}, {"s": 49.43, "e": 50.09, "t": "dövecekler.", "p": 0}, {"s": 50.09, "e": 51.09, "t": "Kanalımız değil, sen niye", "p": 0}, {"s": 51.09, "e": 52.07, "t": "kendiniz şimdi benimsiniz", "p": 0}, {"s": 52.07, "e": 52.97, "t": "ya?", "p": 0}, {"s": 53.49, "e": 54.73, "t": "O sonuçta beni", "p": 0}, {"s": 54.73, "e": 55.83, "t": "izliyorlar.", "p": 0}, {"s": 56.35, "e": 57.65, "t": "Bak", "p": 0}, {"s": 60.8, "e": 61.8, "t": "fark ettiysen bir tek", "p": 0}, {"s": 61.8, "e": 63.12, "t": "sen gülüyorsun Faysal.", "p": 0}, {"s": 63.12, "e": 64.14, "t": "Evet.", "p": 0}, {"s": 64.14, "e": 65.24, "t": "Yeterli.", "p": 0}]}