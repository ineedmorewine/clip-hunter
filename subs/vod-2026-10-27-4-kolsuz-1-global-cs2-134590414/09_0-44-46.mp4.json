{"speakers": 1, "cues": [{"s": 0.59, "e": 1.63, "t": "Hadi go go.", "p": 0}, {"s": 1.63, "e": 3.31, "t": "Yektar gelmiş lan.", "p": 0}, {"s": 3.61, "e": 6.09, "t": "He ben geldim.", "p": 0}, {"s": 6.27, "e": 7.35, "t": "Yektar geldi.", "p": 0}, {"s": 7.35, "e": 8.73, "t": "Yektar gelmiş.", "p": 0}, {"s": 9.27, "e": 10.65, "t": "Yektar gelmiş.", "p": 0}, {"s": 10.65, "e": 12.11, "t": "Faysal beni bir sinir", "p": 0}, {"s": 12.11, "e": 13.25, "t": "etti, bir sinir etti.", "p": 0}, {"s": 13.25, "e": 14.51, "t": "Yanımda olsa ensesine bir", "p": 0}, {"s": 14.51, "e": 16.11, "t": "tane tokat çakacaktı.", "p": 0}, {"s": 16.11, "e": 17.21, "t": "Sadece bir tane tokat", "p": 0}, {"s": 17.21, "e": 18.15, "t": "çakacaktı.", "p": 0}, {"s": 18.15, "e": 19.67, "t": "Bir tane tokat atacağım.", "p": 0}, {"s": 19.81, "e": 21.09, "t": "Biraz az değil mi?", "p": 0}, {"s": 21.09, "e": 21.65, "t": "Dövemem.", "p": 0}, {"s": 21.65, "e": 22.49, "t": "Dövemem de yani.", "p": 0}, {"s": 22.49, "e": 23.73, "t": "Kıyamam ki.", "p": 0}, {"s": 23.73, "e": 25.79, "t": "Haydi haydi haydi haydi.", "p": 0}, {"s": 26.43, "e": 27.39, "t": "Öyle bir döve.", "p": 0}, {"s": 27.39, "e": 28.55, "t": "Yektar...", "p": 0}, {"s": 28.55, "e": 29.73, "t": "Yektar da açısını yaptım", "p": 0}, {"s": 29.73, "e": 30.59, "t": "o sayı.", "p": 0}, {"s": 30.59, "e": 32.67, "t": "50 tane davet attım", "p": 0}, {"s": 32.67, "e": 34.59, "t": "sana da", "p": 0}, {"s": 34.59, "e": 36.15, "t": "Bence hiç umursadın mı?", "p": 0}, {"s": 36.15, "e": 37.47, "t": "Böyle şey gibi", "p": 0}, {"s": 37.47, "e": 39.21, "t": "Hiç umursadın mı peki?", "p": 0}, {"s": 40.87, "e": 42.11, "t": "Evet arkadaşlar", "p": 0}, {"s": 42.11, "e": 47.19, "t": "kanalımıza hoşgeldiniz", "p": 0}, {"s": 47.19, "e": 48.47, "t": "bir dahaki kanal", "p": 0}, {"s": 48.47, "e": 49.43, "t": "gelmemizde beni", "p": 0}, {"s": 49.43, "e": 50.03, "t": "dövecekler", "p": 0}, {"s": 50.03, "e": 51.11, "t": "Sanalımız değil sen niye", "p": 0}, {"s": 51.11, "e": 52.09, "t": "kendiniz şimdi benimsiniz", "p": 0}, {"s": 52.09, "e": 53.01, "t": "ya?", "p": 0}, {"s": 53.79, "e": 55.79, "t": "Sonuçta beni izliyorlar", "p": 0}, {"s": 56.31, "e": 57.63, "t": "Bak", "p": 0}, {"s": 60.78, "e": 61.8, "t": "fark ettiksen bir tek", "p": 0}, {"s": 61.8, "e": 62.76, "t": "sen gülüyorsun Faysal", "p": 0}, {"s": 62.76, "e": 64.0, "t": "Evet.", "p": 0}, {"s": 64.0, "e": 65.24, "t": "Yeterli.", "p": 0}]}