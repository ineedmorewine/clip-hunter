{"speakers": 1, "cues": [{"s": 0.05, "e": 1.59, "t": "Merhabalar, hoşgeldiniz", "p": 0}, {"s": 1.59, "e": 2.39, "t": "efendim.", "p": 0}, {"s": 2.39, "e": 4.53, "t": "Bana flash atın.", "p": 0}, {"s": 6.65, "e": 8.05, "t": "Neredesin?", "p": 0}, {"s": 8.65, "e": 9.75, "t": "Neredesin?", "p": 0}, {"s": 10.69, "e": 11.83, "t": "Atıyorum.", "p": 0}, {"s": 12.67, "e": 13.39, "t": "Go!", "p": 0}, {"s": 13.71, "e": 15.17, "t": "Attım, flash 'e sokayım", "p": 0}, {"s": 15.17, "e": 15.77, "t": "ya.", "p": 0}, {"s": 15.77, "e": 17.03, "t": "Çok uzaktan attım.", "p": 0}, {"s": 17.03, "e": 18.21, "t": "Adamlar, adam...", "p": 0}, {"s": 18.21, "e": 20.93, "t": "Bizi körettin.", "p": 0}, {"s": 22.13, "e": 24.63, "t": "Evet, bizi körettin.", "p": 0}, {"s": 24.63, "e": 26.41, "t": "Arkadan gel.", "p": 0}, {"s": 27.81, "e": 29.51, "t": "Yerde şey var.", "p": 0}, {"s": 29.57, "e": 31.13, "t": "Benim yerde...", "p": 0}, {"s": 31.65, "e": 33.47, "t": "O değil diyelim.", "p": 0}, {"s": 36.24, "e": 37.78, "t": "Ne var", "p": 0}, {"s": 38.74, "e": 39.92, "t": "ya?", "p": 0}, {"s": 40.44, "e": 41.58, "t": "Bir şey söyleyebilir", "p": 0}, {"s": 41.58, "e": 42.42, "t": "miyim bize?", "p": 0}, {"s": 42.42, "e": 43.18, "t": "Bir şey söyleyebilir", "p": 0}, {"s": 43.18, "e": 43.86, "t": "miyim?", "p": 0}, {"s": 43.86, "e": 44.8, "t": "Efendim.", "p": 0}, {"s": 44.8, "e": 46.0, "t": "Bakın şimdi.", "p": 0}, {"s": 46.0, "e": 47.38, "t": "Aa adam döndü gördünüz", "p": 0}, {"s": 47.38, "e": 47.84, "t": "mü?", "p": 0}, {"s": 47.84, "e": 48.68, "t": "Hileni.", "p": 0}, {"s": 48.68, "e": 49.96, "t": "Hileni.", "p": 0}, {"s": 52.22, "e": 53.3, "t": "Kim hileni?", "p": 0}, {"s": 53.3, "e": 54.78, "t": "En son beni vuran", "p": 0}, {"s": 54.78, "e": 57.2, "t": "adam Mevlana hilesi gibi", "p": 0}, {"s": 57.2, "e": 57.78, "t": "dönüyordu.", "p": 0}, {"s": 57.78, "e": 58.54, "t": "Mevlana hilesi değil", "p": 0}, {"s": 58.54, "e": 58.94, "t": "gerçi.", "p": 0}, {"s": 58.94, "e": 60.46, "t": "Ona bizim Mevlana 'yı.", "p": 0}, {"s": 61.1, "e": 62.48, "t": "Mevlana dönüyor.", "p": 0}, {"s": 62.48, "e": 63.76, "t": "Ben yorum yapmıyorum", "p": 0}, {"s": 63.76, "e": 65.0, "t": "gerçekten ya.", "p": 0}, {"s": 65.0, "e": 66.38, "t": "Sen şimdi muhtar yapma.", "p": 0}]}