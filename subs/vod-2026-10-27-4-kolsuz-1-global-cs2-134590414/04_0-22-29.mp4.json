{"speakers": 2, "cues": [{"s": 0.02, "e": 1.6, "t": "Merhabalar, hoşgeldiniz", "p": 1}, {"s": 1.6, "e": 2.46, "t": "efendim.", "p": 1}, {"s": 2.46, "e": 4.48, "t": "Bana flash atın.", "p": 0}, {"s": 6.72, "e": 8.06, "t": "Neredesin?", "p": 0}, {"s": 8.28, "e": 9.76, "t": "Neredesin?", "p": 1}, {"s": 10.68, "e": 11.82, "t": "Atıyorum.", "p": 1}, {"s": 12.66, "e": 13.38, "t": "Go!", "p": 1}, {"s": 13.38, "e": 15.14, "t": "Attım, flash 'e sokayım", "p": 1}, {"s": 15.14, "e": 15.74, "t": "ya.", "p": 1}, {"s": 15.74, "e": 17.08, "t": "Çok uzaktan attım.", "p": 1}, {"s": 17.08, "e": 18.56, "t": "Adamlar...", "p": 1}, {"s": 19.0, "e": 20.46, "t": "Bizi körettin.", "p": 0}, {"s": 20.46, "e": 21.4, "t": "Lan?", "p": 0}, {"s": 22.14, "e": 24.66, "t": "Evet, bizi körettin.", "p": 1}, {"s": 24.66, "e": 26.5, "t": "Arkadan gelmiş.", "p": 1}, {"s": 27.89, "e": 29.51, "t": "Yerde şey var.", "p": 0}, {"s": 29.57, "e": 31.13, "t": "Benim yerde...", "p": 0}, {"s": 31.47, "e": 33.43, "t": "O değil, yerim.", "p": 0}, {"s": 39.48, "e": 40.28, "t": "YAAA", "p": 1}, {"s": 40.28, "e": 41.84, "t": "Birşey söyleyebilir miyim", "p": 1}, {"s": 41.84, "e": 42.18, "t": "size?", "p": 0}, {"s": 42.18, "e": 43.2, "t": "Birşey söyleyebilir", "p": 0}, {"s": 43.2, "e": 44.14, "t": "miyim?", "p": 0}, {"s": 44.66, "e": 45.76, "t": "Bakın şimdi", "p": 0}, {"s": 45.76, "e": 47.74, "t": "Adam döndü gördünüz mü?", "p": 1}, {"s": 47.74, "e": 49.14, "t": "Hileli", "p": 1}, {"s": 51.69, "e": 53.55, "t": "Kim hileli?", "p": 0}, {"s": 53.57, "e": 54.79, "t": "En son beni vuran", "p": 1}, {"s": 54.79, "e": 57.19, "t": "adam Mevlana hilesi gibi", "p": 1}, {"s": 57.19, "e": 57.65, "t": "dönüyordu", "p": 1}, {"s": 57.65, "e": 58.55, "t": "Mevlana hilesi değil", "p": 1}, {"s": 58.55, "e": 60.63, "t": "Ona bizim Mevlana 'ydı", "p": 1}, {"s": 60.97, "e": 62.15, "t": "Mevlana dönüyor", "p": 0}, {"s": 62.15, "e": 63.75, "t": "Ben yorum yapmıyorum", "p": 0}, {"s": 63.75, "e": 64.71, "t": "gerçekten ya", "p": 0}, {"s": 64.