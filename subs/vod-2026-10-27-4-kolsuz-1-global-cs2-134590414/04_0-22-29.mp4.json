{"speakers": 1, "cues": [{"s": 0.05, "e": 1.59, "t": "Merhabalar, hoşgeldiniz", "p": 0}, {"s": 1.59, "e": 2.63, "t": "efendim.", "p": 0}, {"s": 2.65, "e": 4.53, "t": "Bana flash atın.", "p": 0}, {"s": 6.53, "e": 8.05, "t": "Neredesin?", "p": 0}, {"s": 8.23, "e": 9.75, "t": "Neredesin?", "p": 0}, {"s": 10.69, "e": 11.83, "t": "Atıyorum.", "p": 0}, {"s": 12.67, "e": 13.39, "t": "Go!", "p": 0}, {"s": 13.71, "e": 15.17, "t": "Attım, flash 'e sokayım", "p": 0}, {"s": 15.17, "e": 15.75, "t": "ya.", "p": 0}, {"s": 15.75, "e": 17.03, "t": "Çok uzaktan attım.", "p": 0}, {"s": 17.03, "e": 18.23, "t": "Adamlar, adam...", "p": 0}, {"s": 18.23, "e": 20.55, "t": "Bizi körettin.", "p": 0}, {"s": 20.55, "e": 21.41, "t": "Lan?", "p": 0}, {"s": 22.13, "e": 24.51, "t": "Evet, bizi körettin.", "p": 0}, {"s": 24.63, "e": 26.41, "t": "Arkadan gel.", "p": 0}, {"s": 27.79, "e": 29.51, "t": "Yerde şey var.", "p": 0}, {"s": 29.57, "e": 31.09, "t": "Benim yerde...", "p": 0}, {"s": 31.87, "e": 33.43, "t": "O değil, yerim.", "p": 0}, {"s": 38.9, "e": 40.3, "t": "YAAA", "p": 0}, {"s": 40.42, "e": 41.58, "t": "Bir şey söyleyebilir", "p": 0}, {"s": 41.58, "e": 42.18, "t": "miyim bize?", "p": 0}, {"s": 42.18, "e": 43.2, "t": "Bir şey söyleyebilir", "p": 0}, {"s": 43.2, "e": 44.44, "t": "miyim?", "p": 0}, {"s": 44.66, "e": 45.78, "t": "Bakın şimdi", "p": 0}, {"s": 45.78, "e": 47.38, "t": "Aaaa adam döndü gördünüz", "p": 0}, {"s": 47.38, "e": 48.58, "t": "mü hileli", "p": 0}, {"s": 48.58, "e": 49.3, "t": "Hileli", "p": 0}, {"s": 49.3, "e": 50.84, "t": "Kim", "p": 0}, {"s": 52.52, "e": 53.56, "t": "hileli?", "p": 0}, {"s": 53.56, "e": 54.78, "t": "En son beni vuran", "p": 0}, {"s": 54.78, "e": 55.02, "t": "adam", "p": 0}, {"s": 55.02, "e": 57.2, "t": "Mevlana hilesi gibi", "p": 0}, {"s": 57.2, "e": 57.66, "t": "dönüyordu", "p": 0}, {"s": 57.66, "e": 58.56, "t": "Mevlana hilesi değil", "p": 0}, {"s": 58.56, "e": 59.48, "t": "gerçi", "p": 0}, {"s": 60.98, "e": 62.14, "t": "Mevlana dönüyor", "p": 0}, {"s