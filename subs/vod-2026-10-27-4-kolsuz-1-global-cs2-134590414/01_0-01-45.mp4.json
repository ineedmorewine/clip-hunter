{"speakers": 2, "cues": [{"s": 0.27, "e": 1.21, "t": "Aldım.", "p": 0}, {"s": 1.21, "e": 2.05, "t": "Ne güzel.", "p": 0}, {"s": 2.05, "e": 2.83, "t": "Hadi be.", "p": 0}, {"s": 2.83, "e": 4.31, "t": "Artık ben yiyemiyorum.", "p": 0}, {"s": 4.31, "e": 5.17, "t": "Niye?", "p": 1}, {"s": 5.67, "e": 7.29, "t": "Spora başladı.", "p": 0}, {"s": 8.49, "e": 10.03, "t": "Ye çekirdekli.", "p": 1}, {"s": 10.03, "e": 11.11, "t": "Faysal 'ın spora", "p": 0}, {"s": 11.11, "e": 12.25, "t": "başladıysa Faysal 'la", "p": 0}, {"s": 12.25, "e": 14.09, "t": "birebir atmak istedim ya.", "p": 0}, {"s": 15.78, "e": 17.76, "t": "Ayam nasıl ağrıyor.", "p": 1}, {"s": 18.42, "e": 20.5, "t": "Ah çok yorulmuşum bu.", "p": 1}, {"s": 20.5, "e": 21.56, "t": "Yeçen Musa geldi beni", "p": 0}, {"s": 21.56, "e": 22.84, "t": "baya yoruldum.", "p": 0}, {"s": 28.25, "e": 29.55, "t": "Sporu sürekli yap.", "p": 0}, {"s": 29.55, "e": 31.07, "t": "Haftada 5000 git.", "p": 0}, {"s": 31.77, "e": 32.95, "t": "Haftada 5 değil ya.", "p": 0}, {"s": 32.95, "e": 33.77, "t": "Haftada yükseklerle ben", "p": 0}, {"s": 33.77, "e": 34.49, "t": "gir.", "p": 0}, {"s": 35.59, "e": 37.33, "t": "Ben daha yeni başladım.", "p": 0}, {"s": 39.98, "e": 41.72, "t": "Yaz vuru, iki seneye", "p": 0}, {"s": 41.72, "e": 42.08, "t": "Mr.", "p": 0}, {"s": 42.08, "e": 42.84, "t": "Olympia.", "p": 0}]}