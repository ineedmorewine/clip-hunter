{"speakers": 1, "cues": [{"s": 1.68, "e": 3.64, "t": "Otom anlıyor, hiç bir", "p": 0}, {"s": 3.64, "e": 5.06, "t": "şey anlıyorum.", "p": 0}, {"s": 6.3, "e": 7.0, "t": "Sinirlendim.", "p": 0}, {"s": 7.0, "e": 8.4, "t": "Her el bu Faysal", "p": 0}, {"s": 8.4, "e": 9.22, "t": "otosu yüzünden", "p": 0}, {"s": 9.22, "e": 10.42, "t": "kaybediyoruz ya.", "p": 0}, {"s": 10.42, "e": 11.46, "t": "Silah vereyim sana, al", "p": 0}, {"s": 11.46, "e": 12.52, "t": "Faysal.", "p": 0}, {"s": 12.72, "e": 13.68, "t": "Atma, attım.", "p": 0}, {"s": 13.68, "e": 15.22, "t": "Attım, attım.", "p": 0}, {"s": 15.92, "e": 18.52, "t": "Oto atma, oto.", "p": 0}, {"s": 18.52, "e": 19.94, "t": "Oto atmadım, oto çok", "p": 0}, {"s": 19.94, "e": 21.06, "t": "pahalı.", "p": 0}, {"s": 21.76, "e": 23.7, "t": "Oto verirsen 200 dolarım", "p": 0}, {"s": 23.7, "e": 24.8, "t": "kalacak.", "p": 0}, {"s": 26.99, "e": 27.95, "t": "O zaman bir sonraki", "p": 0}, {"s": 27.95, "e": 29.15, "t": "yere kaybedersek ben", "p": 0}, {"s": 29.15, "e": 31.07, "t": "manik alacağım.", "p": 0}, {"s": 31.95, "e": 32.57, "t": "Altyazı M .K.", "p": 0}]}