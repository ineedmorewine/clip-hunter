{"speakers": 1, "cues": [{"s": 0.14, "e": 1.42, "t": "Vur vur vur!", "p": 0}, {"s": 1.42, "e": 3.32, "t": "Ya koşuyuz da bırakayım", "p": 0}, {"s": 3.32, "e": 4.96, "t": "ya, koşuyuz ya!", "p": 0}, {"s": 5.28, "e": 6.8, "t": "Bana bak,", "p": 0}, {"s": 6.9, "e": 7.44, "t": "neyse valla bak.", "p": 0}, {"s": 7.44, "e": 8.3, "t": "Sırf beni dinlememek", "p": 0}, {"s": 8.3, "e": 9.02, "t": "için.", "p": 0}, {"s": 9.08, "e": 12.12, "t": "Bu öldürüp dövdürecek", "p": 0}, {"s": 12.12, "e": 13.64, "t": "kendini bu şekilde ya.", "p": 0}, {"s": 13.64, "e": 14.88, "t": "Bana da sandın bombayı", "p": 0}, {"s": 14.88, "e": 15.74, "t": "ya.", "p": 0}, {"s": 16.46, "e": 18.08, "t": "Sen kurdun bombayı,", "p": 0}, {"s": 18.08, "e": 18.78, "t": "nereye kurdun", "p": 0}, {"s": 18.78, "e": 20.16, "t": "hatırlamıyordun.", "p": 0}, {"s": 20.16, "e": 21.08, "t": "Vallahi billahi", "p": 0}, {"s": 21.08, "e": 21.66, "t": "hatırlamadım.", "p": 0}, {"s": 21.66, "e": 22.78, "t": "Başka şu otoyu çekmeyi", "p": 0}, {"s": 22.78, "e": 23.84, "t": "bırak ya.", "p": 0}, {"s": 27.01, "e": 28.87, "t": "Ya atmayın şu bombayı.", "p": 0}]}