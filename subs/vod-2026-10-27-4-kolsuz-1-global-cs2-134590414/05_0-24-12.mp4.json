{"speakers": 1, "cues": [{"s": 1.68, "e": 3.38, "t": "İlk el aldık dedim.", "p": 0}, {"s": 4.6, "e": 5.82, "t": "Teröristken ilk el", "p": 0}, {"s": 5.82, "e": 7.52, "t": "aldığımızda ikinciye long", "p": 0}, {"s": 7.52, "e": 8.74, "t": "gitmemiz mantıklı.", "p": 0}, {"s": 8.74, "e": 9.92, "t": "Çünkü adamlar silah", "p": 0}, {"s": 9.92, "e": 10.9, "t": "alamıyor.", "p": 0}, {"s": 11.38, "e": 12.82, "t": "Uzak mesafesilerle", "p": 0}, {"s": 12.82, "e": 14.24, "t": "öldürebiliriz.", "p": 0}, {"s": 16.15, "e": 17.57, "t": "Ki ben içeri girince", "p": 0}, {"s": 17.57, "e": 19.13, "t": "öldürdüm adamı zaten.", "p": 0}, {"s": 19.39, "e": 20.51, "t": "Müthiş bir bilgi bu", "p": 0}, {"s": 20.51, "e": 21.55, "t": "arada bu.", "p": 0}, {"s": 22.01, "e": 23.03, "t": "Ozan bir daha kendine", "p": 0}, {"s": 23.03, "e": 23.73, "t": "ölemez.", "p": 0}, {"s": 23.73, "e": 25.75, "t": "Müthiş bir farkındalık.", "p": 0}, {"s": 26.83, "e": 28.25, "t": "Ben yorum yapmıyorum", "p": 0}, {"s": 28.25, "e": 29.19, "t": "size.", "p": 0}, {"s": 29.59, "e": 31.43, "t": "Ben bir şey söyledim.", "p": 0}, {"s": 32.89, "e": 34.09, "t": "Adam haklı.", "p": 0}, {"s": 34.09, "e": 35.19, "t": "Haklı.", "p": 0}]}