{"speakers": 2, "cues": [{"s": 0.0, "e": 0.9, "t": "adam", "p": 1}, {"s": 1.74, "e": 3.02, "t": "bizi körettin", "p": 0}, {"s": 3.02, "e": 5.52, "t": "bizi körettin", "p": 0}, {"s": 6.74, "e": 8.14, "t": "arkadan", "p": 1}, {"s": 8.14, "e": 9.06, "t": "geldik", "p": 1}, {"s": 9.55, "e": 10.89, "t": "En son beni vuran", "p": 1}, {"s": 10.89, "e": 13.29, "t": "adam Mevlana hilesi gibi", "p": 1}, {"s": 13.29, "e": 13.83, "t": "dönüyordu.", "p": 1}, {"s": 13.83, "e": 14.77, "t": "Mevlana hilesi değildi", "p": 1}, {"s": 14.77, "e": 15.83, "t": "gerçi, ona bitti Mevlana", "p": 1}, {"s": 15.83, "e": 16.77, "t": "'ydı.", "p": 1}, {"s": 17.31, "e": 18.83, "t": "Mevlana dönüyordu.", "p": 0}, {"s": 18.83, "e": 19.87, "t": "Ben yorum yapmıyorum", "p": 0}, {"s": 20.19, "e": 22.13, "t": "Hoş geldiniz efendim.", "p": 1}, {"s": 22.13, "e": 23.81, "t": "O zaman ben yayının", "p": 1}, {"s": 23.81, "e": 26.67, "t": "başlığını dört kolsuz bir", "p": 1}, {"s": 26.67, "e": 28.35, "t": "global olarak.", "p": 1}, {"s": 28.73, "e": 30.51, "t": "Misal kuşun ölmüş.", "p": 0}, {"s": 31.27, "e": 32.73, "t": "Faisal beni bir sinir", "p": 0}, {"s": 32.73, "e": 33.87, "t": "etti, bir sinir etti.", "p": 0}, {"s": 33.87, "e": 35.15, "t": "Yanımda olsa ensesine bir", "p": 0}, {"s": 35.15, "e": 36.69, "t": "tane tokat çakacaktı.", "p": 0}, {"s": 36.69, "e": 37.85, "t": "Sadece bir tane tokat", "p": 0}, {"s": 37.85, "e": 38.79, "t": "çakacaktı.", "p": 0}, {"s": 38.79, "e": 40.11, "t": "Bir tane tokat atacağım.", "p": 0}, {"s": 40.11, "e": 41.71, "t": "Biraz az değil mi?", "p": 0}, {"s": 41.71, "e": 42.19, "t": "Dövemem.", "p": 0}, {"s": 42.19, "e": 43.02, "t": "Dövemem de yani.", "p": 0}, {"s": 43.02, "e": 43.78, "t": "Lan atlayamadım.", "p": 0}, {"s": 43.78, "e": 45.6, "t": "Lan atlayamadım ben.", "p": 1}, {"s": 46.59, "e": 47.66, "t": "Allah da senin belanı", "p": 0}, {"s": 47.66, "e": 48.8, "t": "versin yani.", "p": 0}, {"s": 49.32, "e": 50.64, "t": "Bir elimde sigara", "p": 1}, {"s": 50.64, "e": 52.64, "t": "tutarsam olacağı budur.", "p": 1}, {"s": 53.08, "e": 54.38, "t": "Aysal, adam burada tek", "p": 0}, {"s": 54.38, "e": 54.53, "t": "yani.", "p": 0}, {"s": 56.43, "e": 58.27, "t": "Otomal", "p": 0}, {"s": 59.43, "e": 60.81, "t": "Nasıl bir otosu var", "p": 0}, {"s": 60.81, "e": 61.45, "t": "ben anlamıyorum ki", "p": 0}, {"s": 61.45, "e": 63.43, "t": "Her el var", "p": 0}, {"s": 63.43, "e": 65.04, "t": "Baktım bunun otosundan ya", "p": 0}, {"s": 65.04, "e": 66.42, "t": "Burayacak gelmedi mi?", "p": 0}, {"s": 66.56, "e": 68.88, "t": "Arada sandın bombayı ya.", "p": 0}, {"s": 69.48, "e": 71.28, "t": "Sen kurdun bombayı.", "p": 1}, {"s": 71.28, "e": 71.96, "t": "Nereye kurduğunu", "p": 1}, {"s": 71.96, "e": 73.08, "t": "hatırlamıyorum.", "p": 1}, {"s": 73.08, "e": 74.24, "t": "Vallahi billahi", "p": 0}, {"s": 74.24, "e": 74.82, "t": "hatırlamıyorum.", "p": 0}, {"s": 74.82, "e": 76.18, "t": "Şu otoyu çekmeyi bırak", "p": 0}, {"s": 76.18, "e": 76.55, "t": "ya.", "p": 0}, {"s": 76.55, "e": 77.31, "t": "Aldım mı aldım.", "p": 0}, {"s": 77.31, "e": 78.39, "t": "Hiç utanmıyor.", "p": 0}, {"s": 78.39, "e": 79.65, "t": "Bu adama yak mı?", "p": 0}, {"s": 79.73, "e": 81.69, "t": "Ama ne pahasına aldım.", "p": 0}, {"s": 81.89, "e": 83.31, "t": "Onur 'un gururun kaldı", "p": 0}, {"s": 83.31, "e": 84.01, "t": "mı?", "p": 0}, {"s": 84.65, "e": 85.85, "t": "Abi aldık aldık.", "p": 0}, {"s": 85.85, "e": 87.27, "t": "5 para etti Onur", "p": 0}, {"s": 87.27, "e": 87.73, "t": "'un.", "p": 0}]}