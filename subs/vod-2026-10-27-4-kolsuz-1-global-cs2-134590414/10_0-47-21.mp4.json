{"speakers": 1, "cues": [{"s": 1.14, "e": 2.42, "t": "Lan atlayamadım.", "p": 0}, {"s": 2.42, "e": 4.16, "t": "Lan atlayamadım ben.", "p": 0}, {"s": 4.76, "e": 6.24, "t": "Allah da senin belanı", "p": 0}, {"s": 6.24, "e": 7.42, "t": "versin yani.", "p": 0}, {"s": 7.9, "e": 9.24, "t": "Bir elimde sigara", "p": 0}, {"s": 9.24, "e": 11.2, "t": "tutarsam olacağı budur.", "p": 0}, {"s": 11.64, "e": 12.96, "t": "Aysal adam burada tek", "p": 0}, {"s": 12.96, "e": 13.8, "t": "yani.", "p": 0}, {"s": 14.18, "e": 15.16, "t": "Ben de tekim ne", "p": 0}, {"s": 15.16, "e": 16.14, "t": "olmuş yani?", "p": 0}, {"s": 16.22, "e": 17.66, "t": "Teşekkür Aysal.", "p": 0}, {"s": 18.22, "e": 19.18, "t": "Ben hanımın arkasında ne", "p": 0}, {"s": 19.18, "e": 19.78, "t": "oluyordum yoktan", "p": 0}, {"s": 19.78, "e": 20.9, "t": "girecektim.", "p": 0}, {"s": 20.92, "e": 23.38, "t": "21 14 Hasanlara bak.", "p": 0}, {"s": 24.88, "e": 26.92, "t": "Ben silah çekmiyorum.", "p": 0}, {"s": 27.92, "e": 29.72, "t": "Çekme sensin evet.", "p": 0}]}