{"speakers": 2, "cues": [{"s": 1.14, "e": 2.4, "t": "Lan atlayamadım.", "p": 0}, {"s": 2.4, "e": 4.18, "t": "Lan atlayamadım ben.", "p": 1}, {"s": 4.8, "e": 6.24, "t": "Allah da senin belanı", "p": 0}, {"s": 6.24, "e": 7.4, "t": "versin yani.", "p": 0}, {"s": 8.0, "e": 9.24, "t": "Bir elimde sigara", "p": 1}, {"s": 9.24, "e": 11.22, "t": "tutarsam olacağı budur.", "p": 1}, {"s": 11.68, "e": 12.96, "t": "Aysal adam burada tek", "p": 0}, {"s": 12.96, "e": 13.8, "t": "yani.", "p": 0}, {"s": 14.18, "e": 15.16, "t": "Ben de tekim ne", "p": 0}, {"s": 15.16, "e": 16.14, "t": "olmuş yani.", "p": 0}, {"s": 16.2, "e": 17.68, "t": "Eşek Faysal.", "p": 0}, {"s": 18.22, "e": 19.18, "t": "Ben adamın arkasında ne", "p": 0}, {"s": 19.18, "e": 19.78, "t": "oluyordum yoktan", "p": 0}, {"s": 19.78, "e": 20.92, "t": "girecektim.", "p": 0}, {"s": 20.96, "e": 23.38, "t": "21 14 Hasanlara bak.", "p": 0}, {"s": 24.92, "e": 26.94, "t": "Ben silahı çekmiyorum.", "p": 0}, {"s": 28.18, "e": 29.74, "t": "Çekmesen seni evet.", "p": 0}]}