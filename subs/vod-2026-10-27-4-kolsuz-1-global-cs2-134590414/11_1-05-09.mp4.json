{"speakers": 1, "cues": [{"s": 1.58, "e": 3.16, "t": "Oynamam ya, oynayacağımız", "p": 0}, {"s": 3.16, "e": 4.26, "t": "varsa da oynayamıyoruz", "p": 0}, {"s": 4.26, "e": 4.68, "t": "ya.", "p": 0}, {"s": 4.68, "e": 6.4, "t": "Valla bombayı tuttum,", "p": 0}, {"s": 6.4, "e": 7.78, "t": "bombayı tuttum.", "p": 0}, {"s": 7.78, "e": 9.28, "t": "Töpeye çıktım.", "p": 0}, {"s": 9.46, "e": 11.24, "t": "Kardeşim, yemin ediyorum,", "p": 0}, {"s": 11.24, "e": 12.08, "t": "yapacağım varsa", "p": 0}, {"s": 12.08, "e": 13.2, "t": "yapamayacağım ya.", "p": 0}, {"s": 13.2, "e": 14.14, "t": "Dur ya.", "p": 0}, {"s": 14.92, "e": 16.26, "t": "Hayır diyorum ki bombayı", "p": 0}, {"s": 16.26, "e": 17.06, "t": "kutun üstüne kurt, adam", "p": 0}, {"s": 17.06, "e": 17.64, "t": "çıkacak.", "p": 0}, {"s": 17.64, "e": 18.68, "t": "Demir etsin.", "p": 0}, {"s": 18.68, "e": 20.3, "t": "Ne olur haklısın, dur.", "p": 0}, {"s": 20.3, "e": 21.88, "t": "Asla anlamıyorum ya.", "p": 0}, {"s": 22.18, "e": 23.14, "t": "Fakta olsa hiç bir", "p": 0}, {"s": 23.14, "e": 24.42, "t": "şey anlamıyorum ya.", "p": 0}, {"s": 27.04, "e": 28.38, "t": "Hadi anlamadım.", "p": 0}, {"s": 28.38, "e": 29.48, "t": "Bağırıyor bir de.", "p": 0}]}