{"speakers": 2, "cues": [{"s": 1.58, "e": 3.14, "t": "Tamam ya, oynayacağımız", "p": 0}, {"s": 3.14, "e": 4.24, "t": "varsa da oynayamıyoruz", "p": 0}, {"s": 4.24, "e": 4.64, "t": "ya.", "p": 0}, {"s": 4.64, "e": 6.6, "t": "Lan bombayı tuttum.", "p": 0}, {"s": 6.78, "e": 7.78, "t": "Sen kurdum.", "p": 1}, {"s": 7.78, "e": 9.28, "t": "Töpeye çıktım.", "p": 1}, {"s": 9.44, "e": 11.24, "t": "Kardeşim, yemin ediyorum.", "p": 0}, {"s": 11.24, "e": 12.08, "t": "Yapacağım varsa", "p": 0}, {"s": 12.08, "e": 13.2, "t": "yapamayacağım ya.", "p": 0}, {"s": 13.2, "e": 14.14, "t": "Dur ya.", "p": 0}, {"s": 14.92, "e": 16.26, "t": "Hayır diyorum ki bombayı", "p": 0}, {"s": 16.26, "e": 17.06, "t": "kurtun üstüne kurdu adam", "p": 0}, {"s": 17.06, "e": 17.84, "t": "çıkacak.", "p": 0}, {"s": 17.84, "e": 18.94, "t": "Yemin ederim sen.", "p": 0}, {"s": 18.94, "e": 20.48, "t": "Ne olur haklısın, dur.", "p": 0}, {"s": 20.48, "e": 21.9, "t": "Asla anlamıyorum ya.", "p": 0}, {"s": 22.18, "e": 23.08, "t": "Faito 'yu söyle hiçbir", "p": 0}, {"s": 23.08, "e": 24.42, "t": "şey anlamıyorum ya.", "p": 1}, {"s": 27.06, "e": 28.24, "t": "Hani de anlamıyorum.", "p": 0}, {"s": 28.42, "e": 29.46, "t": "Bağırıyor bir de.", "p": 0}]}