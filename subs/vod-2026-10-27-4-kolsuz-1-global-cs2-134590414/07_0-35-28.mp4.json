{"speakers": 2, "cues": [{"s": 0.0, "e": 1.84, "t": "Ağabeyse olsaydım.", "p": 1}, {"s": 2.68, "e": 3.5, "t": "Ayy.", "p": 1}, {"s": 3.94, "e": 5.2, "t": "Oto gitti.", "p": 0}, {"s": 5.2, "e": 6.14, "t": "Neyse kaybettik artık", "p": 0}, {"s": 6.14, "e": 6.9, "t": "böyle.", "p": 0}, {"s": 9.15, "e": 10.75, "t": "Artık gitti yani.", "p": 0}, {"s": 12.17, "e": 13.93, "t": "Oto aldığın için adamlar", "p": 0}, {"s": 13.93, "e": 15.13, "t": "bize kuruluyor.", "p": 0}, {"s": 15.13, "e": 17.39, "t": "Ve her eli kaybediyoruz.", "p": 0}, {"s": 17.41, "e": 18.93, "t": "Adam M4A1 'le aldı", "p": 0}, {"s": 18.93, "e": 19.75, "t": "ikimizi.", "p": 0}, {"s": 20.09, "e": 20.99, "t": "Ben başka bir şey", "p": 0}, {"s": 20.99, "e": 21.99, "t": "demiyordum.", "p": 0}, {"s": 25.35, "e": 26.97, "t": "Yani geri zekalı bari", "p": 1}, {"s": 26.97, "e": 28.33, "t": "bırak şeyi ya.", "p": 1}]}