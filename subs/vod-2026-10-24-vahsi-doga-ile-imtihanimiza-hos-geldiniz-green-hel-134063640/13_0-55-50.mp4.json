{"speakers": 2, "cues": [{"s": 0.0, "e": 3.2, "t": "Eyvah ben çok yanlış", "p": 0}, {"s": 3.2, "e": 4.36, "t": "bir şey yaptım ya", "p": 0}, {"s": 4.36, "e": 7.26, "t": "ben ölürken senin", "p": 0}, {"s": 7.26, "e": 8.56, "t": "arkadaşlar biriniz", "p": 0}, {"s": 8.56, "e": 9.86, "t": "öleceğiniz zaman herkes", "p": 0}, {"s": 9.86, "e": 11.3, "t": "yanımdan uzaklaştırsın", "p": 0}, {"s": 11.3, "e": 12.44, "t": "çünkü her seferinde", "p": 0}, {"s": 12.44, "e": 13.44, "t": "başkasını ölürken", "p": 0}, {"s": 13.44, "e": 14.42, "t": "gördüğümüzde akıl", "p": 0}, {"s": 14.42, "e": 15.44, "t": "sağlığımız çok fena", "p": 0}, {"s": 15.44, "e": 17.16, "t": "etkileniyor ve belli bir", "p": 0}, {"s": 17.16, "e": 18.56, "t": "saatten sonra sanrılar da", "p": 0}, {"s": 18.56, "e": 20.26, "t": "görmeye başlayacağız.", "p": 0}, {"s": 20.82, "e": 22.68, "t": "Acil şuraya ateş yakalım", "p": 0}, {"s": 22.68, "e": 23.88, "t": "ateşe bakalım ateş", "p": 0}, {"s": 23.88, "e": 24.58, "t": "yükseliyor.", "p": 0}]}