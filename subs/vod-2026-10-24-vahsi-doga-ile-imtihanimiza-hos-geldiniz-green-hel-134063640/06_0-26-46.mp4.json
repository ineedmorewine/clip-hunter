{"speakers": 1, "cues": [{"s": 1.52, "e": 3.08, "t": "Ay ne geçti yanımdan", "p": 0}, {"s": 3.08, "e": 4.34, "t": "vız diye.", "p": 0}, {"s": 15.38, "e": 17.12, "t": "Ya sen adamsın.", "p": 0}, {"s": 17.12, "e": 18.24, "t": "Hani çocuk nereden", "p": 0}, {"s": 18.24, "e": 18.86, "t": "getiriyor?", "p": 0}, {"s": 18.86, "e": 19.88, "t": "Bak bak.", "p": 0}, {"s": 19.88, "e": 22.2, "t": "Musa görev adamı ya.", "p": 0}, {"s": 22.5, "e": 23.82, "t": "Abi son bir tane", "p": 0}, {"s": 23.82, "e": 24.38, "t": "kaldı.", "p": 0}, {"s": 24.38, "e": 25.68, "t": "Yok mu yapmak ya?", "p": 0}, {"s": 28.11, "e": 29.07, "t": "Oğlum buraya kurmayın", "p": 0}, {"s": 29.07, "e": 30.83, "t": "şurada ateş var dedik.", "p": 0}, {"s": 30.83, "e": 31.93, "t": "Ateşi yaptık.", "p": 0}, {"s": 31.93, "e": 33.83, "t": "Bu kadar görev adamını", "p": 0}, {"s": 33.83, "e": 35.19, "t": "biz duyamadık yani.", "p": 0}, {"s": 35.19, "e": 36.15, "t": "Allah 'ım.", "p": 0}, {"s": 36.59, "e": 37.95, "t": "Oyunda şeytanlaşıyor", "p": 0}, {"s": 37.95, "e": 38.53, "t": "insanlar.", "p": 0}, {"s": 38.53, "e": 39.51, "t": "Ben anlamadım.", "p": 0}]}