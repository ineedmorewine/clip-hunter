{"speakers": 2, "cues": [{"s": 0.0, "e": 1.54, "t": "A siktir a siktir", "p": 0}, {"s": 1.54, "e": 2.36, "t": "a siktir a siktir", "p": 0}, {"s": 2.36, "e": 3.36, "t": "a siktir", "p": 0}, {"s": 3.38, "e": 4.14, "t": "Ne oldu?", "p": 1}, {"s": 4.14, "e": 5.34, "t": "Tamam bir şey yok", "p": 0}, {"s": 5.36, "e": 6.48, "t": "Göz göze geldim bu", "p": 0}, {"s": 6.48, "e": 6.8, "t": "sefer", "p": 0}, {"s": 6.8, "e": 8.4, "t": "Tıs yaptı bana", "p": 0}, {"s": 8.51, "e": 9.73, "t": "Evet ya,", "p": 0}, {"s": 9.89, "e": 10.89, "t": "bırak karımın peşini,", "p": 0}, {"s": 10.89, "e": 11.85, "t": "bırakın lan karımın", "p": 0}, {"s": 11.85, "e": 12.71, "t": "peşini.", "p": 0}, {"s": 14.02, "e": 15.68, "t": "senin arkadaşlar biriniz", "p": 0}, {"s": 15.68, "e": 16.2, "t": "öleceğiniz", "p": 0}, {"s": 16.2, "e": 17.4, "t": "zaman herkes yanından", "p": 0}, {"s": 17.4, "e": 18.56, "t": "uzaklaştırsın.", "p": 0}, {"s": 18.56, "e": 19.56, "t": "Çünkü her seferinde", "p": 0}, {"s": 19.56, "e": 20.12, "t": "başkasını", "p": 0}, {"s": 20.12, "e": 21.56, "t": "ölürken gördüğümüzde akıl", "p": 0}, {"s": 21.56, "e": 21.98, "t": "sağlığımız", "p": 0}, {"s": 21.98, "e": 23.52, "t": "çok fena etkileniyor.", "p": 0}, {"s": 23.52, "e": 25.42, "t": "Bu", "p": 1}, {"s": 26.8, "e": 28.32, "t": "zıkkım yesin zaten.", "p": 1}, {"s": 28.32, "e": 29.82, "t": "Sabah bunu doyuracağım,", "p": 1}, {"s": 29.82, "e": 31.72, "t": "suyunu eksik etmeyeceğim", "p": 1}, {"s": 31.72, "e": 33.03, "t": "diye oyun oynuyoruz ki.", "p": 0}, {"s": 33.03, "e": 34.91, "t": "İki tane salyangoz yedim.", "p": 1}, {"s": 34.91, "e": 36.27, "t": "İki tane et yedim.", "p": 1}, {"s": 36.27, "e": 37.99, "t": "Ne yedireyim ben buna?", "p": 1}, {"s": 37.99, "e": 39.25, "t": "Zıkkım yesin gerçekten", "p": 1}, {"s": 39.25, "e": 39.85, "t": "ya.", "p": 0}, {"s": 39.85, "e": 40.51, "t": "Şu an bir şey", "p": 0}, {"s": 40.54, "e": 41.58, "t": "Çamuklarımdan mı koptun", "p": 1}, {"s": 41.58, "e": 42.1, "t": "lan?", "p": 1}, {"s": 42.