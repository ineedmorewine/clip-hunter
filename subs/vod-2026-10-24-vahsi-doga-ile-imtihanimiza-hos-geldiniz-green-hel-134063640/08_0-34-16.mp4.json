{"speakers": 1, "cues": [{"s": 0.0, "e": 1.36, "t": "Şunu ye.", "p": 0}, {"s": 1.7, "e": 3.52, "t": "Ya yarım saattir yiyiyom", "p": 0}, {"s": 3.52, "e": 3.88, "t": "ben ya.", "p": 0}, {"s": 3.88, "e": 5.06, "t": "Şunları ye.", "p": 0}, {"s": 5.48, "e": 6.4, "t": "Şunları ye.", "p": 0}, {"s": 6.4, "e": 7.84, "t": "Bak attıklarımı ye.", "p": 0}, {"s": 11.79, "e": 12.79, "t": "Ne bunlar?", "p": 0}, {"s": 12.79, "e": 14.87, "t": "Bütün dünyayı yedim ya.", "p": 0}, {"s": 14.87, "e": 16.69, "t": "Bunlar su da verebilir.", "p": 0}, {"s": 16.69, "e": 17.69, "t": "Su veren de vardır", "p": 0}, {"s": 17.69, "e": 18.29, "t": "arasında.", "p": 0}, {"s": 18.29, "e": 19.51, "t": "Karbonhidrat falan enerji", "p": 0}, {"s": 19.51, "e": 20.85, "t": "veren mantarlar.", "p": 0}, {"s": 20.85, "e": 21.77, "t": "Küçük.", "p": 0}, {"s": 21.77, "e": 23.09, "t": "Ben hep topluyorum.", "p": 0}, {"s": 23.09, "e": 24.53, "t": "Taşların üstünde oluyor.", "p": 0}, {"s": 24.53, "e": 26.53, "t": "Şekerim düştü benim ya.", "p": 0}, {"s": 28.45, "e": 29.53, "t": "Şekerim.", "p": 0}, {"s": 29.53, "e": 30.95, "t": "Ölümleri en fesinde.", "p": 0}, {"s": 30.95, "e": 32.21, "t": "Bir de şöyle bir", "p": 0}, {"s": 32.21, "e": 32.35, "t": "de.", "p": 0}, {"s": 32.35, "e": 33.97, "t": "Aaa senin burana bir", "p": 0}, {"s": 33.97, "e": 34.11, "t": "şey", "p": 0}, {"s": 34.11, "e": 35.21, "t": "Olmuş", "p": 0}, {"s": 35.21, "e": 37.43, "t": "Senin yaran varmış", "p": 0}, {"s": 37.43, "e": 38.31, "t": "Musa", "p": 0}, {"s": 38.31, "e": 40.25, "t": "Musa kalkınca", "p": 0}, {"s": 40.25, "e": 41.01, "t": "halledeceğiz şimdi", "p": 0}, {"s": 41.01, "e": 42.23, "t": "Kalktı mı", "p": 0}, {"s": 42.75, "e": 44.35, "t": "Musa", "p": 0}, {"s": 45.47, "e": 47.99, "t": "Öldü Musa öldü", "p": 0}, {"s": 47.99, "e": 49.33, "t": "Bandajım vardı benim", "p": 0}, {"s": 49.33, "e": 51.01, "t": "Evet hayır dur artık", "p": 0}, {"s": 51.01, "e": 51.53, "t": "gerek yok", "p": 0}, {"s": 51.53, "e": 52.47, "t": "Gerek", "p": 0}]}