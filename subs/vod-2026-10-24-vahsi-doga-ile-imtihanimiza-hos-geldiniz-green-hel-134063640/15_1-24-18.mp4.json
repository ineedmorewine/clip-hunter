{"speakers": 1, "cues": [{"s": 1.95, "e": 3.77, "t": "Bir de bak iki", "p": 0}, {"s": 3.77, "e": 5.47, "t": "tane salyangoz yedim, iki", "p": 0}, {"s": 5.47, "e": 6.59, "t": "tane et yedim.", "p": 0}, {"s": 6.59, "e": 8.35, "t": "Ne yedireyim ben buna?", "p": 0}, {"s": 8.35, "e": 9.61, "t": "Zıkkım yesin gerçekten", "p": 0}, {"s": 9.61, "e": 10.19, "t": "ya.", "p": 0}, {"s": 10.19, "e": 10.87, "t": "Şu an bir şey", "p": 0}, {"s": 10.87, "e": 11.43, "t": "söyleyeceğim.", "p": 0}, {"s": 11.43, "e": 12.83, "t": "Büyüteç varsa üstünde bir", "p": 0}, {"s": 12.83, "e": 15.15, "t": "enerjini boşa harcamayı", "p": 0}, {"s": 15.15, "e": 15.49, "t": "bırak.", "p": 0}, {"s": 15.49, "e": 16.69, "t": "O yüzden bayılıyorsun.", "p": 0}, {"s": 16.69, "e": 17.39, "t": "Dur.", "p": 0}, {"s": 17.39, "e": 19.11, "t": "Ama hiçbir şeyim yok.", "p": 0}]}