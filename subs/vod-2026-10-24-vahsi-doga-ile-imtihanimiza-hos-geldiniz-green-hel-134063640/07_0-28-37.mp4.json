{"speakers": 1, "cues": [{"s": 0.14, "e": 1.36, "t": "Hepimiz uyuyalım.", "p": 0}, {"s": 1.36, "e": 2.02, "t": "Ben kendi yatağımı", "p": 0}, {"s": 2.02, "e": 2.72, "t": "yapayım da bi.", "p": 0}, {"s": 2.72, "e": 4.48, "t": "Şerefli chat izle.", "p": 0}, {"s": 6.6, "e": 8.4, "t": "Aşkım senin yatmazsan", "p": 0}, {"s": 8.4, "e": 9.44, "t": "bizim uyumamız hiçbir şey", "p": 0}, {"s": 9.44, "e": 10.66, "t": "yaramayacak.", "p": 0}, {"s": 11.28, "e": 12.46, "t": "Kalkın o zaman.", "p": 0}, {"s": 12.46, "e": 13.3, "t": "Abi bir saattir sizi", "p": 0}, {"s": 13.3, "e": 14.46, "t": "bekliyorum.", "p": 0}, {"s": 15.26, "e": 16.88, "t": "Gel Musa kalk kalk", "p": 0}, {"s": 16.88, "e": 17.16, "t": "kalk.", "p": 0}, {"s": 17.16, "e": 18.04, "t": "Musa kalk.", "p": 0}, {"s": 18.04, "e": 18.66, "t": "Ateşi yaktık.", "p": 0}, {"s": 18.66, "e": 19.52, "t": "E o yüzden ben", "p": 0}, {"s": 19.52, "e": 21.16, "t": "hani palmiye yaprağı o", "p": 0}, {"s": 21.16, "e": 22.02, "t": "yüzden arıyorduk ya o", "p": 0}, {"s": 22.02, "e": 23.0, "t": "yüzden ben aslında ona", "p": 0}, {"s": 23.0, "e": 25.08, "t": "görev adamı da çeştüm.", "p": 0}, {"s": 28.34, "e": 29.2, "t": "O da eksik iş", "p": 0}, {"s": 29.2, "e": 29.86, "t": "yapan.", "p": 0}, {"s": 29.86, "e": 30.94, "t": "Bakın siz.", "p": 0}]}