{"speakers": 2, "cues": [{"s": 0.14, "e": 1.36, "t": "Hepimiz uyuyalım.", "p": 0}, {"s": 1.36, "e": 2.02, "t": "Ben kendi yatağımı", "p": 1}, {"s": 2.02, "e": 2.72, "t": "yapayım debi.", "p": 1}, {"s": 2.72, "e": 4.48, "t": "Şerefli chat izle.", "p": 1}, {"s": 6.58, "e": 7.26, "t": "Aşkım.", "p": 0}, {"s": 7.26, "e": 8.62, "t": "Senin yatmazsan bizim", "p": 0}, {"s": 8.62, "e": 9.42, "t": "uyumamız hiçbir şey", "p": 0}, {"s": 9.42, "e": 10.66, "t": "aramayacak.", "p": 0}, {"s": 11.28, "e": 12.46, "t": "Kalkın o zaman.", "p": 1}, {"s": 12.46, "e": 13.3, "t": "Abi bir saattir sizi", "p": 1}, {"s": 13.3, "e": 14.44, "t": "bekliyorum.", "p": 1}, {"s": 15.26, "e": 17.14, "t": "Gel Musa kalk kalk.", "p": 0}, {"s": 17.14, "e": 18.04, "t": "Musa kalk.", "p": 0}, {"s": 18.04, "e": 18.66, "t": "Ateşi yaktık.", "p": 0}, {"s": 18.66, "e": 19.52, "t": "E o yüzden ben", "p": 0}, {"s": 19.52, "e": 21.16, "t": "hani palmiye yaprağı o", "p": 0}, {"s": 21.16, "e": 22.0, "t": "yüzden arıyorduk ya.", "p": 0}, {"s": 22.0, "e": 22.78, "t": "O yüzden ben aslında", "p": 0}, {"s": 22.78, "e": 23.82, "t": "ona görev adamı da", "p": 0}, {"s": 23.82, "e": 25.08, "t": "çeştüm.", "p": 0}, {"s": 28.34, "e": 29.2, "t": "Bak da eksik iş", "p": 1}, {"s": 29.2, "e": 29.9, "t": "yapmak.", "p": 1}, {"s": 29.9, "e": 30.94, "t": "Bakın siz.", "p": 1}]}