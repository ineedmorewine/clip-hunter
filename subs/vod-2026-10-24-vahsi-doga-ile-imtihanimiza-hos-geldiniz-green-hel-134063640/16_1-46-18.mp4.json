{"speakers": 1, "cues": [{"s": 0.0, "e": 0.88, "t": "Bakın daha leopar 'a", "p": 0}, {"s": 0.88, "e": 1.84, "t": "kapattın ya", "p": 0}, {"s": 1.84, "e": 3.3, "t": "Ya böyle bir şeyi", "p": 0}, {"s": 3.3, "e": 4.82, "t": "Allah kan etsin seni", "p": 0}, {"s": 4.82, "e": 5.66, "t": "ya", "p": 0}, {"s": 6.1, "e": 7.48, "t": "Ben böyle bu kadar", "p": 0}, {"s": 7.48, "e": 8.98, "t": "çok kötü bir oyum", "p": 0}, {"s": 8.98, "e": 9.26, "t": "bu arada", "p": 0}, {"s": 9.26, "e": 10.48, "t": "Oğlum az siktir leopar", "p": 0}, {"s": 10.48, "e": 11.84, "t": "bana da geliyor", "p": 0}, {"s": 12.46, "e": 13.92, "t": "Manyak mıdır nedir oyun", "p": 0}, {"s": 13.92, "e": 14.2, "t": "ya", "p": 0}, {"s": 14.2, "e": 16.52, "t": "Ne istiyorsun bizden abi", "p": 0}, {"s": 16.52, "e": 17.68, "t": "Yanlışlıkla en az siktir", "p": 0}, {"s": 17.68, "e": 18.86, "t": "Sen oradan", "p": 0}, {"s": 19.88, "e": 21.72, "t": "Bana da leopar geldi", "p": 0}, {"s": 21.72, "e": 22.6, "t": "abi", "p": 0}, {"s": 22.8, "e": 23.98, "t": "Kaçma kaçma gel", "p": 0}, {"s": 23.98, "e": 25.24, "t": "Unoklarımdan mı kopsun", "p": 0}, {"s": 25.24, "e": 26.0, "t": "lan", "p": 0}, {"s": 26.0, "e": 27.62, "t": "Aaa siktir geldi geldi", "p": 0}, {"s": 27.62, "e": 27.9, "t": "geldi", "p": 0}, {"s": 27.9, "e": 29.36, "t": "Ananı avradına bir sene", "p": 0}, {"s": 29.36, "e": 29.88, "t": "eksiksin", "p": 0}, {"s": 29.88, "e": 31.22, "t": "Gerçekten", "p": 0}, {"s": 32.38, "e": 34.06, "t": "öldüm abi", "p": 0}]}