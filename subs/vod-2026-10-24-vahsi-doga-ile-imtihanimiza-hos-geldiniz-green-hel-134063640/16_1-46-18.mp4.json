{"speakers": 2, "cues": [{"s": 0.0, "e": 0.88, "t": "Bakın daha leopar 'a", "p": 1}, {"s": 0.88, "e": 1.56, "t": "kapattı", "p": 1}, {"s": 1.56, "e": 3.44, "t": "Ya böyle bir şeyim", "p": 1}, {"s": 3.44, "e": 4.86, "t": "Allah kan etsin seni", "p": 1}, {"s": 4.86, "e": 5.66, "t": "ya", "p": 1}, {"s": 8.12, "e": 10.48, "t": "Oğlum az siktir leopar", "p": 0}, {"s": 10.48, "e": 11.82, "t": "bana da geliyor", "p": 0}, {"s": 12.4, "e": 13.94, "t": "Manyak mıdır nedir oyun", "p": 1}, {"s": 13.94, "e": 14.2, "t": "ya", "p": 1}, {"s": 14.2, "e": 16.52, "t": "Ne istiyorsun bizden abi", "p": 1}, {"s": 16.52, "e": 18.22, "t": "Yanlışlıkla en az siktir", "p": 1}, {"s": 18.22, "e": 19.74, "t": "Gel gel gel gel", "p": 1}, {"s": 19.88, "e": 21.72, "t": "Bana da leopar geldi", "p": 0}, {"s": 21.72, "e": 22.1, "t": "abi", "p": 0}, {"s": 22.1, "e": 23.98, "t": "Kaçma kaçma gel", "p": 1}, {"s": 23.98, "e": 25.24, "t": "Unoklarımdan mı kopsun", "p": 1}, {"s": 25.24, "e": 26.0, "t": "lan", "p": 1}, {"s": 26.0, "e": 27.64, "t": "Haa siktir geldi geldi", "p": 0}, {"s": 27.64, "e": 27.9, "t": "geldi", "p": 0}, {"s": 27.9, "e": 29.36, "t": "ananı avradına bir sene", "p": 0}, {"s": 29.36, "e": 29.9, "t": "eksiksin", "p": 0}, {"s": 29.9, "e": 30.98, "t": "gerçekten", "p": 0}, {"s": 32.14, "e": 34.22, "t": "öldüm ağabeyim", "p": 0}]}