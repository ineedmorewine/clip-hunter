{"speakers": 2, "cues": [{"s": 0.0, "e": 0.64, "t": "Mollerian 'ın yani.", "p": 0}, {"s": 0.64, "e": 2.14, "t": "Gelirsen bağırıcam, sarı", "p": 1}, {"s": 2.14, "e": 2.94, "t": "gördüğüm her şeyde", "p": 0}, {"s": 2.94, "e": 3.18, "t": "bağırıcam.", "p": 0}, {"s": 3.18, "e": 3.4, "t": "Aaa!", "p": 0}, {"s": 3.4, "e": 4.26, "t": "Leopar orada!", "p": 0}, {"s": 4.26, "e": 5.78, "t": "İki tane Leopar var.", "p": 0}, {"s": 5.78, "e": 6.68, "t": "Leopar mı yok lan", "p": 0}, {"s": 6.68, "e": 7.6, "t": "Kapibar?", "p": 0}, {"s": 7.82, "e": 8.62, "t": "Kapibara mı o?", "p": 0}, {"s": 8.62, "e": 9.66, "t": "Bir tanesi Kapibara,", "p": 0}, {"s": 9.66, "e": 10.58, "t": "diğeri de mi Kapibara", "p": 0}, {"s": 10.58, "e": 11.08, "t": "bilmiyorum.", "p": 0}, {"s": 11.08, "e": 12.66, "t": "Harbiden Leopar var he.", "p": 1}, {"s": 12.66, "e": 13.52, "t": "İlk defa Leopar var.", "p": 1}, {"s": 13.52, "e": 15.24, "t": "Bence bu alırız.", "p": 1}, {"s": 16.1, "e": 17.28, "t": "Alsakta bir bok olmaz", "p": 0}, {"s": 17.28, "e": 18.52, "t": "bence hiç.", "p": 0}, {"s": 18.64, "e": 19.5, "t": "Kapibara lan bu.", "p": 1}, {"s": 19.5, "e": 20.5, "t": "Leopar değil bunlar.", "p": 1}, {"s": 20.5, "e": 21.42, "t": "Kapibara bunlar.", "p": 1}, {"s": 21.42, "e": 22.24, "t": "Tamam.", "p": 0}, {"s": 25.31, "e": 25.91, "t": "Kapibara mı öyle?", "p": 1}, {"s": 25.91, "e": 26.81, "t": "Bu olan şey o,", "p": 1}, {"s": 26.81, "e": 27.61, "t": "çiçek.", "p": 1}]}