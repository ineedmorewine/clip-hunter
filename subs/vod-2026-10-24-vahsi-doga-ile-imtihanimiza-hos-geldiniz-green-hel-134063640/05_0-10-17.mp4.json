{"speakers": 1, "cues": [{"s": 0.0, "e": 0.64, "t": "Mollerian 'ın yani.", "p": 0}, {"s": 0.64, "e": 1.88, "t": "Gelirsen bağırıcam.", "p": 0}, {"s": 1.88, "e": 2.94, "t": "Sarı gördüğüm her şeyde", "p": 0}, {"s": 2.94, "e": 3.18, "t": "bağırıcam.", "p": 0}, {"s": 3.18, "e": 4.32, "t": "Aaa Leopar orada.", "p": 0}, {"s": 4.32, "e": 5.78, "t": "İki tane Leopar var.", "p": 0}, {"s": 5.78, "e": 6.44, "t": "Leopar mı?", "p": 0}, {"s": 6.44, "e": 7.58, "t": "Yok lan Kapibar.", "p": 0}, {"s": 7.82, "e": 8.58, "t": "Kapibara mı o?", "p": 0}, {"s": 8.58, "e": 9.66, "t": "Bir tanesi Kapibara.", "p": 0}, {"s": 9.66, "e": 10.56, "t": "Diğeri de mi Kapibara", "p": 0}, {"s": 10.56, "e": 11.08, "t": "bilmiyorum.", "p": 0}, {"s": 11.08, "e": 12.64, "t": "Harbiden Leopar var he.", "p": 0}, {"s": 12.64, "e": 13.52, "t": "İlk defa Leopar var.", "p": 0}, {"s": 13.52, "e": 15.24, "t": "Bence bu alırız.", "p": 0}, {"s": 16.1, "e": 17.28, "t": "Alsakta bir bok olmaz", "p": 0}, {"s": 17.28, "e": 18.52, "t": "bence hiç.", "p": 0}, {"s": 18.64, "e": 19.5, "t": "Kapibara lan bu.", "p": 0}, {"s": 19.5, "e": 20.52, "t": "Leopar değil bunlar.", "p": 0}, {"s": 20.52, "e": 21.42, "t": "Kapibara bunlar.", "p": 0}, {"s": 21.42, "e": 22.22, "t": "Tamam.", "p": 0}, {"s": 25.31, "e": 25.91, "t": "Kapibara mı öyle?", "p": 0}, {"s": 25.91, "e": 26.81, "t": "Bu olan şey o.", "p": 0}, {"s": 26.81, "e": 27.63, "t": "Çiçek.", "p": 0}]}