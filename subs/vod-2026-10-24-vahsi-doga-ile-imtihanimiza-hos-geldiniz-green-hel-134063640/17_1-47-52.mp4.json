{"speakers": 1, "cues": [{"s": 0.0, "e": 0.58, "t": "Buradalar.", "p": 0}, {"s": 0.58, "e": 1.94, "t": "Tam önümdeler.", "p": 0}, {"s": 1.94, "e": 2.8, "t": "Saldırıyor muyuz?", "p": 0}, {"s": 2.8, "e": 3.94, "t": "Benim yanımda hiçbir şey", "p": 0}, {"s": 3.94, "e": 4.7, "t": "yok yalnız sadece", "p": 0}, {"s": 4.7, "e": 5.98, "t": "yumruklarım var.", "p": 0}, {"s": 5.98, "e": 7.38, "t": "Aynı şekilde.", "p": 0}, {"s": 9.32, "e": 11.1, "t": "Sağ kroşe, sol yumruk.", "p": 0}, {"s": 11.1, "e": 12.16, "t": "O mahveket.", "p": 0}, {"s": 14.53, "e": 16.27, "t": "Musa, şeyi bul.", "p": 0}, {"s": 16.27, "e": 17.55, "t": "Afarkat.", "p": 0}, {"s": 21.66, "e": 24.7, "t": "Jans, Kul, Afarkat, Kul.", "p": 0}, {"s": 26.88, "e": 27.9, "t": "Geliyorum lan.", "p": 0}, {"s": 27.9, "e": 29.06, "t": "Dirile dirile geleceğim.", "p": 0}, {"s": 29.06, "e": 30.94, "t": "Öldürdüm ben galiba.", "p": 0}, {"s": 32.2, "e": 33.56, "t": "Dirile, dirile", "p": 0}, {"s": 33.56, "e": 35.64, "t": "kazanacağız.", "p": 0}, {"s": 44.48, "e": 46.56, "t": "Oha ben ikinciyi öldürdüm", "p": 0}, {"s": 46.56, "e": 48.14, "t": "Ben", "p": 0}, {"s": 52.76, "e": 54.52, "t": "öldüm ölüyorum galiba", "p": 0}]}