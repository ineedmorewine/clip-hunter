{"speakers": 2, "cues": [{"s": 0.0, "e": 0.64, "t": "Buradalar.", "p": 1}, {"s": 0.64, "e": 1.94, "t": "Tam önümdeler.", "p": 1}, {"s": 1.94, "e": 3.02, "t": "Saldırıyor muyuz işte?", "p": 1}, {"s": 3.02, "e": 3.94, "t": "Benim yanımda hiçbir şey", "p": 0}, {"s": 3.94, "e": 4.5, "t": "yok yalnız.", "p": 0}, {"s": 4.5, "e": 6.1, "t": "Sadece yumruklarım var.", "p": 0}, {"s": 6.1, "e": 7.38, "t": "Aynı şekilde.", "p": 1}, {"s": 9.5, "e": 11.08, "t": "Sağ kroşe, sol yumruk.", "p": 1}, {"s": 11.08, "e": 12.28, "t": "O mahvekir.", "p": 1}, {"s": 14.59, "e": 16.31, "t": "Musa, şey bu.", "p": 1}, {"s": 16.69, "e": 17.91, "t": "Afarkat...", "p": 1}, {"s": 21.56, "e": 24.72, "t": "Jans, Kul, Afarkat, Kul.", "p": 1}, {"s": 26.94, "e": 27.9, "t": "Geliyorum lan.", "p": 1}, {"s": 27.9, "e": 29.08, "t": "Dirile dirile geleceğim.", "p": 1}, {"s": 29.08, "e": 30.94, "t": "Öldürdüm ben galiba.", "p": 0}, {"s": 32.3, "e": 33.54, "t": "Dirile, dirile", "p": 1}, {"s": 33.54, "e": 35.6, "t": "kazanacağız.", "p": 1}, {"s": 36.44, "e": 37.98, "t": "Geliyorum lan.", "p": 1}, {"s": 44.46, "e": 46.58, "t": "Oha ben ikinciyi öldürdüm", "p": 0}, {"s": 46.58, "e": 48.12, "t": "Ben", "p": 1}, {"s": 52.74, "e": 54.54, "t": "öldüm ölüyorum galiba", "p": 0}]}