{"speakers": 1, "cues": [{"s": 0.0, "e": 1.02, "t": "Yantımızda hiçbir şey yok", "p": 0}, {"s": 1.02, "e": 1.9, "t": "mu yani?", "p": 0}, {"s": 1.9, "e": 3.64, "t": "Yok hayatım.", "p": 0}, {"s": 4.64, "e": 5.72, "t": "Maşallah ya.", "p": 0}, {"s": 5.72, "e": 6.88, "t": "Donat 'la hep çıkmışız", "p": 0}, {"s": 6.88, "e": 7.74, "t": "yani.", "p": 0}, {"s": 8.06, "e": 9.86, "t": "Neye güveniyorsak.", "p": 0}, {"s": 10.64, "e": 12.44, "t": "Çalmayın diyanalarımı.", "p": 0}, {"s": 13.22, "e": 14.46, "t": "Yuh sana ya.", "p": 0}, {"s": 14.46, "e": 15.7, "t": "Ben öğrettim sana buradan", "p": 0}, {"s": 15.7, "e": 16.84, "t": "bunları almayı.", "p": 0}, {"s": 16.84, "e": 17.08, "t": "Yuh.", "p": 0}, {"s": 17.08, "e": 18.06, "t": "Sen mi öğrettin?", "p": 0}, {"s": 18.06, "e": 18.32, "t": "Evet.", "p": 0}, {"s": 18.32, "e": 20.42, "t": "Gel ipleri al dedim.", "p": 0}, {"s": 20.42, "e": 21.18, "t": "Yeni başladık.", "p": 0}, {"s": 21.18, "e": 22.0, "t": "Bismillah.", "p": 0}]}