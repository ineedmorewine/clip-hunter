{"speakers": 2, "cues": [{"s": 0.0, "e": 0.92, "t": "Oysa yanlış anlama,", "p": 0}, {"s": 0.92, "e": 1.92, "t": "bilinmesi çok zor bir", "p": 0}, {"s": 1.92, "e": 2.82, "t": "şeydir.", "p": 0}, {"s": 3.5, "e": 4.6, "t": "Anime.", "p": 0}, {"s": 4.6, "e": 5.78, "t": "Çok", "p": 0}, {"s": 10.84, "e": 12.1, "t": "fazla anime var ama", "p": 0}, {"s": 12.1, "e": 13.9, "t": "hangisi yani?", "p": 0}, {"s": 15.4, "e": 17.52, "t": "Onu açıklayamadım.", "p": 0}, {"s": 19.99, "e": 21.15, "t": "Kral anime.", "p": 0}, {"s": 31.05, "e": 32.25, "t": "Animelerin çoğu zeytin", "p": 0}, {"s": 32.25, "e": 33.25, "t": "olsa diyet yapıyorlar", "p": 0}, {"s": 33.25, "e": 34.23, "t": "kesin.", "p": 0}, {"s": 37.21, "e": 38.83, "t": "Diyet yapıyorlar kesin", "p": 1}, {"s": 38.83, "e": 39.67, "t": "diyor.", "p": 1}, {"s": 40.57, "e": 42.07, "t": "Kral olabilir.", "p": 0}, {"s": 42.07, "e": 43.11, "t": "Çoğu zeytin anime", "p": 0}, {"s": 43.11, "e": 43.93, "t": "karakterleri de", "p": 0}, {"s": 43.93, "e": 45.69, "t": "animeler değil.", "p": 0}, {"s": 45.71, "e": 47.65, "t": "Ya şu beni", "p": 0}, {"s": 47.65, "e": 49.53, "t": "ilgilendirdi biraz.", "p": 0}, {"s": 53.87, "e": 55.17, "t": "Bir de kırbaç demek", "p": 0}, {"s": 55.17, "e": 56.63, "t": "istiyorum ama.", "p": 0}, {"s": 59.14, "e": 60.38, "t": "Ya çok sağ ol.", "p": 1}, {"s": 60.38, "e": 61.84, "t": "Silah olarak anlatamadım.", "p": 1}, {"s": 61.84, "e": 62.58, "t": "Sen buldun.", "p": 1}, {"s": 62.58, "e": 63.62, "t": "Çok teşekkür ederim.", "p": 1}, {"s": 63.62, "e": 64.66, "t": "Silah.", "p": 1}, {"s": 64.72, "e": 66.1, "t": "Kırbaçla geri geldiğinde", "p": 1}, {"s": 66.1, "e": 66.64, "t": "gerçekten", "p": 1}, {"s": 66.64, "e": 67.44, "t": "silah olarak", "p": 1}, {"s": 67.44, "e": 69.4, "t": "kullanılabilen bir item.", "p": 1}, {"s": 70.08, "e": 70.94, "t": "O ceza", "p": 0}, {"s": 70.94, "e": 71.8, "t": "mayat ne değil mi", "p": 0}, {"s": 71.8, "e": 71.96, "t": "o?", "p": 0}, {"s": 71.96, "e": 72.72, "t": "Ödül amaç değil", 