{"speakers": 2, "cues": [{"s": 0.0, "e": 1.04, "t": "sayı ile belirt o", "p": 0}, {"s": 1.04, "e": 2.98, "t": "zaman hayır yazının", "p": 1}, {"s": 2.98, "e": 6.76, "t": "başına rakam koyacağım üç", "p": 0}, {"s": 7.79, "e": 10.25, "t": "takım yazıyor neyse yok", "p": 1}, {"s": 10.25, "e": 10.63, "t": "hayır", "p": 1}, {"s": 10.63, "e": 12.39, "t": "Nis", "p": 0}, {"s": 23.48, "e": 25.08, "t": "Terapaz", "p": 0}, {"s": 27.6, "e": 29.58, "t": "Yenis takım sporu oluyor", "p": 0}, {"s": 29.58, "e": 30.86, "t": "ama ikili oluyor en", "p": 0}, {"s": 30.86, "e": 33.26, "t": "fazla takım nadiren değil", "p": 0}, {"s": 33.26, "e": 33.48, "t": "de", "p": 0}, {"s": 33.48, "e": 36.14, "t": "Takım da diğerlerinden", "p": 0}, {"s": 36.14, "e": 37.14, "t": "bir nebze daha yakın", "p": 0}, {"s": 37.14, "e": 38.12, "t": "olacak", "p": 0}, {"s": 39.74, "e": 42.04, "t": "Servis bir kere", "p": 0}, {"s": 42.04, "e": 43.68, "t": "Şimdi gördüm servis", "p": 0}, {"s": 43.68, "e": 44.94, "t": "Tampon", "p": 0}, {"s": 45.82, "e": 47.34, "t": "Tampon ne alaka", "p": 0}, {"s": 47.34, "e": 50.22, "t": "Pas vardır diyeceğim de", "p": 0}, {"s": 50.22, "e": 51.8, "t": "takımla oynarsam pas olur", "p": 0}, {"s": 51.8, "e": 52.9, "t": "ama bu süper takımla", "p": 0}, {"s": 52.9, "e": 55.76, "t": "pası mantıklı kabı.", "p": 0}, {"s": 55.94, "e": 57.5, "t": "İngiltere ne alaka?", "p": 0}, {"s": 57.5, "e": 58.68, "t": "Wimbledon İngiltere'de", "p": 0}, {"s": 58.68, "e": 59.72, "t": "miydi ya?", "p": 0}, {"s": 59.82, "e": 60.58, "t": "Değil mi?", "p": 0}, {"s": 60.58, "e": 61.68, "t": "Hadi", "p": 0}, {"s": 66.39, "e": 67.63, "t": "bir şansınızı pastan yana", "p": 0}, {"s": 67.63, "e": 68.83, "t": "deneyelim ya.", "p": 0}, {"s": 69.55, "e": 70.53, "t": "Boş.", "p": 0}, {"s": 70.53, "e": 71.81, "t": "Ay bir de tenisin", "p": 0}, {"s": 71.81, "e": 73.09, "t": "başına sayı koyarak", "p": 0}, {"s": 73.09, "e": 74.55, "t": "hangisini bildirin çektim", "p": 0}, {"s": 74.55, "e": 75.61, "t": "anlamadım.", "p": 1}, {"s": 75.61, "e": 77.23, "t": "Bro ben düşündüm biliyor", "p": 0}, {"s": 77.23, "e": 77.55, "t": "musun?", "p": 0}, {"s": 77.55, "e": 78.77, "t": "Bir tenis iki tenis", "p": 0}, {"s": 78.77, "e": 80.01, "t": "ne demek istiyor acaba", "p": 0}, {"s": 80.01, "e": 80.51, "t": "diye de.", "p": 0}, {"s": 80.51, "e": 82.95, "t": "Hoşçakalın.", "p": 0}]}