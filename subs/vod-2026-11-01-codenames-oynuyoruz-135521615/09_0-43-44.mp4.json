{"speakers": 2, "cues": [{"s": 0.0, "e": 1.56, "t": "bak bekle sıra sıra", "p": 1}, {"s": 1.56, "e": 2.02, "t": "gideceğiz", "p": 1}, {"s": 2.02, "e": 2.26, "t": "dur", "p": 1}, {"s": 2.26, "e": 5.26, "t": "şimdi bir tek onunla", "p": 1}, {"s": 5.26, "e": 6.71, "t": "onu nasıl anlatabilirim", "p": 1}, {"s": 9.02, "e": 11.36, "t": "tamam buldum lan", "p": 1}, {"s": 11.36, "e": 12.06, "t": "şimdi", "p": 1}, {"s": 12.06, "e": 13.66, "t": "kalan iki kelimeyi anla", "p": 1}, {"s": 13.66, "e": 14.5, "t": "anlatacağım", "p": 1}, {"s": 14.5, "e": 17.12, "t": "ben şu an beş", "p": 1}, {"s": 17.12, "e": 17.68, "t": "veriyorum", "p": 1}, {"s": 17.68, "e": 18.64, "t": "ama aynen", "p": 1}, {"s": 18.64, "e": 21.74, "t": "tamam önce sen önce", "p": 1}, {"s": 21.74, "e": 24.06, "t": "o ne abi", "p": 0}, {"s": 24.06, "e": 26.26, "t": "böyle bir şey yok", "p": 0}, {"s": 26.26, "e": 27.34, "t": "yalnız", "p": 1}, {"s": 34.32, "e": 36.74, "t": "Çok hak etti", "p": 1}, {"s": 36.74, "e": 41.38, "t": "Ya gerçekten", "p": 1}, {"s": 43.88, "e": 45.64, "t": "Diğer kelimelere", "p": 1}, {"s": 45.64, "e": 46.12, "t": "bakmıyorsun", "p": 0}, {"s": 46.12, "e": 47.64, "t": "Göbek değil", "p": 1}, {"s": 47.64, "e": 48.64, "t": "Allah aşkına", "p": 1}, {"s": 48.64, "e": 49.88, "t": "Göbek deyince ne var", "p": 1}, {"s": 49.88, "e": 50.2, "t": "burada", "p": 1}, {"s": 50.2, "e": 52.08, "t": "Göbek deliği var", "p": 0}, {"s": 52.08, "e": 54.7, "t": "Bu bir mısır deyince", "p": 1}, {"s": 54.7, "e": 55.56, "t": "Mısır", "p": 1}, {"s": 55.56, "e": 57.56, "t": "Yük, piramit var.", "p": 0}, {"s": 57.56, "e": 59.62, "t": "Ha, başka mısır, mısır,", "p": 1}, {"s": 59.62, "e": 60.82, "t": "mısır ekmeği, mısır,", "p": 1}, {"s": 60.82, "e": 61.94, "t": "mısır, mısır.", "p": 1}, {"s": 61.94, "e": 63.52, "t": "Allah cezanı versin, yük", "p": 0}, {"s": 63.52, "e": 64.7, "t": "diyor ya.", "p": 0}, {"s": 68.05, "e": 69.11, "t": "Allah 'a, tek bir", "p": 0}, {"s": 69.11, "e": 70.33, "t": "tek atıyor.", "p": 0}, {"s": 71.59, "e": 73.01, "t": "Palet gelmez insanın", "p": 0}, {"s": 73.01, "e": 73.65, "t": "aklına bu arada.", "p": 0}, {"s": 73.65, "e": 74.51, "t": "Yük palet, abi, yük", "p": 0}, {"s": 74.51, "e": 75.13, "t": "palet.", "p": 0}, {"s": 75.13, "e": 75.97, "t": "Palet 'i yük yık", "p": 0}, {"s": 75.97, "e": 76.77, "t": "diyor lan.", "p": 0}, {"s": 76.77, "e": 78.43, "t": "Şey yani, harbiden güzel", "p": 0}, {"s": 78.43, "e": 79.49, "t": "diyor bu arada.", "p": 0}, {"s": 79.49, "e": 80.29, "t": "He de,", "p": 0}, {"s": 80.53, "e": 82.51, "t": "kanatta patlarmışsın ama.", "p": 0}, {"s": 82.75, "e": 83.67, "t": "Evet, kan.", "p": 0}]}