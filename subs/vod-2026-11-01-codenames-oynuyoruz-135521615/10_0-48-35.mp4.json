{"speakers": 2, "cues": [{"s": 0.0, "e": 1.76, "t": "Bence yapar bizim Faysal", "p": 0}, {"s": 1.76, "e": 2.56, "t": "ya", "p": 0}, {"s": 3.84, "e": 4.8, "t": "Mutfak", "p": 0}, {"s": 6.97, "e": 8.29, "t": "Mutfak", "p": 0}, {"s": 9.93, "e": 11.79, "t": "Nişan", "p": 0}, {"s": 11.87, "e": 13.15, "t": "Yatak", "p": 0}, {"s": 13.53, "e": 13.89, "t": "Etiket", "p": 0}, {"s": 13.89, "e": 15.25, "t": "Beyaz", "p": 0}, {"s": 15.25, "e": 16.91, "t": "Beyaz eşya olabilir", "p": 0}, {"s": 26.87, "e": 28.19, "t": "Izgara", "p": 0}, {"s": 28.57, "e": 29.23, "t": "Izgara var değil mi", "p": 0}, {"s": 29.23, "e": 30.13, "t": "o zaman", "p": 0}, {"s": 31.98, "e": 33.1, "t": "Yani ben sana hiçbir", "p": 0}, {"s": 33.1, "e": 34.4, "t": "şey demiyorum artık abi", "p": 0}, {"s": 34.4, "e": 35.54, "t": "Çok iyiydi ya", "p": 0}, {"s": 35.54, "e": 36.76, "t": "Hiçbir şey yok abi", "p": 0}, {"s": 36.76, "e": 38.66, "t": "Ağızdan gelir falan büyük", "p": 0}, {"s": 38.66, "e": 38.82, "t": "ne?", "p": 0}, {"s": 38.82, "e": 39.44, "t": "Ağız var.", "p": 0}, {"s": 39.44, "e": 41.88, "t": "Ağızı kodlanıp", "p": 0}, {"s": 43.39, "e": 44.47, "t": "bıçaklar.", "p": 0}, {"s": 44.47, "e": 45.59, "t": "Çok bağırıp seni dövmek", "p": 0}, {"s": 45.59, "e": 46.57, "t": "istiyorum biliyor musun?", "p": 0}, {"s": 46.57, "e": 47.55, "t": "Böyle bağıra bağıra nasıl", "p": 0}, {"s": 47.55, "e": 49.01, "t": "bunu göremiyorsun diye", "p": 0}, {"s": 49.01, "e": 49.91, "t": "yani.", "p": 0}, {"s": 50.13, "e": 51.37, "t": "Ne?", "p": 0}, {"s": 51.73, "e": 53.21, "t": "Kardeşim alttan okumaya", "p": 0}, {"s": 53.21, "e": 54.31, "t": "başladın direk beyaza", "p": 0}, {"s": 54.31, "e": 55.35, "t": "tıkladın yani.", "p": 0}]}