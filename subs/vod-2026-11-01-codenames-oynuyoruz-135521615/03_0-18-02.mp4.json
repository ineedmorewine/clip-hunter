{"speakers": 2, "cues": [{"s": 0.05, "e": 1.79, "t": "Hımm hızlıca.", "p": 0}, {"s": 1.79, "e": 3.79, "t": "Bu mutfak robotu var.", "p": 0}, {"s": 4.11, "e": 5.71, "t": "Hızlıca şeyler.", "p": 0}, {"s": 6.27, "e": 7.77, "t": "Sus, tepki verme öyle", "p": 0}, {"s": 7.77, "e": 8.91, "t": "hile oluyor.", "p": 0}, {"s": 10.05, "e": 11.75, "t": "Robot simit.", "p": 0}, {"s": 12.17, "e": 13.51, "t": "Yişeklerine de geçer bu", "p": 0}, {"s": 13.51, "e": 14.53, "t": "aburdan.", "p": 0}, {"s": 14.57, "e": 16.17, "t": "Mutfakta baklava olur ama", "p": 0}, {"s": 16.17, "e": 17.67, "t": "baklava değildir.", "p": 0}, {"s": 18.29, "e": 20.13, "t": "Satır olur mutfakta.", "p": 0}, {"s": 20.13, "e": 21.29, "t": "Elliven de olur.", "p": 0}, {"s": 21.29, "e": 22.77, "t": "Ama bu elliven değildir.", "p": 0}, {"s": 22.77, "e": 24.37, "t": "Göz kararı malzeme", "p": 0}, {"s": 24.37, "e": 25.43, "t": "koyarsın.", "p": 0}, {"s": 26.53, "e": 27.29, "t": "Göz...", "p": 0}, {"s": 27.29, "e": 29.63, "t": "Oğlum ben senin şeyin", "p": 0}, {"s": 29.63, "e": 30.97, "t": "etmeyi saçma.", "p": 0}, {"s": 31.61, "e": 33.13, "t": "Satır, boğaz, simit", "p": 0}, {"s": 33.13, "e": 33.93, "t": "arasındayız.", "p": 0}, {"s": 33.93, "e": 35.81, "t": "Simit mutfakta saçma.", "p": 0}, {"s": 36.43, "e": 37.79, "t": "Mutfakta satır olur", "p": 0}, {"s": 37.79, "e": 38.79, "t": "abiciğim.", "p": 0}, {"s": 39.67, "e": 40.57, "t": "Şansa bulmuş da", "p": 0}, {"s": 40.57, "e": 41.73, "t": "olabiliriz.", "p": 0}, {"s": 45.3, "e": 46.64, "t": "Boğaz, boğazını da", "p": 0}, {"s": 46.64, "e": 48.6, "t": "doyurursun ya mutfakta.", "p": 0}, {"s": 54.68, "e": 56.3, "t": "Allah razı olsun.", "p": 0}, {"s": 56.64, "e": 57.7, "t": "Ne bileyim.", "p": 0}]}