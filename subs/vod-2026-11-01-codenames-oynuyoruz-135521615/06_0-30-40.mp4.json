{"speakers": 2, "cues": [{"s": 2.04, "e": 3.4, "t": "Güreş", "p": 1}, {"s": 5.86, "e": 8.14, "t": "Güreşmek yürek ister mi?", "p": 1}, {"s": 8.76, "e": 10.92, "t": "Ayakla yapılır güreş", "p": 1}, {"s": 12.85, "e": 14.43, "t": "Elleri yedin", "p": 0}, {"s": 14.43, "e": 16.69, "t": "Ayak güreşi hiç de", "p": 0}, {"s": 16.69, "e": 17.77, "t": "böyle bir şey yok", "p": 1}, {"s": 17.77, "e": 18.97, "t": "Ayak güreşi diye bir", "p": 0}, {"s": 18.97, "e": 19.81, "t": "şey var bu arada", "p": 0}, {"s": 19.81, "e": 21.13, "t": "Ama ben öyle", "p": 0}, {"s": 21.13, "e": 21.91, "t": "düşünmemiştim", "p": 0}, {"s": 21.91, "e": 23.69, "t": "Yani güreşte ayağı", "p": 0}, {"s": 23.69, "e": 25.51, "t": "seçmeni bekliyordum ama", "p": 0}, {"s": 25.71, "e": 27.35, "t": "Bu şekilde değil", "p": 1}, {"s": 27.35, "e": 29.09, "t": "Bu şekilde değildi", "p": 1}, {"s": 29.09, "e": 29.79, "t": "Ayak güreşini", "p": 0}, {"s": 29.79, "e": 31.53, "t": "tekvandocular yapar", "p": 0}, {"s": 32.19, "e": 33.57, "t": "festival değil mi?", "p": 1}, {"s": 33.57, "e": 35.17, "t": "Güreş Festivali, Edirne,", "p": 1}, {"s": 35.17, "e": 35.71, "t": "Tava Ciğeri", "p": 1}, {"s": 35.71, "e": 36.87, "t": "Festivali falan.", "p": 1}, {"s": 36.87, "e": 38.51, "t": "Uf ciğer çekti canım.", "p": 1}, {"s": 40.6, "e": 41.56, "t": "Dedim.", "p": 1}, {"s": 42.02, "e": 43.58, "t": "Allah razı olsun.", "p": 0}, {"s": 47.67, "e": 48.77, "t": "Astı faysa.", "p": 0}, {"s": 48.77, "e": 50.39, "t": "Masa güreşi mi?", "p": 1}, {"s": 50.49, "e": 51.89, "t": "Elde güreş masada", "p": 1}, {"s": 51.89, "e": 52.53, "t": "yapılır.", "p": 1}, {"s": 52.53, "e": 53.75, "t": "Masa kemirmekten de", "p": 1}, {"s": 53.75, "e": 54.37, "t": "gidebilirdim", "p": 1}, {"s": 54.37, "e": 55.13, "t": "oraya gerçi.", "p": 1}, {"s": 55.13, "e": 55.83, "t": "Neyse.", "p": 1}]}