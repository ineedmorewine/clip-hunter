{"speakers": 2, "cues": [{"s": 0.62, "e": 2.22, "t": "Bunsa sonra bana kızıyor.", "p": 0}, {"s": 2.22, "e": 3.7, "t": "Şöyle başlayalım.", "p": 1}, {"s": 3.92, "e": 5.38, "t": "Bu tek kelime mi", "p": 0}, {"s": 5.38, "e": 6.28, "t": "hoca?", "p": 0}, {"s": 7.08, "e": 7.96, "t": "CS2.", "p": 0}, {"s": 7.96, "e": 9.34, "t": "Böyle bir şey yok.", "p": 0}, {"s": 9.34, "e": 10.74, "t": "Elendim bu arada.", "p": 0}, {"s": 10.98, "e": 12.52, "t": "Evet yani.", "p": 0}, {"s": 12.52, "e": 13.92, "t": "Oğlum ne yazıyım?", "p": 1}, {"s": 13.92, "e": 15.0, "t": "Counter yazsam ne", "p": 1}, {"s": 15.0, "e": 16.04, "t": "değişecekti ki?", "p": 1}, {"s": 16.04, "e": 17.06, "t": "CS2 yazdım.", "p": 1}, {"s": 17.06, "e": 19.4, "t": "Counter yazsam kuralları", "p": 0}, {"s": 19.4, "e": 20.68, "t": "çiğnemiyordum mesela ve", "p": 0}, {"s": 20.68, "e": 21.9, "t": "bilmiştim.", "p": 0}, {"s": 22.46, "e": 23.46, "t": "Bu da birleşik tek", "p": 1}, {"s": 23.46, "e": 24.12, "t": "bir kelime.", "p": 1}, {"s": 24.12, "e": 25.78, "t": "CS2 diye söyleniyor.", "p": 1}, {"s": 25.78, "e": 27.04, "t": "Allah yazsın geçsin o", "p": 0}, {"s": 27.04, "e": 27.68, "t": "zaman bu ne yapın", "p": 0}, {"s": 27.68, "e": 28.26, "t": "CS2.", "p": 0}, {"s": 28.26, "e": 30.5, "t": "Tamam canım.", "p": 1}, {"s": 30.5, "e": 31.5, "t": "O zaman yani", "p": 0}, {"s": 31.5, "e": 33.88, "t": "CS deseydim okey miydi?", "p": 1}, {"s": 33.88, "e": 35.36, "t": "İki mi sıkıntı?", "p": 1}, {"s": 35.36, "e": 36.28, "t": "Hayır.", "p": 0}, {"s": 36.28, "e": 37.7, "t": "Mesela şöyle düşün.", "p": 0}, {"s": 37.7, "e": 39.02, "t": "Atıyorum anlatacağım", "p": 0}, {"s": 39.02, "e": 40.88, "t": "kelime bomba tamam mı?", "p": 0}, {"s": 40.88, "e": 43.58, "t": "İçinde bomba imha ekibi", "p": 0}, {"s": 43.58, "e": 45.4, "t": "anlamı taşıyan bir tane", "p": 0}, {"s": 45.4, "e": 46.0, "t": "kısaltma", "p": 0}, {"s": 46.0, "e": 46.7, "t": "yazayım buraya.", "p": 0}, {"s": 46.7, "e": 47.88, "t": "Herkes oradaki kelimeleri", "p": 0}, {"s": 47.88, "e": 49.96, "t": "seçsin seçsin kullansın.", "p": 0}, {"s": 50.26, "e": 51.3, "t": "Süren doluyor.", "p": 1}, {"s": 51.3, "e": 51.88, "t": "Hadi seç.", "p": 1}, {"s": 51.88, "e": 52.66, "t": "Tamam.", "p": 1}, {"s": 58.54, "e": 59.92, "t": "Şimdi bizde mi?", "p": 0}, {"s": 60.46, "e": 62.62, "t": "Sen de işaretle.", "p": 0}, {"s": 63.94, "e": 65.38, "t": "Olum", "p": 1}, {"s": 65.38, "e": 67.3, "t": "Tüh ya bunlarımmış", "p": 0}, {"s": 67.84, "e": 70.06, "t": "Hadi faysal siktik siktik", "p": 0}, {"s": 70.06, "e": 72.3, "t": "Sikemedik yedik yani nani", "p": 0}]}