{"speakers": 2, "cues": [{"s": 0.0, "e": 2.48, "t": "Lan yapı ne?", "p": 0}, {"s": 2.48, "e": 3.48, "t": "Duvar mı?", "p": 0}, {"s": 3.98, "e": 6.02, "t": "Lan temel varsa duvar", "p": 0}, {"s": 6.02, "e": 6.9, "t": "da orada.", "p": 0}, {"s": 6.92, "e": 8.34, "t": "Duvar olsa başka bir", "p": 0}, {"s": 8.34, "e": 9.68, "t": "şey yazarım ya.", "p": 0}, {"s": 9.68, "e": 11.42, "t": "Ya duvar taşıyayım oğlum.", "p": 0}, {"s": 11.42, "e": 12.38, "t": "Yardımcı olmuyor", "p": 0}, {"s": 12.38, "e": 13.48, "t": "gerçekten yardımcı.", "p": 0}, {"s": 13.48, "e": 14.76, "t": "Bu arada Musay kusura", "p": 0}, {"s": 14.76, "e": 15.72, "t": "bakma.", "p": 0}, {"s": 15.72, "e": 17.18, "t": "Adam haklı var.", "p": 0}, {"s": 17.18, "e": 19.18, "t": "Adam harbi haklı lan.", "p": 0}, {"s": 21.8, "e": 23.74, "t": "Belli bak temel piramit", "p": 0}, {"s": 23.74, "e": 25.34, "t": "bundan uzak dur Buse.", "p": 0}, {"s": 25.34, "e": 27.18, "t": "Stadyumdan uzak dur.", "p": 0}, {"s": 27.64, "e": 29.32, "t": "Bende bu duvarda baysalak", "p": 0}, {"s": 29.32, "e": 30.3, "t": "kelimelerini söylemiş", "p": 0}, {"s": 30.3, "e": 31.18, "t": "bulundum.", "p": 0}, {"s": 31.76, "e": 32.96, "t": "Sandalyeden uzak dur bir", "p": 0}, {"s": 32.96, "e": 33.78, "t": "de sandalye de bir", "p": 0}, {"s": 33.78, "e": 35.26, "t": "yapıdır Faysal.", "p": 0}, {"s": 35.9, "e": 37.68, "t": "Bilmem bilir misin?", "p": 0}, {"s": 37.7, "e": 39.38, "t": "Bunu yazsam...", "p": 1}]}