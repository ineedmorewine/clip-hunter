{"speakers": 2, "cues": [{"s": 3.98, "e": 5.28, "t": "Allah.", "p": 1}, {"s": 5.28, "e": 6.32, "t": "Valla ben.", "p": 1}, {"s": 6.32, "e": 7.16, "t": "5, 4,", "p": 1}, {"s": 7.16, "e": 9.24, "t": "3, 2, tabuk.", "p": 0}, {"s": 9.24, "e": 10.04, "t": "Bitti.", "p": 0}, {"s": 10.04, "e": 11.14, "t": "Tabuk mu?", "p": 0}, {"s": 11.54, "e": 12.46, "t": "Kesim.", "p": 0}, {"s": 12.46, "e": 14.28, "t": "İnşallah tahmin ettiğime", "p": 1}, {"s": 14.28, "e": 15.54, "t": "gitmezsin.", "p": 1}, {"s": 15.78, "e": 17.6, "t": "Dedin ve gittin abi.", "p": 1}, {"s": 19.68, "e": 22.7, "t": "Kare kesim, makas.", "p": 1}, {"s": 22.7, "e": 24.46, "t": "Gölge keser, gölge", "p": 1}, {"s": 24.46, "e": 25.88, "t": "kesilir dedim.", "p": 1}, {"s": 25.88, "e": 27.0, "t": "Daha iyiye nasıl", "p": 1}, {"s": 27.0, "e": 27.96, "t": "gidecektin bilmiyorum", "p": 1}, {"s": 27.96, "e": 28.52, "t": "ama.", "p": 1}, {"s": 28.52, "e": 30.48, "t": "yani Allah aşkına şu", "p": 1}, {"s": 30.48, "e": 31.14, "t": "dört kelimeye", "p": 1}, {"s": 31.14, "e": 32.4, "t": "bakıp dört kelimeyi tek", "p": 1}, {"s": 32.4, "e": 32.62, "t": "bir", "p": 1}, {"s": 32.62, "e": 34.08, "t": "kelimede bana birleştirir", "p": 1}, {"s": 34.08, "e": 34.5, "t": "misin?", "p": 1}, {"s": 34.5, "e": 34.9, "t": "Makas,", "p": 1}, {"s": 34.9, "e": 36.42, "t": "gölge, dahi, kare.", "p": 1}, {"s": 36.58, "e": 38.18, "t": "Yani kesin demez mi?", "p": 0}, {"s": 38.18, "e": 38.98, "t": "Birleştiriyorum.", "p": 0}, {"s": 38.98, "e": 40.08, "t": "Hazır mısın?", "p": 0}, {"s": 40.08, "e": 41.16, "t": "Hazırım.", "p": 1}, {"s": 41.16, "e": 42.28, "t": "Hacıivat.", "p": 0}, {"s": 43.6, "e": 45.1, "t": "Makas, o stadyum", "p": 1}, {"s": 45.1, "e": 47.08, "t": "işaretlerdi ki o zaman.", "p": 1}, {"s": 48.33, "e": 49.87, "t": "Hacıivat 'la stadyumun ne", "p": 0}, {"s": 49.87, "e": 51.13, "t": "alakası var?", "p": 0}, {"s": 52.78, "e": 54.94, "t": "Faysal işaretlerdi.", "p": 1}, {"s": 55.92, "e": 57.9, "t": "Gösteri yaparlardı.", "p": 0}, {"s": 57.9, "e": 59.06, "t": "Stadyumda gösteri", "p": 1}, {"s": 59.06, "e": 59.14, "t": "yapabilirdi.", "p": 1}, {"s": 59.14, "e": 59.62, "t": "Hacıivat yazarak gölgeyi", "p": 1}, {"s": 59.62, "e": 60.52, "t": "ve kareyi kesin", "p": 0}, {"s": 60.52, "e": 61.68, "t": "bildirirdi.", "p": 0}, {"s": 62.06, "e": 64.54, "t": "Kareyi anlar mıydı?", "p": 1}, {"s": 65.78, "e": 67.28, "t": "Dahin atanmayacak.", "p": 1}, {"s": 67.28, "e": 68.02, "t": "Neydi?", "p": 0}, {"s": 68.02, "e": 69.52, "t": "Bak şimdi,", "p": 0}, {"s": 69.52, "e": 70.4, "t": "Karajon salak olan", "p": 0}, {"s": 70.4, "e": 72.04, "t": "karakter tamam mı?", "p": 0}, {"s": 72.1, "e": 73.94, "t": "Neden Hacıvat 'ı yazmış", "p": 0}, {"s": 73.94, "e": 74.92, "t": "diye düşünüyorum.", "p": 0}, {"s": 74.92, "e": 75.98, "t": "Zeki 'yi oradan...", "p": 1}]}