{"speakers": 2, "cues": [{"s": 0.0, "e": 1.96, "t": "Vuh, hayalet.", "p": 0}, {"s": 2.14, "e": 5.16, "t": "Adadan iki ada var.", "p": 1}, {"s": 5.44, "e": 6.7, "t": "Bulursun.", "p": 0}, {"s": 6.7, "e": 8.92, "t": "Dalina, dalina diyorum", "p": 0}, {"s": 8.92, "e": 9.78, "t": "ya.", "p": 0}, {"s": 11.69, "e": 13.09, "t": "Ada.", "p": 0}, {"s": 13.83, "e": 15.55, "t": "Adada dans edersin falan", "p": 0}, {"s": 15.55, "e": 16.23, "t": "geliyor.", "p": 0}, {"s": 16.23, "e": 17.41, "t": "Kıbrıs gibi.", "p": 1}, {"s": 19.08, "e": 20.22, "t": "Kıbrıs gibi.", "p": 0}, {"s": 20.22, "e": 21.6, "t": "Yuh artık.", "p": 0}, {"s": 22.5, "e": 24.16, "t": "Coğrafi bilgi vermek", "p": 1}, {"s": 24.16, "e": 25.62, "t": "zorundaydım.", "p": 1}, {"s": 26.18, "e": 27.1, "t": "Everest mi?", "p": 0}, {"s": 27.1, "e": 28.42, "t": "Allah kahveri.", "p": 1}, {"s": 29.82, "e": 30.74, "t": "Oğlum lan.", "p": 0}, {"s": 30.74, "e": 32.08, "t": "Oğlum ilgiler et.", "p": 0}, {"s": 32.08, "e": 34.98, "t": "İngiltere bir ada ülkesi,", "p": 1}, {"s": 34.98, "e": 37.1, "t": "İngiltere bir ada ülkesi", "p": 1}, {"s": 37.1, "e": 39.24, "t": "ona rağmen ama orada", "p": 1}, {"s": 39.24, "e": 41.28, "t": "Everest bir dağ değil", "p": 1}, {"s": 41.28, "e": 42.0, "t": "mi?", "p": 1}]}