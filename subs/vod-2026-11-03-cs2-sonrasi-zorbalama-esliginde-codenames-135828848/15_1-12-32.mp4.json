{"speakers": 1, "cues": [{"s": 1.65, "e": 2.73, "t": "Ya ben bu çocuğun", "p": 0}, {"s": 2.73, "e": 4.01, "t": "kafasını açıp incelemek", "p": 0}, {"s": 4.01, "e": 5.05, "t": "istiyorum ya.", "p": 0}, {"s": 5.05, "e": 6.33, "t": "Abi bir dakika, A101", "p": 0}, {"s": 6.33, "e": 7.63, "t": "tabii ki de pirinç", "p": 0}, {"s": 7.63, "e": 8.61, "t": "bu arada.", "p": 0}, {"s": 8.61, "e": 9.85, "t": "A101 diye bir kelime", "p": 0}, {"s": 9.85, "e": 11.11, "t": "veremezsin bu arada.", "p": 0}, {"s": 11.11, "e": 12.87, "t": "A101 tekil neyse şimdi.", "p": 0}, {"s": 12.87, "e": 14.35, "t": "Ya aşkım ne alakası", "p": 0}, {"s": 14.35, "e": 14.75, "t": "var?", "p": 0}, {"s": 14.75, "e": 16.49, "t": "Migros demek gibi, işte", "p": 0}, {"s": 16.49, "e": 17.65, "t": "Bim demek gibi bir", "p": 0}, {"s": 17.65, "e": 18.19, "t": "şey.", "p": 0}, {"s": 18.19, "e": 19.19, "t": "Musa, Musa çok iyi", "p": 0}, {"s": 19.19, "e": 20.57, "t": "kelime veriyorum.", "p": 0}, {"s": 21.01, "e": 22.57, "t": "Sendeyiz babuş.", "p": 0}, {"s": 23.86, "e": 24.68, "t": "Lütfen yani.", "p": 0}, {"s": 24.68, "e": 26.1, "t": "Bu olduğunu düşünüyorum,", "p": 0}, {"s": 26.1, "e": 27.94, "t": "bu olduğunu düşünüyorum.", "p": 0}, {"s": 30.12, "e": 32.16, "t": "Londra köprüsü yıkılıyor,", "p": 0}, {"s": 32.16, "e": 34.02, "t": "yıkılıyor, yıkılıyor.", "p": 0}, {"s": 34.02, "e": 35.64, "t": "Bukadra'da yağmur", "p": 0}, {"s": 35.64, "e": 37.64, "t": "işareti.", "p": 0}, {"s": 38.89, "e": 41.23, "t": "Yağmur da olabilir evet.", "p": 0}, {"s": 43.25, "e": 45.01, "t": "Çıldıracağım ya.", "p": 0}, {"s": 45.31, "e": 47.45, "t": "Şundan eminiz.", "p": 0}, {"s": 48.11, "e": 50.23, "t": "Şundan eminiz.", "p": 0}, {"s": 52.2, "e": 53.96, "t": "Acaba Londra derken diğer", "p": 0}, {"s": 53.96, "e": 55.44, "t": "şehri mi örnek verdi?", "p": 0}, {"s": 55.44, "e": 56.72, "t": "Yoksa Londra 'nın yağmuru", "p": 0}, {"s": 56.72, "e": 57.82, "t": "taşlıdır mı demek", "p": 0}, {"s": 57.82, "e": 58.82, "t": "istedim?", "p": 0}, {"s": 58.82, "e": 60.54, "t": "Önce bunu deneyelim.", "p": 0}, {"s": 61.54, "e": 62.84, "t": "Buymuş.", "p": 0}, {"s": 62.84, "e": 64.3, "t": "Faysal A101 'i aklında", "p": 0}, {"s": 64.3, "e": 65.22, "t": "tut.", "p": 0}, {"s": 65.56, "e": 66.72, "t": "Tamam mı?", "p": 0}, {"s": 66.72, "e": 68.94, "t": "Bak iki tane oradan", "p": 0}, {"s": 68.94, "e": 70.28, "t": "vardı, gittin pirinç", "p": 0}, {"s": 70.28, "e": 71.74, "t": "işaretledin.", "p": 0}, {"s": 73.02, "e": 73.66, "t": "Tamam mı?", "p": 0}, {"s": 73.66, "e": 75.58, "t": "A102 aklımdan.", "p": 0}, {"s": 75.58, "e": 76.86, "t": "Bir şey söyleyeceğim.", "p": 0}]}