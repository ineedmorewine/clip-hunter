{"speakers": 2, "cues": [{"s": 1.6, "e": 3.04, "t": "Neyi güldüğünü anladım", "p": 0}, {"s": 3.04, "e": 3.82, "t": "lanet olsun.", "p": 0}, {"s": 3.82, "e": 5.46, "t": "Ben direkt çeyizince", "p": 1}, {"s": 5.46, "e": 6.64, "t": "direkt kırbaca gittim", "p": 1}, {"s": 6.64, "e": 7.56, "t": "çünkü.", "p": 0}, {"s": 7.56, "e": 8.66, "t": "Allah senin cezanı", "p": 0}, {"s": 8.66, "e": 9.6, "t": "veriyorsun.", "p": 1}, {"s": 13.98, "e": 15.84, "t": "O da olabilir.", "p": 1}, {"s": 16.64, "e": 18.42, "t": "Sus Allah aşkına.", "p": 0}, {"s": 18.64, "e": 20.32, "t": "Çamaşır olabilir.", "p": 1}, {"s": 20.32, "e": 21.68, "t": "Bu yönlendirme amaçlı", "p": 0}, {"s": 21.68, "e": 22.34, "t": "değil bu arada.", "p": 0}, {"s": 22.34, "e": 23.74, "t": "Olabilir gerçekten evet.", "p": 0}, {"s": 23.74, "e": 26.38, "t": "Ben şeyleri öğretmenim.", "p": 1}, {"s": 26.38, "e": 27.76, "t": "Benim çeyizimde var", "p": 0}, {"s": 27.76, "e": 28.54, "t": "mesela.", "p": 0}, {"s": 28.54, "e": 29.14, "t": "Değil mi?", "p": 1}, {"s": 29.14, "e": 29.78, "t": "Bence de olmalı.", "p": 1}, {"s": 29.78, "e": 31.1, "t": "Oradan havlamasın diye", "p": 0}, {"s": 31.1, "e": 32.28, "t": "söylüyorum.", "p": 0}, {"s": 32.92, "e": 34.76, "t": "kese olabilir", "p": 0}, {"s": 35.2, "e": 37.04, "t": "kese değil de", "p": 1}, {"s": 38.52, "e": 39.66, "t": "ekmek olur", "p": 0}, {"s": 39.66, "e": 41.74, "t": "şans olur biraz", "p": 0}, {"s": 41.74, "e": 42.7, "t": "baya", "p": 0}, {"s": 43.26, "e": 44.98, "t": "yalandan bir kitap olur", "p": 0}, {"s": 44.98, "e": 46.48, "t": "bomba olur", "p": 0}, {"s": 46.48, "e": 48.28, "t": "çamaşır bir seçeyim mi", "p": 1}, {"s": 48.28, "e": 48.84, "t": "ya acaba", "p": 1}, {"s": 48.84, "e": 50.48, "t": "umarım", "p": 1}, {"s": 50.48, "e": 51.78, "t": "çeyiz içeriğini", "p": 1}, {"s": 51.78, "e": 53.0, "t": "biliyorsundur hayatım", "p": 1}, {"s": 53.0, "e": 53.4, "t": "çünkü", "p": 1}, {"s": 53.4, "e": 55.54, "t": "ooo ekşiye doğru", "p": 0}, {"s": 55.54, "e": 56.42, "t": "gidiyorsunuz ekşiye", "p": 0}, {"s": 56.42, "e": 56.88, "t": "düştünüz", "p": 0}, {"s": 56.88, "e": 57.94, "t": "mükemmel", "p": 0}, {"s": 57.94, "e": 59.68, "t": "hiç çamaşır oluyordu", "p": 1}, {"s": 59.68, "e": 60.68, "t": "tamam çok şükür", "p": 1}, {"s": 60.68, "e": 61.58, "t": "Bir diğer kırbaç", "p": 1}, {"s": 61.58, "e": 62.32, "t": "çekeceğim.", "p": 1}, {"s": 62.32, "e": 63.38, "t": "Oğlumu dinliyosundur", "p": 0}, {"s": 63.38, "e": 64.44, "t": "dendi bana ya.", "p": 0}, {"s": 64.44, "e": 65.72, "t": "Ben çocukken bunlar benim", "p": 0}, {"s": 65.72, "e": 66.64, "t": "cevizlerim değil.", "p": 0}, {"s": 66.64, "e": 67.4, "t": "Ya kırbaçını iyi", "p": 0}, {"s": 67.4, "e": 68.02, "t": "işaretliyorsun.", "p": 0}, {"s": 68.02, "e": 68.72, "t": "Ah.", "p": 0}, {"s": 68.72, "e": 69.7, "t": "Değilmiş.", "p": 1}, {"s": 69.7, "e": 70.96, "t": "Sen kötü bir oyuncusun", "p": 0}, {"s": 70.96, "e": 71.4, "t": "bu arada.", "p": 0}, {"s": 71.4, "e": 72.72, "t": "Ben söyleyeyim sana.", "p": 0}, {"s": 73.92, "e": 74.98, "t": "Bir de bana laf", "p": 0}, {"s": 74.98, "e": 76.06, "t": "sokuyor kendini.", "p": 0}, {"s": 76.06, "e": 77.26, "t": "Sen önce bir önüne", "p": 0}, {"s": 77.26, "e": 78.08, "t": "bak.", "p": 0}, {"s": 78.42, "e": 79.38, "t": "Baktı.", "p": 1}]}