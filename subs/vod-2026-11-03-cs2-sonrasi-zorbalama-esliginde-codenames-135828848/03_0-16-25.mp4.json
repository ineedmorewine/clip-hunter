{"speakers": 2, "cues": [{"s": 0.0, "e": 0.66, "t": "Güzel attın onu", "p": 0}, {"s": 0.66, "e": 1.74, "t": "yanlışlıkla", "p": 0}, {"s": 1.74, "e": 3.5, "t": "Ay bombayı kurmamı", "p": 1}, {"s": 4.66, "e": 5.28, "t": "Eyvah", "p": 0}, {"s": 5.28, "e": 7.36, "t": "Ben bu kurduk sanıyolum", "p": 1}, {"s": 7.36, "e": 8.84, "t": "Bombanın oradadırlar", "p": 0}, {"s": 8.84, "e": 9.76, "t": "zaten", "p": 0}, {"s": 9.76, "e": 11.22, "t": "Lan zaten baysal olduğu", "p": 0}, {"s": 11.22, "e": 11.7, "t": "için", "p": 1}, {"s": 11.7, "e": 12.32, "t": "Evet", "p": 1}, {"s": 12.74, "e": 13.82, "t": "Bombayı ben burada sandım", "p": 0}, {"s": 13.82, "e": 13.92, "t": "ya", "p": 0}, {"s": 13.92, "e": 15.36, "t": "Bomba nerede?", "p": 1}, {"s": 18.68, "e": 21.04, "t": "Abi bombayın kim orada", "p": 1}, {"s": 21.04, "e": 21.68, "t": "düşündü", "p": 0}, {"s": 21.68, "e": 23.22, "t": "Saattir koruyuz biz neyi", "p": 0}, {"s": 23.22, "e": 24.56, "t": "koruyuz ya", "p": 0}, {"s": 25.58, "e": 26.6, "t": "Kaç vurdum sana", "p": 1}, {"s": 26.6, "e": 29.36, "t": "Bende miydi lan yoksa", "p": 0}, {"s": 29.92, "e": 31.4, "t": "En son sarı kimse", "p": 1}, {"s": 31.4, "e": 32.9, "t": "sarı koşuyordu, sarı", "p": 1}, {"s": 32.9, "e": 34.8, "t": "koşuyordu, kimse sarı T", "p": 1}, {"s": 34.8, "e": 36.02, "t": "taraftan koşuyordu, en", "p": 1}, {"s": 36.02, "e": 36.94, "t": "son bombayı ben öyle", "p": 1}, {"s": 36.94, "e": 38.6, "t": "gördüm, harekete açtım.", "p": 1}, {"s": 38.6, "e": 39.8, "t": "Sarı benim, sarı benim,", "p": 0}, {"s": 39.8, "e": 41.2, "t": "ben B'deydim.", "p": 0}, {"s": 43.2, "e": 44.5, "t": "İlk başta B, bende", "p": 1}, {"s": 44.5, "e": 46.1, "t": "bende girdiğim.", "p": 0}, {"s": 46.12, "e": 47.54, "t": "Ne, yayını izleriz ya.", "p": 1}]}