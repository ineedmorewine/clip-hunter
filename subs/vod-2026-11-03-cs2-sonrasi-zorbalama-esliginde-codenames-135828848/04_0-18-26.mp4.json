{"speakers": 2, "cues": [{"s": 0.0, "e": 0.74, "t": "Benim de çok yok", "p": 1}, {"s": 0.74, "e": 1.82, "t": "ama dur.", "p": 1}, {"s": 3.14, "e": 3.94, "t": "Saklan sen.", "p": 0}, {"s": 3.94, "e": 5.4, "t": "Adam çektiği zaman.", "p": 0}, {"s": 7.2, "e": 8.18, "t": "Görsen be kendini, görsen", "p": 0}, {"s": 8.18, "e": 8.9, "t": "be, görsen be, görsen", "p": 0}, {"s": 8.9, "e": 9.38, "t": "be.", "p": 0}, {"s": 9.38, "e": 10.42, "t": "Gelmeyecek be, he, son", "p": 0}, {"s": 10.42, "e": 11.64, "t": "el iş gelecek.", "p": 0}, {"s": 14.32, "e": 15.72, "t": "Yaksana iskeleyi.", "p": 0}, {"s": 16.3, "e": 17.4, "t": "Geldi, geldi, geldi,", "p": 0}, {"s": 17.4, "e": 18.26, "t": "geldi, geldi.", "p": 0}, {"s": 41.92, "e": 43.48, "t": "Klip diye yaşlanmadı.", "p": 0}, {"s": 43.66, "e": 44.74, "t": "Klip al.", "p": 1}]}