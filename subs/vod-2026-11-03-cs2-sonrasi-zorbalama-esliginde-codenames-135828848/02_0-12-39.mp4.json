{"speakers": 2, "cues": [{"s": 6.97, "e": 8.49, "t": "Ya ben adamı vuruyorum", "p": 0}, {"s": 8.49, "e": 9.09, "t": "vuruyorum vuruyorum", "p": 1}, {"s": 9.09, "e": 9.09, "t": "vuruyorum", "p": 1}, {"s": 9.09, "e": 10.39, "t": "Bir yerden vurdu bana,", "p": 1}, {"s": 10.39, "e": 11.99, "t": "nereden vurdu lan bana?", "p": 1}, {"s": 11.99, "e": 13.01, "t": "Midden vurdu.", "p": 0}, {"s": 13.01, "e": 13.89, "t": "İpa var mı usta", "p": 0}, {"s": 13.89, "e": 14.11, "t": "vurdu?", "p": 0}, {"s": 14.11, "e": 15.01, "t": "Kim öldü?", "p": 0}, {"s": 15.01, "e": 16.73, "t": "Abi hiçbir yer yok", "p": 0}, {"s": 16.73, "e": 17.77, "t": "şu an.", "p": 0}, {"s": 17.81, "e": 18.53, "t": "Çıkmıyor.", "p": 1}, {"s": 18.53, "e": 19.37, "t": "Ya slow 'a bak", "p": 0}, {"s": 19.37, "e": 21.55, "t": "ya Allah kahretsin ya.", "p": 0}, {"s": 24.03, "e": 24.93, "t": "Arkadan geliyor arkadan", "p": 0}, {"s": 24.93, "e": 25.81, "t": "gidiyor.", "p": 0}, {"s": 25.95, "e": 26.89, "t": "Mid var hala, bursa", "p": 0}, {"s": 26.89, "e": 27.77, "t": "dikkat.", "p": 0}, {"s": 27.77, "e": 29.61, "t": "Bursa bomba söndürdü.", "p": 0}, {"s": 29.61, "e": 31.37, "t": "As siktir.", "p": 1}, {"s": 31.43, "e": 33.09, "t": "Aaa gördüm!", "p": 1}, {"s": 33.09, "e": 33.65, "t": "Gördüm!", "p": 1}, {"s": 33.65, "e": 35.15, "t": "Bu", "p": 0}, {"s": 36.5, "e": 37.82, "t": "sorun bir canın var.", "p": 0}, {"s": 38.1, "e": 39.22, "t": "Kaçtım.", "p": 1}, {"s": 39.4, "e": 40.22, "t": "Kaçtım.", "p": 1}, {"s": 40.22, "e": 41.8, "t": "Koş koş koş.", "p": 1}, {"s": 43.48, "e": 44.58, "t": "Klip al.", "p": 1}]}