{"speakers": 1, "cues": [{"s": 6.99, "e": 8.51, "t": "Ya ben adamı vuruyom", "p": 0}, {"s": 8.51, "e": 9.09, "t": "vuruyom vuruyom", "p": 0}, {"s": 9.09, "e": 10.39, "t": "Bir yerden vurdu bana,", "p": 0}, {"s": 10.39, "e": 11.55, "t": "nerden vurdu lan bana", "p": 0}, {"s": 11.55, "e": 13.65, "t": "Midden vurdu", "p": 0}, {"s": 14.99, "e": 16.55, "t": "Abi hiç bir yer", "p": 0}, {"s": 16.55, "e": 17.77, "t": "yok şu an", "p": 0}, {"s": 17.83, "e": 18.45, "t": "Çıkmıyor", "p": 0}, {"s": 18.45, "e": 19.41, "t": "Ya slow 'a bak", "p": 0}, {"s": 19.41, "e": 21.59, "t": "ya Allah kahretsin ya", "p": 0}, {"s": 23.75, "e": 24.93, "t": "Arkadan geliyor arkadan", "p": 0}, {"s": 24.93, "e": 25.23, "t": "gidiyor", "p": 0}, {"s": 25.23, "e": 26.89, "t": "Mid var hala Bursa", "p": 0}, {"s": 26.89, "e": 27.33, "t": "dikkat", "p": 0}, {"s": 27.33, "e": 29.11, "t": "Bursa bomba söndürdü", "p": 0}, {"s": 29.11, "e": 31.43, "t": "As siktir", "p": 0}, {"s": 31.59, "e": 32.49, "t": "Aaa gördüm", "p": 0}, {"s": 32.49, "e": 33.65, "t": "Gördüm", "p": 0}, {"s": 33.65, "e": 35.15, "t": "Bu", "p": 0}, {"s": 36.5, "e": 37.82, "t": "sorun bir canın var.", "p": 0}, {"s": 38.14, "e": 39.22, "t": "Kaçtım.", "p": 0}, {"s": 39.48, "e": 40.26, "t": "Kaçtım.", "p": 0}, {"s": 40.26, "e": 41.78, "t": "Koş koş koş.", "p": 0}, {"s": 43.48, "e": 44.58, "t": "Klip al.", "p": 0}]}