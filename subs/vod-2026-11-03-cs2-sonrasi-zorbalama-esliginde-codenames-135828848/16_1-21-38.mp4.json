{"speakers": 1, "cues": [{"s": 3.98, "e": 5.12, "t": "Allah.", "p": 0}, {"s": 5.12, "e": 6.32, "t": "Valla ben.", "p": 0}, {"s": 6.32, "e": 8.34, "t": "5, 4, 3, 2,", "p": 0}, {"s": 8.34, "e": 9.3, "t": "çabuk.", "p": 0}, {"s": 9.3, "e": 10.04, "t": "Bitti.", "p": 0}, {"s": 10.04, "e": 11.14, "t": "Çabuk mu?", "p": 0}, {"s": 11.56, "e": 12.56, "t": "Kesim.", "p": 0}, {"s": 12.56, "e": 14.28, "t": "İnşallah tahmin ettiğime", "p": 0}, {"s": 14.28, "e": 15.54, "t": "gitmezsin.", "p": 0}, {"s": 15.78, "e": 17.6, "t": "Dedin ve gittin abi.", "p": 0}, {"s": 19.88, "e": 22.74, "t": "Kare kesim, makas.", "p": 0}, {"s": 22.74, "e": 24.46, "t": "Gölge keser, gölge", "p": 0}, {"s": 24.46, "e": 25.88, "t": "kesilir dedim.", "p": 0}, {"s": 25.88, "e": 27.0, "t": "Daha iyiye nasıl", "p": 0}, {"s": 27.0, "e": 27.96, "t": "gidecektin bilmiyorum", "p": 0}, {"s": 27.96, "e": 28.52, "t": "ama.", "p": 0}, {"s": 28.52, "e": 30.48, "t": "yani Allah aşkına şu", "p": 0}, {"s": 30.48, "e": 31.14, "t": "dört kelimeye", "p": 0}, {"s": 31.14, "e": 32.4, "t": "bakıp dört kelimeyi tek", "p": 0}, {"s": 32.4, "e": 32.62, "t": "bir", "p": 0}, {"s": 32.62, "e": 34.1, "t": "kelimede bana birleştirir", "p": 0}, {"s": 34.1, "e": 34.5, "t": "misin?", "p": 0}, {"s": 34.5, "e": 34.92, "t": "Makas,", "p": 0}, {"s": 34.92, "e": 36.42, "t": "gölge, dahi, kare.", "p": 0}, {"s": 36.58, "e": 38.24, "t": "Yani kesin demez birbiri.", "p": 0}, {"s": 38.24, "e": 38.96, "t": "Birleştiriyorum.", "p": 0}, {"s": 38.96, "e": 40.1, "t": "Hazır mısın?", "p": 0}, {"s": 40.1, "e": 41.14, "t": "Hazırım.", "p": 0}, {"s": 41.14, "e": 42.2, "t": "Hacivat.", "p": 0}, {"s": 43.54, "e": 45.1, "t": "Makas, o stadyum", "p": 0}, {"s": 45.1, "e": 47.06, "t": "işaretlerdi ki o zaman.", "p": 0}, {"s": 48.27, "e": 49.87, "t": "Hacivat 'la stadyumun ne", "p": 0}, {"s": 49.87, "e": 51.13, "t": "alakası var?", "p": 0}, {"s": 52.8, "e": 54.94, "t": "Faysal işaretlerdi.", "p": 0}, {"s": 55.78, "e": 57.84, "t": "Gösteri yaparlardı.", "p": 0}, {"s": 57.84, "e": 59.06, "t": "Stadyumda gösteri", "p": 0}, {"s": 59.06, "e": 59.16, "t": "yapabilirdi.", "p": 0}, {"s": 59.16, "e": 59.62, "t": "Hacivat yazarak gölgeyi", "p": 0}, {"s": 59.62, "e": 60.52, "t": "ve kareyi kesin", "p": 0}, {"s": 60.52, "e": 61.68, "t": "bildirirdi.", "p": 0}, {"s": 62.06, "e": 64.54, "t": "Kareyi anlar mıydı?", "p": 0}, {"s": 65.78, "e": 67.22, "t": "Dahinata anlayacak.", "p": 0}, {"s": 67.22, "e": 68.28, "t": "Ne oldu?", "p": 0}, {"s": 68.28, "e": 69.52, "t": "Bak şimdi,", "p": 0}, {"s": 69.52, "e": 70.4, "t": "Karajon salak olan", "p": 0}, {"s": 70.4, "e": 72.04, "t": "karakter tamam mı?", "p": 0}, {"s": 72.1, "e": 73.52, "t": "Neden Hacı Yvat 'ı", "p": 0}, {"s": 73.52, "e": 74.94, "t": "yazmış diye düşünüyorum.", "p": 0}, {"s": 74.94, "e": 75.98, "t": "Zeki 'yi oradan...", "p": 0}]}