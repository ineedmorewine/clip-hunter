{"speakers": 1, "cues": [{"s": 0.0, "e": 1.54, "t": "Lan yapı...", "p": 0}, {"s": 1.89, "e": 3.48, "t": "Yapı ne duvar mı?", "p": 0}, {"s": 3.94, "e": 6.3, "t": "Lan temel varsa duvarda", "p": 0}, {"s": 6.3, "e": 6.9, "t": "orada temel...", "p": 0}, {"s": 6.9, "e": 8.34, "t": "Duvar olsa başka bir", "p": 0}, {"s": 8.34, "e": 9.56, "t": "şey yazarım ya.", "p": 0}, {"s": 9.56, "e": 11.26, "t": "Ya duvar taşıyayım oğlum.", "p": 0}, {"s": 11.26, "e": 12.42, "t": "Yardımcı olmuyon", "p": 0}, {"s": 12.42, "e": 13.48, "t": "gerçekten yardımcı.", "p": 0}, {"s": 13.48, "e": 14.76, "t": "Bu arada Musay kusura", "p": 0}, {"s": 14.76, "e": 15.58, "t": "bakma.", "p": 0}, {"s": 15.58, "e": 17.12, "t": "Adam haklı var.", "p": 0}, {"s": 17.18, "e": 19.18, "t": "Adam harbi haklı lan.", "p": 0}, {"s": 21.78, "e": 23.74, "t": "Belli bak temel piramit", "p": 0}, {"s": 23.74, "e": 25.3, "t": "bundan uzak dur Buse.", "p": 0}, {"s": 25.3, "e": 27.18, "t": "Stadyumdan uzak dur.", "p": 0}, {"s": 27.66, "e": 29.32, "t": "Bende bu duvarda baysalak", "p": 0}, {"s": 29.32, "e": 30.3, "t": "kelimelerini söylemiş", "p": 0}, {"s": 30.3, "e": 31.16, "t": "bulundum.", "p": 0}, {"s": 31.76, "e": 32.96, "t": "Sandalyeden uzak dur bir", "p": 0}, {"s": 32.96, "e": 33.16, "t": "de.", "p": 0}, {"s": 33.16, "e": 34.16, "t": "Sandalyede bir yapıdır", "p": 0}, {"s": 34.16, "e": 35.24, "t": "Faysal.", "p": 0}, {"s": 35.82, "e": 37.66, "t": "Bilmem bilir misin?", "p": 0}, {"s": 37.66, "e": 39.38, "t": "Bunu yazsam...", "p": 0}]}