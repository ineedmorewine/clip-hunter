{"speakers": 2, "cues": [{"s": 0.0, "e": 1.8, "t": "Faysal böyle bir biraz", "p": 0}, {"s": 1.8, "e": 2.9, "t": "sinirlendin gibi geldim", "p": 0}, {"s": 2.9, "e": 3.7, "t": "ha.", "p": 0}, {"s": 4.28, "e": 6.02, "t": "Diyom ya gerildi hızlı", "p": 0}, {"s": 6.02, "e": 7.52, "t": "konuşmaya başladı.", "p": 0}, {"s": 7.52, "e": 8.7, "t": "O değil o değil", "p": 0}, {"s": 8.7, "e": 10.44, "t": "ya öldürdüm ya.", "p": 0}, {"s": 10.84, "e": 12.04, "t": "Hoppala kafanı sıktım", "p": 0}, {"s": 12.04, "e": 12.92, "t": "Maksim.", "p": 0}, {"s": 13.34, "e": 14.44, "t": "Ama sık o zaman", "p": 0}, {"s": 14.44, "e": 15.56, "t": "seni öldüreceğim.", "p": 0}, {"s": 15.62, "e": 17.14, "t": "Öne doğru yapıştın çok", "p": 0}, {"s": 17.14, "e": 18.52, "t": "güzeldi Faysal.", "p": 0}, {"s": 21.15, "e": 22.85, "t": "Bir de böyle maç", "p": 0}, {"s": 22.85, "e": 24.21, "t": "şey el başında böyle", "p": 0}, {"s": 24.21, "e": 25.21, "t": "beni izliyor.", "p": 0}, {"s": 25.21, "e": 26.17, "t": "Niye anlamadım acaba", "p": 0}, {"s": 26.17, "e": 27.83, "t": "sezdi mi vuracağım ama.", "p": 0}, {"s": 27.83, "e": 29.11, "t": "Sezdi mi Faysal doğru", "p": 0}, {"s": 29.11, "e": 30.01, "t": "söyle içine doğdun mu", "p": 0}, {"s": 30.01, "e": 30.91, "t": "vuracağım.", "p": 0}, {"s": 31.77, "e": 32.59, "t": "Kaybettik ya", "p": 0}, {"s": 32.59, "e": 34.19, "t": "Benim kesin buradayım da", "p": 0}]}