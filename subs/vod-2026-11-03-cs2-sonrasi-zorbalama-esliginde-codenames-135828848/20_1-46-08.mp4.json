{"speakers": 1, "cues": [{"s": 2.35, "e": 4.07, "t": "Özür dilerim.", "p": 0}, {"s": 5.68, "e": 7.3, "t": "Hayvan dedi, ben Faysal", "p": 0}, {"s": 7.3, "e": 8.52, "t": "'ı işaretleyemeydim.", "p": 0}, {"s": 8.52, "e": 10.16, "t": "Bir dek işaretledim.", "p": 0}, {"s": 10.4, "e": 12.28, "t": "Bu kart değilmiş.", "p": 0}, {"s": 18.23, "e": 19.19, "t": "Bursa Hanım.", "p": 0}, {"s": 20.31, "e": 21.37, "t": "Hayvan.", "p": 0}, {"s": 22.53, "e": 23.45, "t": "Bursa Hanım öyle bir", "p": 0}, {"s": 23.45, "e": 23.81, "t": "şey yok.", "p": 0}, {"s": 23.81, "e": 24.67, "t": "Bursa Hanım gibi o.", "p": 0}, {"s": 24.67, "e": 25.63, "t": "Pisa Hanım gibi.", "p": 0}, {"s": 25.63, "e": 26.67, "t": "Kedi.", "p": 0}, {"s": 27.79, "e": 28.85, "t": "Hayvan.", "p": 0}, {"s": 28.97, "e": 30.03, "t": "Haypare.", "p": 0}, {"s": 30.39, "e": 31.23, "t": "Hayvan balası.", "p": 0}, {"s": 31.23, "e": 32.39, "t": "Pisa Hanım gibi anladım", "p": 0}, {"s": 32.39, "e": 32.77, "t": "ya.", "p": 0}, {"s": 32.77, "e": 34.01, "t": "Ne diyor bu diyorum.", "p": 0}, {"s": 35.09, "e": 36.23, "t": "Sen ne dersin be", "p": 0}, {"s": 36.23, "e": 37.21, "t": "Pisa Hanım?", "p": 0}, {"s": 41.69, "e": 43.35, "t": "Kontak anahtarı çevirince", "p": 0}, {"s": 43.35, "e": 45.45, "t": "motor çalışır, motor ya.", "p": 0}, {"s": 46.01, "e": 47.89, "t": "Sallayayım mı bir de?", "p": 0}, {"s": 48.55, "e": 50.79, "t": "Yani siyahı bulmasın.", "p": 0}, {"s": 55.82, "e": 57.16, "t": "Olsun.", "p": 0}, {"s": 57.16, "e": 58.32, "t": "Nötr buldum.", "p": 0}]}