{"speakers": 2, "cues": [{"s": 0.0, "e": 1.3, "t": "Ben de anlatamadım.", "p": 0}, {"s": 1.72, "e": 4.88, "t": "Oğlum pokerle damat nasıl", "p": 0}, {"s": 4.88, "e": 5.56, "t": "birleştiriciğim oğlum", "p": 0}, {"s": 5.56, "e": 6.84, "t": "sorsanem de.", "p": 0}, {"s": 6.84, "e": 7.84, "t": "Söylesene bana.", "p": 0}, {"s": 7.84, "e": 9.52, "t": "Oğlum pokerle damat takım", "p": 0}, {"s": 9.52, "e": 10.98, "t": "elbiseden birleşir.", "p": 0}, {"s": 10.98, "e": 13.24, "t": "Monaco'dan birleşir.", "p": 0}, {"s": 14.41, "e": 16.19, "t": "Las Vegas'dan birleşir", "p": 0}, {"s": 16.19, "e": 17.19, "t": "amınak.", "p": 0}, {"s": 20.35, "e": 22.27, "t": "Atalım mı son?", "p": 0}, {"s": 23.64, "e": 25.4, "t": "Son beyli atalım mı?", "p": 0}, {"s": 25.4, "e": 26.9, "t": "Ben atarım.", "p": 0}, {"s": 27.24, "e": 28.66, "t": "Buyurun.", "p": 0}, {"s": 28.66, "e": 30.1, "t": "Ben eğleniyorum oğlumlar", "p": 0}, {"s": 30.1, "e": 31.42, "t": "beyler.", "p": 0}, {"s": 38.25, "e": 39.73, "t": "Haydi oğlum ne olur", "p": 0}]}