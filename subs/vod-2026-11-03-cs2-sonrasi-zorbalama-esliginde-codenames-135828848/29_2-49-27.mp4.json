{"speakers": 1, "cues": [{"s": 0.0, "e": 0.7, "t": "Vuh!", "p": 0}, {"s": 0.7, "e": 1.94, "t": "Hayalet!", "p": 0}, {"s": 2.3, "e": 5.14, "t": "Adadan iki ada var.", "p": 0}, {"s": 5.44, "e": 6.68, "t": "Bulursun.", "p": 0}, {"s": 6.68, "e": 7.64, "t": "Dalina!", "p": 0}, {"s": 7.9, "e": 9.78, "t": "Dalina diyorum ya!", "p": 0}, {"s": 11.69, "e": 13.09, "t": "Ada!", "p": 0}, {"s": 13.83, "e": 15.55, "t": "Adada dans edersin falan", "p": 0}, {"s": 15.55, "e": 16.23, "t": "geliyor.", "p": 0}, {"s": 16.23, "e": 16.25, "t": "Kı kı kı kı", "p": 0}, {"s": 16.25, "e": 17.41, "t": "Kıbrıs gibi.", "p": 0}, {"s": 19.02, "e": 20.24, "t": "Kıbrıs gibi.", "p": 0}, {"s": 20.24, "e": 21.6, "t": "Yuv artık.", "p": 0}, {"s": 22.5, "e": 24.16, "t": "Coğrafi bilgi vermek", "p": 0}, {"s": 24.16, "e": 25.62, "t": "zorundaydım.", "p": 0}, {"s": 26.1, "e": 27.06, "t": "Everest mi?", "p": 0}, {"s": 27.06, "e": 28.46, "t": "Allah kahretsin.", "p": 0}, {"s": 29.62, "e": 31.18, "t": "Oğlum lan, oğlum", "p": 0}, {"s": 31.18, "e": 34.98, "t": "İngiltere bir ada ülkesi,", "p": 0}, {"s": 34.98, "e": 37.14, "t": "İngiltere bir ada ülkesi,", "p": 0}, {"s": 37.14, "e": 39.24, "t": "ona rağmen ama orada", "p": 0}, {"s": 39.24, "e": 40.98, "t": "Everest, Everest bir dağ", "p": 0}, {"s": 40.98, "e": 42.02, "t": "değil mi?", "p": 0}]}