{"speakers": 2, "cues": [{"s": 0.43, "e": 2.21, "t": "Ben düşersin.", "p": 0}, {"s": 2.35, "e": 3.65, "t": "Hadi be.", "p": 0}, {"s": 4.89, "e": 6.93, "t": "Nasıl mentalitin?", "p": 0}, {"s": 7.27, "e": 8.59, "t": "Zekam.", "p": 0}, {"s": 8.85, "e": 10.37, "t": "Köprüden düşersin.", "p": 0}, {"s": 10.37, "e": 11.65, "t": "Köprüden düşülmez.", "p": 0}, {"s": 11.65, "e": 13.27, "t": "Köprüden atlanır.", "p": 0}, {"s": 14.05, "e": 15.63, "t": "Aleykaya düşersin.", "p": 0}, {"s": 15.73, "e": 17.09, "t": "Yani düşenebilirsin", "p": 0}, {"s": 17.09, "e": 17.95, "t": "burada.", "p": 0}, {"s": 21.49, "e": 22.39, "t": "Ama işte o zaman", "p": 1}, {"s": 22.39, "e": 23.39, "t": "atlanır.", "p": 0}, {"s": 23.39, "e": 23.85, "t": "Edeyim mi?", "p": 0}, {"s": 23.85, "e": 25.13, "t": "Başımıza taş yağacak.", "p": 0}, {"s": 25.13, "e": 26.41, "t": "Ben faysalı arkalıyorum", "p": 0}, {"s": 26.41, "e": 27.19, "t": "lan.", "p": 0}, {"s": 27.25, "e": 28.37, "t": "Harbide ben.", "p": 0}]}