{"speakers": 2, "cues": [{"s": 0.0, "e": 2.02, "t": "Of çok vurdu ya.", "p": 0}, {"s": 2.02, "e": 3.64, "t": "Şort hvp var.", "p": 1}, {"s": 3.64, "e": 5.5, "t": "Haysan napıyosun ya?", "p": 0}, {"s": 5.5, "e": 7.64, "t": "Biz karbon mu yedik?", "p": 0}, {"s": 12.02, "e": 14.16, "t": "Karda biri var Haysan.", "p": 0}, {"s": 14.16, "e": 15.62, "t": "Ya siktir git görüyor", "p": 1}, {"s": 15.62, "e": 17.24, "t": "musun o rospu çocuğu?", "p": 1}, {"s": 17.24, "e": 19.04, "t": "Lan lan şanslısın lan.", "p": 0}, {"s": 24.74, "e": 25.82, "t": "İndirecektim ben adamı", "p": 0}, {"s": 25.82, "e": 26.54, "t": "ya.", "p": 0}, {"s": 27.6, "e": 28.72, "t": "Hala indireceksin diyor", "p": 0}, {"s": 28.72, "e": 30.56, "t": "ya ben anlamıyorum ya.", "p": 0}, {"s": 34.32, "e": 34.88, "t": "Altyazı M .K.", "p": 0}]}