{"speakers": 2, "cues": [{"s": 0.0, "e": 1.68, "t": "Gelin geri gidelim ya", "p": 0}, {"s": 2.42, "e": 3.74, "t": "Kaçı ver orada", "p": 0}, {"s": 3.74, "e": 6.62, "t": "Bikşi bikşi bikşi", "p": 0}, {"s": 6.62, "e": 7.86, "t": "Bikşi", "p": 0}, {"s": 8.0, "e": 9.66, "t": "Bikşi solda", "p": 0}, {"s": 11.98, "e": 13.8, "t": "Vuramadım İbneyi ya", "p": 0}, {"s": 14.08, "e": 15.7, "t": "İbneyi uyu", "p": 0}, {"s": 16.3, "e": 18.02, "t": "Vurun lan İbneyi", "p": 0}, {"s": 18.02, "e": 19.74, "t": "Bikşi mi", "p": 1}, {"s": 19.74, "e": 22.4, "t": "Bikşi hepimizi öldürdü", "p": 0}, {"s": 22.4, "e": 23.8, "t": "Oğlum iki çıktı lan", "p": 1}, {"s": 23.8, "e": 24.34, "t": "oradan", "p": 1}, {"s": 24.34, "e": 27.08, "t": "Sonradan geldi", "p": 0}, {"s": 27.74, "e": 29.44, "t": "Biraz Faysal 'ın", "p": 0}, {"s": 29.44, "e": 30.26, "t": "dangalaklığına", "p": 0}, {"s": 30.26, "e": 31.44, "t": "Öldük gibi geldi.", "p": 0}, {"s": 31.44, "e": 32.16, "t": "Aysal bir konuşsana", "p": 0}, {"s": 32.16, "e": 33.2, "t": "Faysal.", "p": 0}, {"s": 33.86, "e": 34.74, "t": "Ayrım yoksa orada bir", "p": 0}, {"s": 34.74, "e": 35.2, "t": "kişi vardı.", "p": 0}, {"s": 35.2, "e": 36.6, "t": "Bir kişi öldü sanırım.", "p": 0}, {"s": 36.74, "e": 37.96, "t": "Yenekten iki kişi öldü.", "p": 0}, {"s": 37.96, "e": 38.34, "t": "Hayır.", "p": 0}, {"s": 38.34, "e": 40.0, "t": "Sen ölmesen geri çekilsen", "p": 0}, {"s": 40.0, "e": 41.26, "t": "A 'ya gitmiştik şu", "p": 0}, {"s": 41.26, "e": 41.66, "t": "an.", "p": 0}, {"s": 41.66, "e": 42.32, "t": "Şu an daha O", "p": 0}, {"s": 42.32, "e": 43.86, "t": "'ya gitmemişti yani.", "p": 0}, {"s": 43.86, "e": 44.94, "t": "Bomba alıp kaçerleriz.", "p": 0}, {"s": 44.94, "e": 45.8, "t": "Ben bilirim de kaçma", "p": 0}, {"s": 45.8, "e": 46.52, "t": "gelin diye.", "p": 0}]}