{"speakers": 1, "cues": [{"s": 0.0, "e": 1.32, "t": "Ya bunu da yanlış", "p": 0}, {"s": 1.32, "e": 2.74, "t": "bildi ki.", "p": 0}, {"s": 4.2, "e": 5.26, "t": "Keso kolonu değil mi", "p": 0}, {"s": 5.26, "e": 6.0, "t": "oğlum?", "p": 0}, {"s": 8.48, "e": 9.32, "t": "Oğlum Keso 'nun ne", "p": 0}, {"s": 9.32, "e": 9.92, "t": "olduğunu şu an", "p": 0}, {"s": 9.92, "e": 12.02, "t": "açıklayamazsan seni 7", "p": 0}, {"s": 12.02, "e": 13.26, "t": "milyarın, 8 milyar", "p": 0}, {"s": 13.26, "e": 14.2, "t": "insanın önünde rezil", "p": 0}, {"s": 14.2, "e": 15.06, "t": "ederim.", "p": 0}, {"s": 15.46, "e": 16.9, "t": "Sakın arkaya gidip Keso", "p": 0}, {"s": 16.9, "e": 18.18, "t": "'nun nedir yazma.", "p": 0}, {"s": 20.37, "e": 21.27, "t": "Valla.", "p": 0}, {"s": 25.48, "e": 26.12, "t": "Ölüm, ölüm.", "p": 0}, {"s": 26.12, "e": 27.08, "t": "Ajanla örümceği", "p": 0}, {"s": 27.08, "e": 28.44, "t": "anlatabilirim.", "p": 0}, {"s": 28.44, "e": 29.62, "t": "İngilizce klavye olduğu", "p": 0}, {"s": 29.62, "e": 30.0, "t": "için.", "p": 0}, {"s": 30.0, "e": 31.36, "t": "Ajanla örümcek anlat.", "p": 0}, {"s": 31.36, "e": 32.5, "t": "Miles yazsaydın ben", "p": 0}, {"s": 32.5, "e": 33.72, "t": "bilirdim mesela.", "p": 0}, {"s": 34.3, "e": 36.7, "t": "Ya kamptan işte kamptan", "p": 0}, {"s": 36.7, "e": 38.58, "t": "ateşle örümceği falan", "p": 0}, {"s": 38.58, "e": 39.48, "t": "bildirecekti.", "p": 0}, {"s": 39.48, "e": 41.12, "t": "Ölüm, ölüm diyorum.", "p": 0}, {"s": 41.12, "e": 43.46, "t": "Benim klavye İngilizce", "p": 0}, {"s": 43.46, "e": 44.74, "t": "klavye ya.", "p": 0}, {"s": 45.02, "e": 45.8, "t": "Ö, ö ve ö.", "p": 0}, {"s": 45.8, "e": 46.8, "t": "Bir dakika bir şey", "p": 0}, {"s": 46.8, "e": 47.24, "t": "diyeceğim.", "p": 0}, {"s": 47.24, "e": 48.1, "t": "Benim 30 saniyem daha", "p": 0}, {"s": 48.1, "e": 48.36, "t": "var.", "p": 0}, {"s": 48.36, "e": 49.36, "t": "Faysal kes onun ne", "p": 0}, {"s": 49.36, "e": 50.2, "t": "olduğunu çabuk söyle.", "p": 0}, {"s": 50.2, "e": 