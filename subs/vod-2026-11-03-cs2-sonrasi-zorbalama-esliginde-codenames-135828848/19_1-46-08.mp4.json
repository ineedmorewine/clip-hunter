{"speakers": 2, "cues": [{"s": 2.35, "e": 4.07, "t": "Özür dilerim.", "p": 0}, {"s": 5.7, "e": 6.62, "t": "Hayvan dedi.", "p": 0}, {"s": 6.62, "e": 7.38, "t": "Ben Faysal 'ı", "p": 0}, {"s": 7.38, "e": 8.52, "t": "işaretleyemeydim.", "p": 0}, {"s": 8.52, "e": 10.16, "t": "Bir dek işaretledim.", "p": 0}, {"s": 10.42, "e": 12.28, "t": "Bu kart değilmiş.", "p": 0}, {"s": 18.23, "e": 19.17, "t": "Bursa Hanım.", "p": 0}, {"s": 20.33, "e": 21.37, "t": "Hayvan.", "p": 1}, {"s": 22.55, "e": 23.45, "t": "Bursa Hanım öyle bir", "p": 0}, {"s": 23.45, "e": 23.81, "t": "şey yok.", "p": 0}, {"s": 23.81, "e": 24.67, "t": "Bursa Hanım gibi o.", "p": 0}, {"s": 24.67, "e": 25.63, "t": "Pisa Hanım gibi.", "p": 0}, {"s": 25.63, "e": 26.67, "t": "Kedi.", "p": 1}, {"s": 27.81, "e": 28.85, "t": "Hayvan.", "p": 1}, {"s": 28.99, "e": 30.03, "t": "Haypare.", "p": 1}, {"s": 30.41, "e": 31.23, "t": "Hayvan balası.", "p": 1}, {"s": 31.23, "e": 32.39, "t": "Pisa Hanım gibi anladım", "p": 0}, {"s": 32.39, "e": 32.77, "t": "ya.", "p": 0}, {"s": 32.77, "e": 34.03, "t": "Ne diyor bu diyorum.", "p": 0}, {"s": 35.11, "e": 36.21, "t": "Sen ne dersin be", "p": 0}, {"s": 36.21, "e": 37.21, "t": "Pisa Hanım?", "p": 0}, {"s": 41.41, "e": 43.37, "t": "Kontak anahtarı çevirince", "p": 0}, {"s": 43.37, "e": 44.31, "t": "motor çalışır.", "p": 0}, {"s": 44.31, "e": 45.43, "t": "Motor ya.", "p": 0}, {"s": 46.13, "e": 47.89, "t": "Sallayayım mı bir de?", "p": 1}, {"s": 48.63, "e": 50.79, "t": "Yani siyahı bulmasın.", "p": 0}, {"s": 56.02, "e": 57.16, "t": "Olsun.", "p": 1}, {"s": 57.18, "e": 58.32, "t": "Ne tür buldum?", "p": 1}]}