{"speakers": 2, "cues": [{"s": 0.11, "e": 2.27, "t": "Evet, seçiyorum.", "p": 1}, {"s": 7.8, "e": 9.94, "t": "Ay aslında dört de", "p": 1}, {"s": 9.94, "e": 10.98, "t": "seçebilirim şimdi de", "p": 1}, {"s": 10.98, "e": 11.38, "t": "gitti.", "p": 1}, {"s": 11.38, "e": 12.64, "t": "Dört düşün sen onu,", "p": 1}, {"s": 12.64, "e": 14.3, "t": "bonusunu da ona harca.", "p": 1}, {"s": 15.5, "e": 16.74, "t": "Bak Musay, vuru", "p": 0}, {"s": 16.74, "e": 17.78, "t": "batıyorum.", "p": 0}, {"s": 26.21, "e": 27.91, "t": "Ay sen fotoğraf mı", "p": 0}, {"s": 27.91, "e": 28.81, "t": "yapacaksın?", "p": 0}, {"s": 37.1, "e": 38.82, "t": "Markette reklam...", "p": 0}, {"s": 39.48, "e": 40.96, "t": "Şok var zaten onu", "p": 0}, {"s": 40.96, "e": 41.92, "t": "anladım.", "p": 0}, {"s": 42.42, "e": 44.26, "t": "Market sırası da olur.", "p": 0}, {"s": 47.29, "e": 48.41, "t": "Kupon da olur o", "p": 0}, {"s": 48.41, "e": 49.33, "t": "reklamlarda.", "p": 0}, {"s": 49.33, "e": 50.87, "t": "Bir sırayı deneyeceğim.", "p": 0}, {"s": 51.23, "e": 53.55, "t": "Haydi Musay.", "p": 0}, {"s": 53.55, "e": 54.63, "t": "Haydi Musa.", "p": 0}, {"s": 54.63, "e": 56.11, "t": "Musa koyuyoruz.", "p": 0}, {"s": 56.11, "e": 57.35, "t": "İkisi de bize mi?", "p": 0}, {"s": 57.35, "e": 58.03, "t": "Tamam.", "p": 1}, {"s": 58.03, "e": 59.77, "t": "Marketten 3 kaldı.", "p": 1}, {"s": 59.77, "e": 61.03, "t": "Hatırlarsın.", "p": 0}, {"s": 69.23, "e": 70.63, "t": "Biz kalmıyorum.", "p": 0}, {"s": 71.89, "e": 73.67, "t": "Ben bir tane daha", "p": 0}, {"s": 73.67, "e": 75.13, "t": "bunu yapacağım o ikisinin", "p": 0}, {"s": 75.13, "e": 75.87, "t": "üzerine.", "p": 0}, {"s": 75.87, "e": 76.59, "t": "Bakalım.", "p": 0}]}