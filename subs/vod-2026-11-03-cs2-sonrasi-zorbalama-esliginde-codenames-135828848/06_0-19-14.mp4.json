{"speakers": 1, "cues": [{"s": 1.14, "e": 3.06, "t": "Sağ tıkla neyi açmadım?", "p": 0}, {"s": 3.06, "e": 5.14, "t": "Ya bana iskeleyi yak", "p": 0}, {"s": 5.14, "e": 6.72, "t": "dedi ya Musa.", "p": 0}, {"s": 6.74, "e": 8.92, "t": "Ben elime zaten molotofu", "p": 0}, {"s": 8.92, "e": 9.98, "t": "aldım.", "p": 0}, {"s": 9.98, "e": 11.84, "t": "Adamı görür gibi oldum.", "p": 0}, {"s": 11.84, "e": 13.64, "t": "Korktum geri gittim.", "p": 0}, {"s": 14.1, "e": 15.5, "t": "Onlar üstüne bir şey", "p": 0}, {"s": 15.5, "e": 16.14, "t": "alıyor.", "p": 0}, {"s": 16.14, "e": 17.42, "t": "Almıyorum elime.", "p": 0}, {"s": 17.52, "e": 19.34, "t": "Donk, donk.", "p": 0}, {"s": 19.34, "e": 20.46, "t": "Onu da pek görmeden", "p": 0}, {"s": 20.46, "e": 20.88, "t": "buluyor.", "p": 0}, {"s": 20.88, "e": 22.1, "t": "2 aferin bitme.", "p": 0}, {"s": 23.88, "e": 25.58, "t": "Onu aferin bitme.", "p": 0}, {"s": 25.76, "e": 27.5, "t": "Donk, 2 falan.", "p": 0}, {"s": 29.04, "e": 29.76, "t": "Aaaa...", "p": 0}, {"s": 29.76, "e": 34.0, "t": "Bomba düştü", "p": 0}, {"s": 34.0, "e": 36.46, "t": "Tamam bir yeri de", "p": 0}, {"s": 36.46, "e": 36.74, "t": "gelin", "p": 0}, {"s": 36.74, "e": 37.82, "t": "Gelin", "p": 0}, {"s": 37.82, "e": 38.84, "t": "Help", "p": 0}, {"s": 38.84, "e": 40.68, "t": "Bomba burda", "p": 0}, {"s": 40.76, "e": 43.2, "t": "Klip", "p": 0}]}