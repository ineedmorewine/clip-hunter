{"speakers": 2, "cues": [{"s": 0.62, "e": 2.38, "t": "Ben de değiştirdim.", "p": 0}, {"s": 2.38, "e": 3.62, "t": "Lan, oğlum beni niye", "p": 0}, {"s": 3.62, "e": 4.3, "t": "vuruyorsun?", "p": 0}, {"s": 4.3, "e": 6.02, "t": "Orası mı çocuğu?", "p": 0}, {"s": 8.96, "e": 10.86, "t": "At ya şuna.", "p": 0}, {"s": 11.0, "e": 12.66, "t": "Rik bizi vuruyor, Faysal", "p": 0}, {"s": 12.66, "e": 14.18, "t": "da arada bizi vuruyor.", "p": 0}, {"s": 21.2, "e": 22.66, "t": "Faysal yine atılsın", "p": 0}, {"s": 22.66, "e": 23.2, "t": "oyundan.", "p": 0}, {"s": 23.2, "e": 24.8, "t": "Yapma ne olur Faysal", "p": 0}, {"s": 24.8, "e": 25.74, "t": "vallahi.", "p": 1}, {"s": 29.84, "e": 31.3, "t": "Atılsın ya Faysal'sız", "p": 0}, {"s": 31.3, "e": 32.14, "t": "rush atarız.", "p": 0}, {"s": 32.14, "e": 33.22, "t": "Bir şey olmaz.", "p": 0}, {"s": 33.86, "e": 35.18, "t": "Atılsın ya.", "p": 0}]}