{"speakers": 2, "cues": [{"s": 1.78, "e": 3.12, "t": "Niye Musa bir şey", "p": 0}, {"s": 3.12, "e": 4.8, "t": "Hemen peynir deyince bile", "p": 0}, {"s": 4.8, "e": 5.92, "t": "niye komik söylüyorsun", "p": 0}, {"s": 5.92, "e": 6.88, "t": "abi sende bir büyü", "p": 1}, {"s": 6.88, "e": 7.18, "t": "var ya", "p": 1}, {"s": 7.18, "e": 7.84, "t": "Ama sesim eğer olur", "p": 1}, {"s": 7.84, "e": 8.94, "t": "da azalırsa yani", "p": 1}, {"s": 8.94, "e": 10.44, "t": "Söyle bana da ayy", "p": 1}, {"s": 10.44, "e": 11.2, "t": "ben bok gibi bir", "p": 1}, {"s": 11.2, "e": 12.78, "t": "yerden girdim ama", "p": 1}, {"s": 13.92, "e": 15.64, "t": "Girdim boş gibi", "p": 1}, {"s": 15.64, "e": 17.08, "t": "Bak smoke atmadın ya", "p": 0}, {"s": 17.08, "e": 18.62, "t": "ne kadar rahat girdin", "p": 0}, {"s": 18.62, "e": 19.9, "t": "Yok bir şey adam", "p": 1}, {"s": 19.9, "e": 20.8, "t": "olmadığı için rahat", "p": 1}, {"s": 20.8, "e": 21.6, "t": "girdik Musa", "p": 1}, {"s": 21.6, "e": 22.9, "t": "Smoke ile hiçbir alakası", "p": 1}, {"s": 22.9, "e": 23.7, "t": "yok", "p": 1}, {"s": 24.8, "e": 25.58, "t": "Götümü de bir kontrol", "p": 1}, {"s": 25.58, "e": 26.18, "t": "edelim", "p": 0}, {"s": 28.94, "e": 30.22, "t": "Oynamayız biz orada erkek", "p": 0}, {"s": 30.22, "e": 31.74, "t": "adam otu oynamaz", "p": 0}, {"s": 31.78, "e": 33.76, "t": "Eee bomba yok.", "p": 1}]}