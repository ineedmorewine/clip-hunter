{"speakers": 3, "cues": [{"s": 1.78, "e": 3.74, "t": "Niye Musa bir şey?", "p": 0}, {"s": 3.74, "e": 5.04, "t": "Peynir deyince bile niye", "p": 0}, {"s": 5.04, "e": 6.2, "t": "komik söylüyorsun abi", "p": 0}, {"s": 6.2, "e": 7.14, "t": "sende bir büyü var", "p": 1}, {"s": 7.14, "e": 7.16, "t": "ya", "p": 1}, {"s": 7.16, "e": 7.84, "t": "Ama sesim eğer olur", "p": 1}, {"s": 7.84, "e": 9.62, "t": "da azalırsa yani söyle", "p": 1}, {"s": 9.62, "e": 10.08, "t": "bana da", "p": 1}, {"s": 10.08, "e": 11.02, "t": "Ayy ben bok gibi", "p": 1}, {"s": 11.02, "e": 12.78, "t": "bir yerden girdim ama", "p": 1}, {"s": 13.92, "e": 15.68, "t": "Girdim boş gibi", "p": 1}, {"s": 15.68, "e": 17.06, "t": "Bak smoke atmadın ya", "p": 0}, {"s": 17.06, "e": 18.8, "t": "ne kadar rahat girdik", "p": 2}, {"s": 18.8, "e": 19.9, "t": "Yok bir şey adam", "p": 1}, {"s": 19.9, "e": 20.76, "t": "olmadığı için rahat", "p": 1}, {"s": 20.76, "e": 21.6, "t": "girdik Musa", "p": 1}, {"s": 21.6, "e": 22.4, "t": "Smoke ile hiç bu", "p": 1}, {"s": 22.4, "e": 23.7, "t": "alakası yok", "p": 1}, {"s": 24.84, "e": 25.58, "t": "Götümü de bir kontrol", "p": 1}, {"s": 25.58, "e": 26.18, "t": "edeyim", "p": 0}, {"s": 28.98, "e": 30.22, "t": "Oynamayız biz orada erkek", "p": 0}, {"s": 30.22, "e": 31.74, "t": "adam oto oynamaz", "p": 0}, {"s": 31.78, "e": 33.76, "t": "Ee bomba yok.", "p": 1}]}