{"speakers": 2, "cues": [{"s": 0.0, "e": 1.28, "t": "Musa soymuyor.", "p": 0}, {"s": 1.66, "e": 3.06, "t": "Lan Musa benim engelerin", "p": 0}, {"s": 3.06, "e": 3.98, "t": "lan sen.", "p": 0}, {"s": 5.56, "e": 7.24, "t": "Benim telefon numaramı", "p": 0}, {"s": 7.24, "e": 8.12, "t": "nereden edindi lan?", "p": 0}, {"s": 8.12, "e": 9.46, "t": "Musa sen verdin.", "p": 0}, {"s": 9.46, "e": 11.4, "t": "Yok valla vermedim.", "p": 0}, {"s": 14.06, "e": 15.64, "t": "Musa etabiliyorsun bunu.", "p": 0}, {"s": 16.99, "e": 18.27, "t": "Arıyor beni ses de", "p": 0}, {"s": 18.27, "e": 19.25, "t": "çıkarmıyor.", "p": 0}, {"s": 19.25, "e": 20.17, "t": "Geri arıyorum cevap", "p": 0}, {"s": 20.17, "e": 21.19, "t": "vermiyor.", "p": 0}, {"s": 22.49, "e": 23.45, "t": "Yani belli olmasın daha", "p": 0}, {"s": 23.45, "e": 24.97, "t": "aşamalı böyle.", "p": 0}, {"s": 25.55, "e": 27.05, "t": "Sen nereden bildim benim", "p": 0}, {"s": 27.05, "e": 28.05, "t": "olduğumu ile?", "p": 0}, {"s": 28.51, "e": 30.49, "t": "Oğlum ben anlarım.", "p": 0}, {"s": 31.05, "e": 32.07, "t": "Harikada ses", "p": 1}, {"s": 32.07, "e": 33.01, "t": "çıkarmıyormuşsun ama", "p": 1}, {"s": 33.01, "e": 34.27, "t": "paket açıyormuşsun.", "p": 1}, {"s": 34.27, "e": 35.71, "t": "Sen nereden anladın lan", "p": 0}, {"s": 35.71, "e": 36.55, "t": "benim oldum?", "p": 0}, {"s": 36.55, "e": 37.79, "t": "Çok basit.", "p": 0}, {"s": 37.79, "e": 38.89, "t": "Whatsapp'tan direk", "p": 0}, {"s": 38.89, "e": 39.83, "t": "ekledim ismini de", "p": 0}, {"s": 39.83, "e": 41.25, "t": "amurakodum yazdım.", "p": 0}, {"s": 41.25, "e": 41.99, "t": "Baktım harbiden", "p": 0}, {"s": 41.99, "e": 43.67, "t": "amurakodum çıktı.", "p": 0}, {"s": 47.59, "e": 48.37, "t": "Kodumun!", "p": 0}]}