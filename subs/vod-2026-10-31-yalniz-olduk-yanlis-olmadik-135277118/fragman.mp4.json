{"speakers": 2, "cues": [{"s": 0.43, "e": 2.13, "t": "Kanta doğası yapacağız.", "p": 0}, {"s": 2.13, "e": 3.21, "t": "Geçen dinleyicilerin", "p": 0}, {"s": 3.21, "e": 4.55, "t": "zirmetten sonra kazanmak", "p": 0}, {"s": 4.55, "e": 6.47, "t": "için kazanma yarantılı", "p": 1}, {"s": 6.47, "e": 7.13, "t": "Kanta doğası yapacağız.", "p": 1}, {"s": 7.13, "e": 8.41, "t": "Yemek doğası gibi ama", "p": 1}, {"s": 8.51, "e": 10.29, "t": "Sen dua okumadın,", "p": 1}, {"s": 10.57, "e": 12.73, "t": "o yüzden oldum, okumadım,", "p": 0}, {"s": 12.73, "e": 13.71, "t": "duymadım ben.", "p": 1}, {"s": 13.71, "e": 15.51, "t": "O zaman sesim gelmedi.", "p": 0}, {"s": 17.01, "e": 18.49, "t": "Tamam, benim ekranı mı", "p": 0}, {"s": 18.49, "e": 20.27, "t": "izliyordun Musa?", "p": 0}, {"s": 20.55, "e": 21.53, "t": "He?", "p": 1}, {"s": 21.53, "e": 22.41, "t": "Benim ekranı mı", "p": 1}, {"s": 22.41, "e": 24.11, "t": "izliyordun Musa?", "p": 0}, {"s": 24.29, "e": 25.53, "t": "Allah 'ın gözünü atayım.", "p": 0}, {"s": 25.53, "e": 26.33, "t": "Ya senden harbi", "p": 0}, {"s": 26.33, "e": 27.85, "t": "tiksiniyorum ya", "p": 0}, {"s": 28.07, "e": 29.57, "t": "Gerçekten senden nefret", "p": 0}, {"s": 29.57, "e": 31.03, "t": "ediyorum Faysal ya", "p": 0}, {"s": 34.72, "e": 36.06, "t": "Efsane vurdum adamı ya", "p": 0}, {"s": 36.06, "e": 37.68, "t": "Böyle bir vuruş yok", "p": 0}, {"s": 39.54, "e": 41.54, "t": "Benim olduğum çok basit", "p": 0}, {"s": 41.54, "e": 42.48, "t": "Whatsapp'tan direkt", "p": 0}, {"s": 42.48, "e": 43.54, "t": "ekledim ismine de", "p": 0}, {"s": 43.54, "e": 44.96, "t": "Amunakodum yazdım.", "p": 0}, {"s": 44.96, "e": 45.88, "t": "Baktım harbiden de", "p": 0}, {"s": 45.88, "e": 47.2, "t": "Amunakodum çıktı.", "p": 0}, {"s": 48.64, "e": 50.08, "t": "Lan oğlum beni niye", "p": 0}, {"s": 50.08, "e": 50.72, "t": "vuruyorsun?", "p": 0}, {"s": 50.72, "e": 52.26, "t": "Orası bir çocuğu.", "p": 0}, {"s": 54.56, "e": 55.46, "t": "duydun var içimdeki sesi", "p": 1}, {"s": 55.46, "e": 56.44, "t": "duydun şu an Musa", "p": 1}, {"s": 56.44, "e": 58.94, "t": "Evet ofis oynayalım beyaz", "p": 1}, {"s": 58.94, "e": 60.52, "t": "yaka beyaz yaka olalım", "p": 1}, {"s": 60.52, "e": 61.26, "t": "bugün", "p": 1}, {"s": 63.07, "e": 64.89, "t": "Oyunun annesi varmış,", "p": 0}, {"s": 65.45, "e": 67.71, "t": "oynamayız biz otu, erkek", "p": 0}, {"s": 67.71, "e": 69.01, "t": "adam otu oynamaz.", "p": 0}, {"s": 69.59, "e": 71.33, "t": "Aysal eğer dangalak bir", "p": 0}, {"s": 71.33, "e": 72.77, "t": "dingilsen sus, hiçbir şey", "p": 0}, {"s": 72.77, "e": 73.81, "t": "söyleme.", "p": 0}, {"s": 78.08, "e": 79.96, "t": "Bizi duyuyorsan sık", "p": 0}, {"s": 79.96, "e": 80.62, "t": "Sık ver", "p": 0}, {"s": 80.62, "e": 82.12, "t": "Sık lan", "p": 0}, {"s": 82.12, "e": 83.66, "t": "Duymuyor bak", "p": 1}]}