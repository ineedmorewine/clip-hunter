{"speakers": 3, "cues": [{"s": 0.4, "e": 2.12, "t": "Kantır doğası yapacağız.", "p": 2}, {"s": 2.12, "e": 3.72, "t": "Geçen dinleyen zirmetten", "p": 2}, {"s": 3.72, "e": 4.78, "t": "sonra kazanmak için", "p": 2}, {"s": 4.78, "e": 6.94, "t": "kazanma yarantılı kantır", "p": 1}, {"s": 6.94, "e": 7.12, "t": "doğası yapacağız.", "p": 1}, {"s": 7.12, "e": 8.4, "t": "Yemek doğası gibi ama", "p": 1}, {"s": 8.5, "e": 10.6, "t": "Sen dua okumadın o", "p": 1}, {"s": 10.6, "e": 12.46, "t": "yüzden oldum okumadım", "p": 1}, {"s": 12.46, "e": 13.62, "t": "duymadım ben", "p": 1}, {"s": 13.62, "e": 15.5, "t": "O zaman sesim gelmedi", "p": 2}, {"s": 17.0, "e": 18.46, "t": "Sen benim ekranı mı", "p": 1}, {"s": 18.46, "e": 20.3, "t": "izliyordun Musa?", "p": 1}, {"s": 20.64, "e": 21.58, "t": "He?", "p": 1}, {"s": 21.58, "e": 22.4, "t": "Benim ekranı mı", "p": 1}, {"s": 22.4, "e": 24.12, "t": "izliyordun Musa?", "p": 1}, {"s": 24.38, "e": 25.51, "t": "Allah 'a gözünü atayım.", "p": 0}, {"s": 25.51, "e": 26.31, "t": "Ya sen de harbi", "p": 0}, {"s": 26.31, "e": 27.83, "t": "tiksiniyorum ya", "p": 0}, {"s": 28.03, "e": 29.53, "t": "Gerçekten senden nefret", "p": 2}, {"s": 29.53, "e": 31.01, "t": "ediyorum Faysal ya", "p": 0}, {"s": 34.66, "e": 36.04, "t": "Efsane vurdum adamı ya", "p": 0}, {"s": 36.04, "e": 37.66, "t": "Böyle bir vuruş yok", "p": 0}, {"s": 39.52, "e": 41.52, "t": "çok basit", "p": 0}, {"s": 41.52, "e": 42.6, "t": "whatsapp'tan direk", "p": 0}, {"s": 42.6, "e": 43.52, "t": "ekledim ismini de", "p": 0}, {"s": 43.52, "e": 44.9, "t": "amınakodum yazdım", "p": 0}, {"s": 44.9, "e": 45.86, "t": "baktım harbiden de", "p": 0}, {"s": 45.86, "e": 47.22, "t": "amınakodum çıktı", "p": 0}, {"s": 48.62, "e": 50.06, "t": "Lan oğlum beni niye", "p": 0}, {"s": 50.06, "e": 50.72, "t": "vuruyorsun?", "p": 0}, {"s": 50.72, "e": 52.24, "t": "Orası bir çocuğu.", "p": 0}, {"s": 54.54, "e": 55.44, "t": "duydun var içindeki sesi", "p": 1}, {"s": 55.44, "e": 56.42, "t": "duydun şu an Musa", "p":