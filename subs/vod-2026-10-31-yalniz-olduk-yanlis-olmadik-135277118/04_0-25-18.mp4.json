{"speakers": 3, "cues": [{"s": 0.62, "e": 2.24, "t": "Ben de değilim.", "p": 0}, {"s": 2.24, "e": 3.62, "t": "Lan oğlum beni niye", "p": 0}, {"s": 3.62, "e": 4.32, "t": "vuruyorsun?", "p": 0}, {"s": 4.32, "e": 6.14, "t": "Orası ne çocuğu?", "p": 0}, {"s": 8.92, "e": 10.96, "t": "At ya şuna.", "p": 0}, {"s": 10.96, "e": 12.66, "t": "Rik bizi vuruyor, Faysal", "p": 0}, {"s": 12.66, "e": 14.18, "t": "da arada bizi vuruyor.", "p": 1}, {"s": 21.11, "e": 22.69, "t": "Faysal yine atılacaksın", "p": 0}, {"s": 22.69, "e": 25.71, "t": "ona yapmak öyle.", "p": 0}, {"s": 29.8, "e": 31.3, "t": "Atılsın ya Faysal'sız", "p": 2}, {"s": 31.3, "e": 32.16, "t": "rush atarız.", "p": 2}, {"s": 32.16, "e": 33.22, "t": "Bir şey olmaz.", "p": 0}, {"s": 33.84, "e": 35.18, "t": "Atılsın ya.", "p": 0}]}