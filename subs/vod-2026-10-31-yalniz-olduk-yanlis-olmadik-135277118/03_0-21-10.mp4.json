{"speakers": 3, "cues": [{"s": 0.0, "e": 1.28, "t": "Musa soymuyor.", "p": 0}, {"s": 1.72, "e": 3.08, "t": "Lan Musa benim engelerin", "p": 0}, {"s": 3.08, "e": 4.0, "t": "lan sen.", "p": 0}, {"s": 5.86, "e": 7.24, "t": "Benim telefon numaramı", "p": 0}, {"s": 7.24, "e": 8.12, "t": "nereden edindi lan?", "p": 0}, {"s": 8.12, "e": 9.46, "t": "Musa sen verdin.", "p": 0}, {"s": 9.46, "e": 11.48, "t": "Yok valla vermedin.", "p": 0}, {"s": 13.98, "e": 15.62, "t": "Musa etabiliyorsun bunu.", "p": 0}, {"s": 16.98, "e": 18.26, "t": "Arıyor beni sesle", "p": 0}, {"s": 18.26, "e": 19.28, "t": "çıkarmıyor.", "p": 0}, {"s": 19.28, "e": 20.18, "t": "Geri arıyorum cevap", "p": 0}, {"s": 20.18, "e": 21.2, "t": "vermiyor.", "p": 0}, {"s": 22.46, "e": 23.38, "t": "Belli olmasında", "p": 0}, {"s": 23.38, "e": 24.9, "t": "aşağılmıyor.", "p": 0}, {"s": 25.76, "e": 27.08, "t": "Sen nereden bildin benim", "p": 0}, {"s": 27.08, "e": 28.04, "t": "olduğumu bile?", "p": 0}, {"s": 28.52, "e": 30.48, "t": "Oğlum ben anlarım.", "p": 0}, {"s": 30.96, "e": 32.06, "t": "Arkada ses", "p": 1}, {"s": 32.06, "e": 33.02, "t": "çıkarmıyormuşsun ama", "p": 1}, {"s": 33.02, "e": 34.16, "t": "paket açıyormuşsun.", "p": 1}, {"s": 34.16, "e": 35.72, "t": "Sen nerden anladın lan", "p": 0}, {"s": 35.72, "e": 36.56, "t": "benim anladın?", "p": 0}, {"s": 36.56, "e": 37.82, "t": "Çok basit", "p": 0}, {"s": 38.16, "e": 38.88, "t": "Whatsapp'tan direk", "p": 0}, {"s": 38.88, "e": 39.82, "t": "ekledim ismini de", "p": 0}, {"s": 39.82, "e": 41.28, "t": "Amunakodum yazdım.", "p": 0}, {"s": 41.28, "e": 42.0, "t": "Baktım harbiden", "p": 0}, {"s": 42.0, "e": 43.64, "t": "Amunakodum çıktı", "p": 0}, {"s": 46.38, "e": 47.82, "t": "Fili biliyorum ama", "p": 0}]}